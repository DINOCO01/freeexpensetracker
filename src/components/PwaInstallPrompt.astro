          class="px-4 py-1.5 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 transition-all shadow-xs hover:shadow-sm cursor-pointer inline-flex items-center gap-1.5"
