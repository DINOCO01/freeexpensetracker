          </svg>
          <span>{t.btnInstall}</span>
        </button>
      </div>
    </div>

    <!-- Instruction Fallback State (when native prompt is unavailable) -->
    <div id="pwa-desktop-fallback-state" class="hidden space-y-3">
      <div class="pr-6">
        <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] tracking-tight">
          {t.instructionsTitle}
