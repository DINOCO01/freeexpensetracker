---

<div id="pwa-install-prompt-root" class="no-print" data-locale={locale}>
  <!-- ========================================== -->
  <!-- 1. DESKTOP FLOATING CARD (sm:block, >=640px) -->
  <!-- ========================================== -->
  <div
    id="pwa-install-desktop-card"
    role="dialog"
    aria-labelledby="pwa-desktop-heading"
    aria-describedby="pwa-desktop-desc"
    class="hidden sm:hidden fixed bottom-[86px] right-6 z-50 w-full max-w-[385px] bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-emerald-500/25 dark:border-emerald-500/20 shadow-xl dark:shadow-slate-950/60 rounded-2xl p-4 transition-all duration-300 ease-out opacity-0 translate-y-3 pointer-events-none"
  >
    <!-- Close Button -->
    <button
      type="button"
      id="btn-pwa-close-desktop"
      aria-label={t.btnClose}
      class="absolute top-3.5 right-3.5 p-1 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Normal Promotion State -->
    <div id="pwa-desktop-promo-state" class="space-y-3">
      <div class="flex items-start gap-3 pr-6">
        <div class="w-11 h-11 rounded-xl p-1 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/80 dark:border-emerald-800/80 flex items-center justify-center shrink-0 shadow-2xs">
          <img
            src="/web-app-manifest-192x192.png"
            alt="FreeExpenseTracker Logo"
            class="w-8 h-8 rounded-lg object-contain"
            width="32"
            height="32"
            loading="lazy"
          />
        </div>
        <div class="space-y-0.5 min-w-0">
          <h3
            id="pwa-desktop-heading"
            class="text-sm font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] tracking-tight truncate"
          >
            {t.heading}
          </h3>
          <p
            id="pwa-desktop-desc"
            class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed"
          >
            {t.desktopDesc}
          </p>
        </div>
      </div>

      <!-- Small Benefit Indicators -->
      <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/70">
          <svg class="w-2.5 h-2.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>{t.benefitFaster}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/70">
          <svg class="w-2.5 h-2.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span>{t.benefitOffline}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/70">
