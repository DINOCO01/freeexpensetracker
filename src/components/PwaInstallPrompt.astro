          type="button"
          id="btn-pwa-gotit-mobile"
          class="w-full py-2.5 px-3 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors text-center cursor-pointer min-h-[44px] flex items-center justify-center"
        >
          {t.btnGotIt}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    #pwa-install-desktop-card,
    #pwa-install-mobile-sheet {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY_INSTALLED = 'fxt_pwa_installed';
    const STORAGE_KEY_DISMISSED_UNTIL = 'fxt_pwa_dismissed_until';
    const COOLDOWN_DAYS = 7;
    const COOLDOWN_MS = COOLDOWN_DAYS * 24 * 60 * 60 * 1000;

    let deferredPrompt = null;
    let isPromptVisible = false;
    let scheduledTimer = null;
    let engagementCount = 0;

    // Listen for native beforeinstallprompt event
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      window.fxtDeferredPwaPrompt = e;
    });

    // Detect app installation event
    window.addEventListener('appinstalled', () => {
      try {
        localStorage.setItem(STORAGE_KEY_INSTALLED, 'true');
      } catch (_) {}
      deferredPrompt = null;
      hidePrompt();
    });

    // Check if running in standalone mode
    function isRunningStandalone() {
      try {
        return (
          window.matchMedia('(display-mode: standalone)').matches ||
          window.matchMedia('(display-mode: fullscreen)').matches ||
          window.navigator.standalone === true ||
          localStorage.getItem(STORAGE_KEY_INSTALLED) === 'true'
        );
      } catch (_) {
        return false;
      }
    }

    // Check if dismissed and within cooldown
    function isWithinCooldown() {
      try {
        const dismissedUntil = parseInt(localStorage.getItem(STORAGE_KEY_DISMISSED_UNTIL) || '0', 10);
        return !isNaN(dismissedUntil) && dismissedUntil > Date.now();
      } catch (_) {
        return false;
      }
    }

    // Check if user is actively entering transactions or filling forms
    function isUserInputActive() {
      const active = document.activeElement;
      if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable)) {
        return true;
      }
      return false;
    }

    // Check if any modal or dialogue is currently open
    function isModalOrWorkflowActive() {
      // Check standard modal IDs
      const modalIds = [
        'file-import-modal',
        'reset-confirm-modal',
        'debt-payment-modal',
        'goal-contribution-modal',
        'transaction-history-modal',
        'mrb-activity-popup'
      ];
      for (let i = 0; i < modalIds.length; i++) {
        const el = document.getElementById(modalIds[i]);
        if (el && !el.classList.contains('hidden') && el.style.display !== 'none') {
          return true;
        }
      }

      // Check generic dialog or modal containers
      const anyModal = document.querySelector('.modal:not(.hidden), [role="dialog"]:not(.hidden):not(#pwa-install-desktop-card):not(#pwa-install-mobile-sheet)');
      if (anyModal && anyModal.offsetParent !== null) {
        return true;
      }

      return false;
    }

    // Dismiss prompt and record cooldown
    function dismissPrompt() {
      try {
        localStorage.setItem(STORAGE_KEY_DISMISSED_UNTIL, (Date.now() + COOLDOWN_MS).toString());
      } catch (_) {}
      hidePrompt();
    }

    // Hide prompt with smooth animation
    function hidePrompt() {
      isPromptVisible = false;

      const desktopCard = document.getElementById('pwa-install-desktop-card');
      const mobileSheet = document.getElementById('pwa-install-mobile-sheet');

      if (desktopCard) {
        desktopCard.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        desktopCard.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
        setTimeout(() => {
          if (!isPromptVisible) {
            desktopCard.classList.add('hidden', 'sm:hidden');
          }
        }, 300);
      }

      if (mobileSheet) {
        mobileSheet.classList.remove('translate-y-0', 'pointer-events-auto');
        mobileSheet.classList.add('translate-y-full', 'pointer-events-none');
        setTimeout(() => {
          if (!isPromptVisible) {
            mobileSheet.classList.add('hidden');
          }
        }, 300);
      }
    }

    // Detect client platform for fallback installation instructions
    function detectPlatform() {
      const ua = navigator.userAgent || '';
      const isIos = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const isAndroid = /Android/.test(ua);
      const isChromeOrEdgeDesktop = /Chrome|Edg/.test(ua) && !isIos && !isAndroid;
      return { isIos, isAndroid, isChromeOrEdgeDesktop };
    }

    // Trigger installation flow
    async function handleInstallClick() {
      if (deferredPrompt) {
        try {
          deferredPrompt.prompt();
          const choiceResult = await deferredPrompt.userChoice;
          if (choiceResult && choiceResult.outcome === 'accepted') {
            try {
              localStorage.setItem(STORAGE_KEY_INSTALLED, 'true');
            } catch (_) {}
            hidePrompt();
          }
        } catch (err) {
          console.warn('[PWA] Prompt error:', err);
        }
        deferredPrompt = null;
        window.fxtDeferredPwaPrompt = null;
        return;
      }

      // Fallback instructions when native prompt is not available
      const platform = detectPlatform();
      const root = document.getElementById('pwa-install-prompt-root');
      const locale = (root && root.getAttribute('data-locale')) || 'en';

      const isMobile = window.innerWidth < 640;
      if (isMobile) {
        const promoState = document.getElementById('pwa-mobile-promo-state');
        const fallbackState = document.getElementById('pwa-mobile-fallback-state');
        const fallbackText = document.getElementById('pwa-mobile-fallback-text');
        if (promoState && fallbackState && fallbackText) {
          if (platform.isIos) {
            fallbackText.textContent = locale === 'fr'
              ? 'Appuyez sur le bouton Partager dans Safari, puis sélectionnez "Sur l\'écran d\'accueil".'
              : 'Tap the Share button at the bottom of Safari, then select "Add to Home Screen".';
          } else if (platform.isAndroid) {
            fallbackText.textContent = locale === 'fr'
              ? 'Appuyez sur le menu (⋮) dans Chrome et sélectionnez "Ajouter à l\'écran d\'accueil".'
              : 'Tap Menu (⋮) at top-right of Chrome, then select "Add to Home Screen" or "Install App".';
          } else {
            fallbackText.textContent = locale === 'fr'
              ? 'Cliquez sur l\'icône Installer dans la barre d\'adresse ou le menu du navigateur.'
              : 'Click the Install icon in the browser address bar or menu.';
          }
          promoState.classList.add('hidden');
          fallbackState.classList.remove('hidden');
        }
      } else {
        const promoState = document.getElementById('pwa-desktop-promo-state');
        const fallbackState = document.getElementById('pwa-desktop-fallback-state');
        const fallbackText = document.getElementById('pwa-desktop-fallback-text');
        if (promoState && fallbackState && fallbackText) {
          fallbackText.textContent = locale === 'fr'
            ? 'Cliquez sur l\'icône Installer (⊕) dans la barre d\'adresse de votre navigateur ou utilisez Menu → Installer.'
            : 'Click the Install icon (⊕) in your browser address bar, or use Menu → Install FreeExpenseTracker.';
          promoState.classList.add('hidden');
          fallbackState.classList.remove('hidden');
        }
      }
    }

    // Display the prompt
    function showPrompt() {
      if (isRunningStandalone() || isWithinCooldown() || isPromptVisible) return;
      if (isUserInputActive() || isModalOrWorkflowActive()) return;

      isPromptVisible = true;
      window.fxtPwaPromptShown = true;

      const isDesktop = window.innerWidth >= 640;
      const desktopCard = document.getElementById('pwa-install-desktop-card');
      const mobileSheet = document.getElementById('pwa-install-mobile-sheet');

      if (isDesktop && desktopCard) {
        // Adjust position dynamically if Buy Me a Coffee widget is present
        const bmcBtn = document.getElementById('bmc-wbtn');
        if (bmcBtn && bmcBtn.offsetHeight > 0) {
          desktopCard.style.bottom = '86px';
        } else {
          desktopCard.style.bottom = '24px';
        }

        desktopCard.classList.remove('hidden', 'sm:hidden');
        // Force reflow
        void desktopCard.offsetWidth;
        desktopCard.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
        desktopCard.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      } else if (!isDesktop && mobileSheet) {
        mobileSheet.classList.remove('hidden');
        // Force reflow
        void mobileSheet.offsetWidth;
        mobileSheet.classList.remove('translate-y-full', 'pointer-events-none');
        mobileSheet.classList.add('translate-y-0', 'pointer-events-auto');
      }
    }

    // Centralized trigger evaluation with delay
    function schedulePrompt(delayMs, reason) {
      if (isRunningStandalone() || isWithinCooldown() || isPromptVisible) return;

      if (scheduledTimer) clearTimeout(scheduledTimer);

      scheduledTimer = setTimeout(() => {
        scheduledTimer = null;
        if (isRunningStandalone() || isWithinCooldown() || isPromptVisible) return;

        // If user is currently typing in an input, wait until blur
        if (isUserInputActive()) {
          const active = document.activeElement;
          if (active) {
            active.addEventListener('blur', () => schedulePrompt(1500, 'input_blur'), { once: true });
          }
          return;
        }

        // If a modal is open, wait until modal closes
        if (isModalOrWorkflowActive()) {
          setTimeout(() => schedulePrompt(2000, 'modal_close_retry'), 3500);
          return;
        }

        showPrompt();
      }, delayMs || 3000);
    }

    // Expose Global Trigger Helper
    window.triggerPwaPromptEligibility = function (reason, forceImmediate) {
      engagementCount++;
      if (forceImmediate) {
        showPrompt();
        return;
      }
      // For general tab exploration, require at least 2 navigation switches
      if (reason === 'tab_exploration' && engagementCount < 2) {
        return;
      }
      schedulePrompt(3000, reason);
    };

    // Expose State Reset Helper for Testing
    window.resetPwaPromptState = function () {
      try {
        localStorage.removeItem(STORAGE_KEY_DISMISSED_UNTIL);
        localStorage.removeItem(STORAGE_KEY_INSTALLED);
      } catch (_) {}
      isPromptVisible = false;
      window.fxtPwaPromptShown = false;
      engagementCount = 0;
      if (scheduledTimer) {
        clearTimeout(scheduledTimer);
        scheduledTimer = null;
      }
      hidePrompt();
    };

    // Attach User Event Listeners
    function attachListeners() {
      // Desktop action buttons
      const btnDismissDesktop = document.getElementById('btn-pwa-dismiss-desktop');
      const btnCloseDesktop = document.getElementById('btn-pwa-close-desktop');
      const btnInstallDesktop = document.getElementById('btn-pwa-install-desktop');
      const btnGotitDesktop = document.getElementById('btn-pwa-gotit-desktop');

      btnDismissDesktop?.addEventListener('click', dismissPrompt);
      btnCloseDesktop?.addEventListener('click', dismissPrompt);
      btnGotitDesktop?.addEventListener('click', dismissPrompt);
      btnInstallDesktop?.addEventListener('click', handleInstallClick);

      // Mobile action buttons
      const btnDismissMobile = document.getElementById('btn-pwa-dismiss-mobile');
      const btnCloseMobile = document.getElementById('btn-pwa-close-mobile');
      const btnInstallMobile = document.getElementById('btn-pwa-install-mobile');
      const btnGotitMobile = document.getElementById('btn-pwa-gotit-mobile');

      btnDismissMobile?.addEventListener('click', dismissPrompt);
      btnCloseMobile?.addEventListener('click', dismissPrompt);
      btnGotitMobile?.addEventListener('click', dismissPrompt);
      btnInstallMobile?.addEventListener('click', handleInstallClick);

      // Support Escape key on Desktop
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isPromptVisible) {
          dismissPrompt();
        }
      });

      // Mobile drag-to-dismiss gesture
      const dragHandle = document.getElementById('pwa-mobile-drag-handle');
      const mobileSheet = document.getElementById('pwa-install-mobile-sheet');
      if (dragHandle && mobileSheet) {
        let startY = 0;
        let currentY = 0;
        let isDragging = false;

        dragHandle.addEventListener('touchstart', (e) => {
          startY = e.touches[0].clientY;
          isDragging = true;
          mobileSheet.style.transition = 'none';
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentY = e.touches[0].clientY;
          const deltaY = currentY - startY;
          if (deltaY > 0) {
            mobileSheet.style.transform = `translateY(${deltaY}px)`;
          }
        }, { passive: true });

        window.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;
          mobileSheet.style.transition = '';
          const deltaY = currentY - startY;
          if (deltaY > 60) {
            dismissPrompt();
          } else {
            mobileSheet.style.transform = 'translateY(0)';
          }
        });
      }

      // Meaningful Engagement Triggers:
      // 1. Tab switches
      const tabButtons = document.querySelectorAll('[data-tab], [data-bottom-tab], [role="tab"], .format-tab-btn');
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          window.triggerPwaPromptEligibility('tab_exploration');
        });
      });

      // 2. Template XLSX downloads
      const downloadLinks = document.querySelectorAll('a[download], a[href$=".xlsx"], #btn-export-csv, #btn-modal-export-excel, #btn-export-excel-quick');
      downloadLinks.forEach((link) => {
        link.addEventListener('click', () => {
          window.triggerPwaPromptEligibility('template_download');
        });
      });

      // 3. Google Sheets template openings
      const sheetLinks = document.querySelectorAll('.btn-open-google-sheets, a[href*="docs.google.com/spreadsheets"]');
      sheetLinks.forEach((link) => {
        link.addEventListener('click', () => {
          window.triggerPwaPromptEligibility('google_sheets_open');
        });
      });

      // 4. Calculator completions
      const calcButtons = document.querySelectorAll('#btn-strat-avalanche, #btn-strat-snowball, #btn-strat-foir, #btn-calc-split');
      calcButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          window.triggerPwaPromptEligibility('calculator_completed');
        });
      });

      // 5. Global Activity Hook & Custom Events
      window.addEventListener('fet:activity-completed', () => {
        window.triggerPwaPromptEligibility('expense_logged');
      });

      window.addEventListener('pwa:trigger-eligible', (e) => {
        const reason = (e && e.detail && e.detail.reason) || 'custom_event';
        window.triggerPwaPromptEligibility(reason);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachListeners);
    } else {
      attachListeners();
    }
  })();
</script>
