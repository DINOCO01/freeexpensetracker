    fileSize: '31.5 KB'
  }
];

const CATEGORIES = [
  { key: 'all', labelKey: 'templates.catAll', count: 16, icon: '📂' },
  { key: 'catBudget', labelKey: 'templates.catBudget', count: 3, icon: '💰' },
  { key: 'catDebt', labelKey: 'templates.catDebt', count: 6, icon: '💳' },
  { key: 'catSavings', labelKey: 'templates.catSavings', count: 2, icon: '🛡️' },
  { key: 'catInvesting', labelKey: 'templates.catInvesting', count: 3, icon: '📈' },
  { key: 'catBills', labelKey: 'templates.catBills', count: 2, icon: '🧾' }
];

function getCategoryColor(categoryKey: string): { bg: string; text: string; border: string } {
  if (categoryKey === 'catBudget') {
    return {
      bg: 'bg-emerald-50 dark:bg-emerald-950/40',
      text: 'text-emerald-700 dark:text-emerald-300',
      border: 'border-emerald-200/70 dark:border-emerald-800/60'
    };
  }
  if (categoryKey === 'catDebt') {
    return {
      bg: 'bg-amber-50 dark:bg-amber-950/40',
      text: 'text-amber-800 dark:text-amber-300',
      border: 'border-amber-200/70 dark:border-amber-800/60'
    };
  }
  if (categoryKey === 'catSavings') {
    return {
      bg: 'bg-sky-50 dark:bg-sky-950/40',
      text: 'text-sky-800 dark:text-sky-300',
      border: 'border-sky-200/70 dark:border-sky-800/60'
    };
  }
  if (categoryKey === 'catInvesting') {
    return {
      bg: 'bg-indigo-50 dark:bg-indigo-950/40',
      text: 'text-indigo-800 dark:text-indigo-300',
      border: 'border-indigo-200/70 dark:border-indigo-800/60'
    };
  }
  return {
    bg: 'bg-rose-50 dark:bg-rose-950/40',
    text: 'text-rose-800 dark:text-rose-300',
    border: 'border-rose-200/70 dark:border-rose-800/60'
  };
}

const slugMap: Record<string, string> = {
  'paycheck-budget': 'paycheck-budget',
  'debt-snowball': 'debt-snowball',
  'debt-avalanche': 'debt-avalanche',
  'debt-to-income': 'debt-to-income-calculator',
  'student-loan': 'student-loan-planner',
  'auto-loan': 'auto-loan-calculator',
  'mortgage-planner': 'mortgage-planner',
  '401k-retirement': '401k-retirement-planner',
  'roth-ira': 'roth-ira-planner',
  'emergency-fund': 'emergency-fund-planner',
  'subscription-audit': 'subscription-audit',
  'sinking-fund': 'sinking-fund-planner',
  'net-worth': 'net-worth-tracker',
  'financial-dashboard': 'financial-dashboard',
  'monthly-spending': 'monthly-spending-analyzer',
  'monthly-bill-tracker': 'monthly-bill-tracker'
};
---

<div class="space-y-6">
  <!-- Clean Section Header -->
  <div class="text-center max-w-2xl mx-auto space-y-2 pt-1 sm:pt-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 shadow-2xs">
      <span>📋</span>
      <span>{t('templates.badge', locale)}</span>
    </div>

    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
      {t('templates.title', locale)}
    </h2>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed px-2">
      {t('templates.subtitle', locale)}
    </p>

    <!-- Subtle Trust Indicator -->
    <div class="pt-0.5">
      <span class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium">
        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>{t('templates.privatePill', locale)}</span>
      </span>
    </div>
  </div>

  <!-- Interactive Controls Bar: Switcher + Category Filters -->
  <div class="space-y-3.5">
    <!-- Format Toggle: Excel / Google Sheets -->
    <div class="flex items-center justify-center">
      <div class="inline-flex p-1 bg-slate-100 dark:bg-slate-800/90 rounded-xl border border-slate-200/80 dark:border-slate-700/80 shadow-2xs" role="tablist" aria-label="Template format switcher">
        <button
          type="button"
          id="btn-format-excel"
          role="tab"
          aria-selected="true"
          aria-controls="panel-templates-excel"
          class="format-tab-btn active inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold transition-all cursor-pointer bg-white dark:bg-slate-700 text-emerald-800 dark:text-emerald-300 shadow-xs border border-slate-200/90 dark:border-slate-600"
        >
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z"/>
            <path d="M9.5 11l1.8 3-1.8 3h1.7l1-1.8 1 1.8h1.7l-1.8-3 1.8-3h-1.7l-1 1.8-1-1.8H9.5z"/>
          </svg>
          <span>{t('templates.tabExcel', locale)}</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300">15</span>
        </button>

        <button
          type="button"
          id="btn-format-sheets"
          role="tab"
          aria-selected="false"
          aria-controls="panel-templates-sheets"
          class="format-tab-btn inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold transition-all cursor-pointer text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100"
        >
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/>
            <path d="M7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/>
          </svg>
          <span>{t('templates.tabSheets', locale)}</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] font-mono bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300">15</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Bar (Horizontally scrollable on mobile) -->
    <div class="flex items-center justify-start sm:justify-center overflow-x-auto no-scrollbar scroll-smooth py-1 gap-1.5 -mx-3 px-3 sm:mx-0 sm:px-0">
      {CATEGORIES.map((cat) => (
        <button
          type="button"
          data-category-filter={cat.key}
          class={`tmpl-cat-filter shrink-0 px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer select-none ${
            cat.key === 'all'
              ? 'active font-semibold bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 shadow-2xs'
              : 'font-medium bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 border border-slate-200/80 dark:border-slate-700/80'
          }`}
        >
          <span>{cat.icon} {t(cat.labelKey, locale)}</span>
          <span class="ml-1 opacity-70 text-[10px] font-mono">{cat.count}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- PANEL 1: EXCEL TEMPLATES -->
  <div id="panel-templates-excel" class="space-y-4" role="tabpanel" aria-labelledby="btn-format-excel">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {TEMPLATES.map((tmpl) => {
        const catColor = getCategoryColor(tmpl.categoryKey);
        const catLabel = t(`templates.${tmpl.categoryKey}`, locale);
        return (
          <div
            data-category={tmpl.categoryKey}
            class="template-card-item bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs hover:border-emerald-300 dark:hover:border-emerald-700/70 hover:shadow-sm transition-all flex flex-col justify-between gap-4 group"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-semibold border ${catColor.bg} ${catColor.text} ${catColor.border}`}>
                  <span>{tmpl.categoryIcon}</span>
                  <span>{catLabel}</span>
                </span>
                <span class="text-[10px] font-mono font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">
                  .xlsx • {tmpl.fileSize}
                </span>
              </div>

              <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                  {t(tmpl.nameKey, locale)}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed line-clamp-2">
                  {t(tmpl.descKey, locale)}
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 space-y-2">
              <a
                href={`/templates/${tmpl.fileName}`}
                download={tmpl.fileName}
                class="w-full inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-600 active:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-2xs hover:shadow-xs transition-colors cursor-pointer"
                aria-label={`Download ${t(tmpl.nameKey, locale)} Excel Template`}
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>{t('templates.btnDownloadExcel', locale)}</span>
              </a>
              <a
                href={locale === 'fr' ? `/fr/templates/${slugMap[tmpl.id] || tmpl.id}/` : `/templates/${slugMap[tmpl.id] || tmpl.id}/`}
                class="w-full inline-flex items-center justify-center gap-1 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400 hover:underline pt-0.5"
              >
                <span>{t('templates.guideFormulas', locale)}</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- PANEL 2: GOOGLE SHEETS TEMPLATES -->
  <div id="panel-templates-sheets" class="space-y-4 hidden" role="tabpanel" aria-labelledby="btn-format-sheets">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {TEMPLATES.map((tmpl) => {
        const catColor = getCategoryColor(tmpl.categoryKey);
        const catLabel = t(`templates.${tmpl.categoryKey}`, locale);
        return (
          <div
            data-category={tmpl.categoryKey}
            class="template-card-item bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs hover:border-emerald-300 dark:hover:border-emerald-700/70 hover:shadow-sm transition-all flex flex-col justify-between gap-4 group"
          >
            <div class="space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-[11px] font-semibold border ${catColor.bg} ${catColor.text} ${catColor.border}`}>
                  <span>{tmpl.categoryIcon}</span>
                  <span>{catLabel}</span>
                </span>
                <span class="text-[10px] font-mono font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">
                  Google Sheets
                </span>
              </div>

              <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                  {t(tmpl.nameKey, locale)}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed line-clamp-2">
                  {t(tmpl.descKey, locale)}
                </p>
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80">
              <a
                href={tmpl.googleSheetsUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-template-name={tmpl.id}
                class="btn-open-google-sheets w-full inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-600 active:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-2xs hover:shadow-xs transition-colors cursor-pointer"
                aria-label={`Open ${t(tmpl.nameKey, locale)} in Google Sheets`}
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span>{t('templates.btnOpenSheets', locale)}</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Helpful Workflow Tip Box -->
  <div class="p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 dark:from-emerald-950/40 dark:via-teal-950/30 dark:to-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-10 h-10 rounded-xl bg-white dark:bg-slate-800 text-emerald-800 dark:text-emerald-300 flex items-center justify-center shrink-0 border border-emerald-200 dark:border-emerald-700 shadow-2xs font-bold text-lg">
        🔄
      </div>
      <div class="space-y-0.5">
        <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">
          {t('importer.title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300">
          {t('importer.subtitle', locale)}
        </p>
      </div>
    </div>

    <button
      type="button"
      id="btn-switch-to-importer-from-templates"
      class="shrink-0 px-3.5 py-2 rounded-xl text-xs font-bold text-emerald-900 dark:text-emerald-200 bg-white dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-slate-700 border border-emerald-300 dark:border-emerald-700 shadow-2xs transition-colors cursor-pointer"
    >
      {t('nav.importStatement', locale)} 📥
    </button>
  </div>
</div>

<script>
  function setupTemplatesHub() {
    const btnExcel = document.getElementById('btn-format-excel');
    const btnSheets = document.getElementById('btn-format-sheets');
    const panelExcel = document.getElementById('panel-templates-excel');
    const panelSheets = document.getElementById('panel-templates-sheets');
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.tmpl-cat-filter');
    const cardItems = document.querySelectorAll<HTMLElement>('.template-card-item');

    if (!btnExcel || !btnSheets || !panelExcel || !panelSheets) return;

    let currentCategory = 'all';

    const activeFormatClasses = ['bg-white', 'dark:bg-slate-700', 'text-emerald-800', 'dark:text-emerald-300', 'shadow-xs', 'border', 'border-slate-200/90', 'dark:border-slate-600', 'font-bold'];
    const inactiveFormatClasses = ['text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'dark:hover:text-slate-100', 'font-semibold'];

    const activeCatClasses = ['bg-slate-900', 'dark:bg-slate-100', 'text-white', 'dark:text-slate-900', 'font-semibold', 'shadow-2xs'];
    const inactiveCatClasses = ['bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-400', 'hover:text-slate-900', 'dark:hover:text-slate-200', 'border', 'border-slate-200/80', 'dark:border-slate-700/80', 'font-medium'];

    function applyCategoryFilter(cat: string) {
      currentCategory = cat;

      catButtons.forEach((btn) => {
        const btnCat = btn.getAttribute('data-category-filter');
        if (btnCat === cat) {
          btn.classList.add(...activeCatClasses);
          btn.classList.remove(...inactiveCatClasses);
        } else {
          btn.classList.remove(...activeCatClasses);
          btn.classList.add(...inactiveCatClasses);
        }
      });

      cardItems.forEach((card) => {
        const itemCat = card.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function selectExcel() {
      btnExcel?.classList.add(...activeFormatClasses);
      btnExcel?.classList.remove(...inactiveFormatClasses);
      btnExcel?.setAttribute('aria-selected', 'true');

      btnSheets?.classList.remove(...activeFormatClasses);
      btnSheets?.classList.add(...inactiveFormatClasses);
      btnSheets?.setAttribute('aria-selected', 'false');

      panelExcel?.classList.remove('hidden');
      panelSheets?.classList.add('hidden');
    }

    function selectSheets() {
      btnSheets?.classList.add(...activeFormatClasses);
      btnSheets?.classList.remove(...inactiveFormatClasses);
      btnSheets?.setAttribute('aria-selected', 'true');

      btnExcel?.classList.remove(...activeFormatClasses);
      btnExcel?.classList.add(...inactiveFormatClasses);
      btnExcel?.setAttribute('aria-selected', 'false');

      panelSheets?.classList.remove('hidden');
      panelExcel?.classList.add('hidden');
    }

    btnExcel.addEventListener('click', selectExcel);
    btnSheets.addEventListener('click', selectSheets);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCat = btn.getAttribute('data-category-filter') || 'all';
        applyCategoryFilter(targetCat);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTemplatesHub);
  } else {
    setupTemplatesHub();
  }
</script>
