---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

export interface TemplateDefinition {
  id: string;
  nameKey: string;
  descKey: string;
  categoryKey: string;
  categoryIcon: string;
  fileName: string;
  googleSheetsUrl: string;
  fileSize: string;
