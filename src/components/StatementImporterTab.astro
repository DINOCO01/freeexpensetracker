---
---

<div class="space-y-6">
  <!-- Header -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-800 flex items-center justify-center font-bold text-base border border-emerald-200">
          📥
        </span>
        <h2 class="text-xl font-bold text-slate-900 font-['Outfit',sans-serif]">
          Universal Statement & Receipt Importer
        </h2>
        <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300">
          Batch & Multi-Format
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-600">
        Upload multiple bank statements and receipt photos simultaneously. We automatically extract transactions, classify spending categories, and generate financial insights in your browser.
      </p>
    </div>

    <!-- Privacy Guarantee Pill -->
    <div class="shrink-0 flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-medium">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span>100% Client-Side Private • Zero Server Uploads</span>
    </div>
  </div>

  <!-- Supported Formats Bar -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 flex items-center justify-center text-sm font-bold border border-blue-200">
        📸
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900">Any Image Format</div>
        <div class="text-[10px] text-slate-500 font-mono">PNG, JPG, WebP, HEIC, TIFF, BMP, GIF, AVIF</div>
      </div>
    </div>

    <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-700 flex items-center justify-center text-sm font-bold border border-rose-200">
        📄
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900">PDF Bank Statements</div>
        <div class="text-[10px] text-slate-500 font-mono">Auto table coordinate reading</div>
      </div>
    </div>

    <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-bold border border-emerald-200">
        📊
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900">Excel & CSV Spreadsheets</div>
        <div class="text-[10px] text-slate-500 font-mono">.xlsx, .xls, .csv statements</div>
      </div>
    </div>

    <div class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-700 flex items-center justify-center text-sm font-bold border border-purple-200">
        ⚡
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900">Multi-File Batch</div>
        <div class="text-[10px] text-slate-500 font-mono">Select or drop multiple at once</div>
      </div>
    </div>
  </div>

  <!-- Multi-File Dropzone Area -->
  <div
    id="tab-importer-dropzone"
    class="border-2 border-dashed border-slate-300 hover:border-emerald-600 rounded-2xl p-8 sm:p-12 text-center transition-all bg-white hover:bg-emerald-50/30 cursor-pointer space-y-4 group shadow-xs"
  >
    <input
      type="file"
      id="tab-importer-file-input"
      multiple
      accept="image/*, .png, .jpg, .jpeg, .webp, .heic, .heif, .bmp, .tiff, .tif, .gif, .avif, .svg, .ico, .pdf, .xlsx, .xls, .csv, application/pdf"
      class="hidden"
    />

    <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-700 group-hover:bg-emerald-100 group-hover:scale-105 flex items-center justify-center mx-auto transition-all shadow-xs border border-emerald-200">
      <svg class="w-8 h-8 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
    </div>

    <div class="space-y-1">
      <div class="text-base font-bold text-slate-900">
        Click to select files, or drag & drop them here
      </div>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        Hold <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded text-[10px] font-mono">Ctrl</kbd> or <kbd class="px-1.5 py-0.5 bg-slate-100 border border-slate-300 rounded text-[10px] font-mono">Cmd</kbd> to select multiple receipt photos and statements simultaneously.
      </p>
    </div>

    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold group-hover:bg-emerald-700 group-hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>Browse Multiple Files</span>
    </div>
  </div>

  <!-- Processing State Banner -->
  <div id="tab-importer-progress" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 space-y-2">
    <div class="flex items-center justify-between font-bold">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 animate-spin text-emerald-700" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        <span id="tab-importer-progress-text">Processing files...</span>
      </span>
      <span id="tab-importer-progress-pct" class="font-mono">0%</span>
    </div>
    <div class="w-full bg-emerald-200/60 rounded-full h-2 overflow-hidden">
      <div id="tab-importer-progress-bar" class="bg-emerald-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
    </div>
  </div>

  <!-- Error Banner -->
  <div id="tab-importer-error" class="hidden p-4 rounded-xl bg-rose-50 text-rose-800 text-xs font-medium border border-rose-200">
  </div>

  <!-- Batch Results Section (Hidden until files parsed) -->
  <div id="tab-importer-results" class="hidden space-y-6">
    <!-- File badges list -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs space-y-2">
      <div class="text-xs font-bold text-slate-800 flex items-center justify-between">
        <span>Files in this batch:</span>
        <span id="tab-importer-file-count-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-slate-100 text-slate-700">0 files</span>
      </div>
      <div id="tab-importer-files-chips" class="flex flex-wrap gap-2 pt-1">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Aggregated Metrics Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 font-medium">Extracted Records</div>
        <div id="tab-result-record-count" class="text-2xl font-extrabold font-mono text-slate-900 mt-1">0</div>
        <div class="text-[11px] text-slate-500 mt-0.5">Across all uploaded files</div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 font-medium">Total Outflow Amount</div>
        <div id="tab-result-total-amount" class="text-2xl font-extrabold font-mono text-rose-600 mt-1">—</div>
        <div class="text-[11px] text-slate-500 mt-0.5">Parsed expense transactions</div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 font-medium">Total Inflow Amount</div>
        <div id="tab-result-total-inflow" class="text-2xl font-extrabold font-mono text-emerald-600 mt-1">—</div>
        <div class="text-[11px] text-slate-500 mt-0.5">Parsed deposits & income</div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 font-medium">Top Outflow Category</div>
        <div id="tab-result-top-category" class="text-2xl font-extrabold font-mono text-emerald-800 mt-1">N/A</div>
        <div id="tab-result-top-cat-sub" class="text-[11px] text-slate-500 mt-0.5">0% of total spend</div>
      </div>
    </div>

    <!-- Smart Automated Insights List -->
    <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 space-y-2.5">
      <div class="text-xs font-bold text-emerald-950 flex items-center gap-1.5">
        <span>💡</span>
        <span>Automated Statement Insights & Findings</span>
      </div>
      <div id="tab-result-insights-list" class="space-y-1.5 text-xs text-slate-700">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Action Toolbar: Apply to Tracker -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-xs text-slate-600">
        Choose how to integrate these transactions into your <strong class="text-slate-900">Live Tracker</strong>:
      </div>
      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        <button
          type="button"
          id="btn-tab-apply-replace"
          class="flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 transition-colors shadow-2xs cursor-pointer"
        >
          🔄 Replace Tracker
        </button>
        <button
          type="button"
          id="btn-tab-apply-append"
          class="flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-600 transition-colors shadow-2xs cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>➕ Append to Tracker</span>
        </button>
        <button
          type="button"
          id="btn-tab-reset-import"
          class="px-3 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 transition-colors cursor-pointer"
          title="Clear and upload new files"
        >
          Clear
        </button>
      </div>
    </div>

    <!-- Extracted Transactions Preview Table -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-slate-900 font-['Outfit',sans-serif]">
          Extracted Transactions Preview (<span id="tab-result-table-count">0</span>)
        </h3>
        <span class="text-xs text-slate-500">Auto-classified by description</span>
      </div>

      <div class="max-h-80 overflow-y-auto border border-slate-200 rounded-xl">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200 sticky top-0">
            <tr>
              <th class="py-2.5 px-3">Date</th>
              <th class="py-2.5 px-3">Description / Merchant</th>
              <th class="py-2.5 px-3">Category</th>
              <th class="py-2.5 px-3 text-right">Amount</th>
            </tr>
          </thead>
          <tbody id="tab-result-table-tbody" class="divide-y divide-slate-100 font-mono">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
