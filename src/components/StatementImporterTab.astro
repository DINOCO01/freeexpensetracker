---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<div class="space-y-6">
  <!-- Header -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 flex items-center justify-center font-bold text-base border border-emerald-200 dark:border-emerald-800">
          📥
        </span>
        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
          {t('importer.title', locale)}
        </h2>
        <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700">
          {t('importer.badge', locale)}
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        {t('importer.subtitle', locale)}
      </p>
    </div>

    <!-- Privacy Guarantee Pill -->
    <div class="shrink-0 flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 text-xs font-medium">
      <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span>{t('importer.privatePill', locale)}</span>
    </div>
  </div>

  <!-- Supported Formats Bar -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 flex items-center justify-center text-sm font-bold border border-blue-200 dark:border-blue-800">
        📸
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.formatsReceipts', locale)}</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">{t('importer.formatsReceiptsSub', locale)}</div>
      </div>
    </div>

    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 flex items-center justify-center text-sm font-bold border border-rose-200 dark:border-rose-800">
        📄
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.formatsPdf', locale)}</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">{t('importer.formatsPdfSub', locale)}</div>
      </div>
    </div>

    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-sm font-bold border border-emerald-200 dark:border-emerald-800">
        📊
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.formatsExcel', locale)}</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">{t('importer.formatsExcelSub', locale)}</div>
      </div>
    </div>

    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center gap-2.5 shadow-2xs">
      <div class="w-8 h-8 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 flex items-center justify-center text-sm font-bold border border-teal-200 dark:border-teal-800">
        🌐
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.formatsSheets', locale)}</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">{t('importer.formatsSheetsSub', locale)}</div>
      </div>
    </div>

    <div class="p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl flex items-center gap-2.5 shadow-2xs col-span-2 sm:col-span-1">
      <div class="w-8 h-8 rounded-lg bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 flex items-center justify-center text-sm font-bold border border-purple-200 dark:border-purple-800">
        ⚡
      </div>
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.formatsBatch', locale)}</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">{t('importer.formatsBatchSub', locale)}</div>
      </div>
    </div>
  </div>

  <!-- Multi-File Dropzone Area -->
  <div
    id="tab-importer-dropzone"
    class="border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-600 rounded-2xl p-8 sm:p-12 text-center transition-all bg-white dark:bg-slate-900 hover:bg-emerald-50/30 dark:hover:bg-emerald-950/20 cursor-pointer space-y-4 group shadow-xs"
  >
    <input
      type="file"
      id="tab-importer-file-input"
      multiple
      accept="image/*, .png, .jpg, .jpeg, .webp, .heic, .heif, .bmp, .tiff, .tif, .gif, .avif, .svg, .ico, .pdf, .xlsx, .xls, .csv, application/pdf"
      class="hidden"
    />

    <div class="w-16 h-16 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 group-hover:bg-emerald-100 group-hover:scale-105 flex items-center justify-center mx-auto transition-all shadow-xs border border-emerald-200 dark:border-emerald-800">
      <svg class="w-8 h-8 text-emerald-700 dark:text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
    </div>

    <div class="space-y-1">
      <div class="text-base font-bold text-slate-900 dark:text-slate-100">
        {t('importer.dropzoneTitle', locale)}
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md mx-auto">
        {t('importer.dropzoneSub', locale)}
      </p>
    </div>

    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold group-hover:bg-emerald-700 group-hover:text-white transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>{t('importer.btnBrowse', locale)}</span>
    </div>
  </div>

  <!-- Google Sheets Direct URL Import Section -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-6 h-6 rounded-lg bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 flex items-center justify-center font-bold text-xs border border-teal-200 dark:border-teal-800">
          🌐
        </span>
        <span class="text-xs font-bold text-slate-900 dark:text-slate-100">{t('importer.googleSheetsLabel', locale)}</span>
      </div>
      <span class="text-[11px] text-slate-500 dark:text-slate-400">{t('importer.publicSheetHint', locale)}</span>
    </div>
    <div class="flex flex-col sm:flex-row gap-2">
      <input
        type="url"
        id="tab-importer-sheet-url"
        placeholder={t('importer.googleSheetsPlaceholder', locale)}
        class="flex-1 px-3.5 py-2 rounded-xl text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent font-mono text-slate-800 dark:text-slate-100"
      />
      <button
        type="button"
        id="btn-tab-import-sheet"
        class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-teal-700 hover:bg-teal-800 transition-colors shadow-2xs shrink-0 cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>{t('importer.btnFetchSheets', locale)}</span>
      </button>
    </div>
  </div>

  <!-- Processing State Banner -->
  <div id="tab-importer-progress" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs text-emerald-900 dark:text-emerald-200 space-y-2">
    <div class="flex items-center justify-between font-bold">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 animate-spin text-emerald-700 dark:text-emerald-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        <span id="tab-importer-progress-text">{t('importer.processingFiles', locale)}</span>
      </span>
      <span id="tab-importer-progress-pct" class="font-mono">0%</span>
    </div>
    <div class="w-full bg-emerald-200/60 dark:bg-emerald-800/60 rounded-full h-2 overflow-hidden">
      <div id="tab-importer-progress-bar" class="bg-emerald-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
    </div>
  </div>

  <!-- Error Banner -->
  <div id="tab-importer-error" class="hidden p-4 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 text-xs font-medium border border-rose-200 dark:border-rose-900">
  </div>

  <!-- Batch Results Section (Hidden until files parsed) -->
  <div id="tab-importer-results" class="hidden space-y-6">
    <!-- File badges list -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs space-y-2">
      <div class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center justify-between">
        <span>{t('importer.batchFilesLabel', locale)}:</span>
        <span id="tab-importer-file-count-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">0 files</span>
      </div>
      <div id="tab-importer-files-chips" class="flex flex-wrap gap-2 pt-1">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Aggregated Metrics Highlights -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t('importer.extractedRecords', locale)}</div>
        <div id="tab-result-record-count" class="text-2xl font-extrabold font-mono text-slate-900 dark:text-slate-100 mt-1">0</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{t('importer.acrossAllFiles', locale)}</div>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t('importer.outflowsDetected', locale)}</div>
        <div id="tab-result-total-amount" class="text-2xl font-extrabold font-mono text-rose-600 mt-1">—</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{t('importer.parsedExpenses', locale)}</div>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t('importer.incomeDetected', locale)}</div>
        <div id="tab-result-total-inflow" class="text-2xl font-extrabold font-mono text-emerald-600 mt-1">—</div>
        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{t('importer.parsedIncome', locale)}</div>
      </div>

      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t('importer.topOutflowCategory', locale)}</div>
        <div id="tab-result-top-category" class="text-2xl font-extrabold font-mono text-emerald-800 dark:text-emerald-300 mt-1">N/A</div>
        <div id="tab-result-top-cat-sub" class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">0% {t('importer.ofTotalSpend', locale)}</div>
      </div>
    </div>

    <!-- Smart Automated Insights List -->
    <div class="p-5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 space-y-2.5">
      <div class="text-xs font-bold text-emerald-950 dark:text-emerald-200 flex items-center gap-1.5">
        <span>💡</span>
        <span>{t('importer.insightsHeading', locale)}</span>
      </div>
      <div id="tab-result-insights-list" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Action Toolbar: Apply to Tracker -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-xs text-slate-600 dark:text-slate-400">
        {t('importer.chooseIntegration', locale)}:
      </div>
      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        <button
          type="button"
          id="btn-tab-apply-replace"
          class="flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold text-white bg-slate-900 dark:bg-slate-700 hover:bg-slate-800 dark:hover:bg-slate-600 transition-colors shadow-2xs cursor-pointer"
        >
          🔄 {t('buttons.replace', locale)}
        </button>
        <button
          type="button"
          id="btn-tab-apply-append"
          class="flex-1 sm:flex-none px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-600 transition-colors shadow-2xs cursor-pointer flex items-center justify-center gap-1.5"
        >
          <span>➕ {t('importer.btnImportAll', locale)}</span>
        </button>
        <button
          type="button"
          id="btn-tab-reset-import"
          class="px-3 py-2 rounded-xl text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
          title="Clear and upload new files"
        >
          {t('buttons.clear', locale)}
        </button>
      </div>
    </div>

    <!-- Extracted Transactions Preview Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
          {t('importer.previewHeading', locale)} (<span id="tab-result-table-count">0</span>)
        </h3>
        <span class="text-xs text-slate-500 dark:text-slate-400">{t('importer.autoClassified', locale)}</span>
      </div>

      <div class="max-h-80 overflow-y-auto border border-slate-200 dark:border-slate-800 rounded-xl">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-semibold border-b border-slate-200 dark:border-slate-700 sticky top-0">
            <tr>
              <th class="py-2.5 px-3">{t('ledger.thDate', locale)}</th>
              <th class="py-2.5 px-3">{t('ledger.thDescription', locale)}</th>
              <th class="py-2.5 px-3">{t('ledger.thCategory', locale)}</th>
              <th class="py-2.5 px-3">{t('importer.thType', locale)}</th>
              <th class="py-2.5 px-3 text-right">{t('ledger.thAmount', locale)}</th>
              <th class="py-2.5 px-3">{t('ledger.thSource', locale)}</th>
              <th class="py-2.5 px-3 text-center">{t('importer.thStatus', locale)}</th>
            </tr>
          </thead>
          <tbody id="tab-result-table-tbody" class="divide-y divide-slate-100 dark:divide-slate-800 font-mono">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
