---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xs space-y-4 sm:space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] flex items-center gap-2">
        <span>✍️</span> {t('logger.title', locale)}
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
        {t('logger.subtitle', locale)}
      </p>
    </div>

    <!-- Quick Actions: Scan Receipt & Clear -->
    <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
      <!-- Hidden file input for receipt photo -->
      <input
        type="file"
        id="input-receipt-photo"
        accept="image/*, .png, .jpg, .jpeg, .webp, .heic, .heif, .bmp, .tiff, .tif, .gif, .avif, .svg, .ico, .pdf"
        class="hidden"
      />

      <button
        type="button"
        id="btn-scan-receipt-logger"
        class="text-xs font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800 px-2.5 sm:px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-1 sm:gap-1.5 shadow-2xs"
        title={t('logger.scanReceipt', locale)}
      >
        <span>📸</span>
        <span>{t('logger.scanReceipt', locale)}</span>
      </button>

      <button
        type="button"
        id="btn-clear-logger"
        class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 bg-slate-50 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 border border-slate-200 dark:border-slate-700 hover:border-rose-200 dark:hover:border-rose-800 px-2.5 sm:px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-1 sm:gap-1.5 shadow-2xs"
        title={t('logger.clear', locale)}
      >
        <svg class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        <span>{t('logger.clear', locale)}</span>
      </button>
    </div>
  </div>

  <!-- OCR Scanning Progress Banner -->
  <div id="receipt-scanning-indicator" class="hidden p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs text-emerald-900 dark:text-emerald-200 space-y-1.5">
    <div class="flex items-center justify-between font-bold">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 animate-spin text-emerald-700 dark:text-emerald-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        {t('logger.readingReceipt', locale)}
      </span>
      <span id="receipt-ocr-progress" class="font-mono">0%</span>
    </div>
    <p class="text-[11px] text-emerald-700 dark:text-emerald-400">{t('logger.extractingDetails', locale)}</p>
  </div>

  <!-- Form -->
  <form id="form-expense-logger" class="space-y-4">
    <!-- Item Description -->
    <div>
      <label for="input-item-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
        {t('logger.descriptionLabel', locale)}
      </label>
      <input
        type="text"
        id="input-item-name"
        required
        placeholder={t('logger.descriptionPlaceholder', locale)}
        class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2 text-xs sm:text-sm text-slate-900 dark:text-slate-100 font-medium placeholder:text-slate-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all shadow-2xs"
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <!-- Amount -->
      <div>
        <label for="input-item-amount" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('logger.amountLabel', locale)} (<span class="currency-label font-mono">$</span>)
        </label>
        <div class="relative rounded-xl shadow-2xs">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <span class="currency-label text-slate-400 font-medium text-xs">$</span>
          </div>
          <input
            type="number"
            id="input-item-amount"
            min="0.01"
            step="0.01"
            required
            placeholder="0.00"
            class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 pl-7 pr-3 py-2 text-xs sm:text-sm text-slate-900 dark:text-slate-100 font-bold font-mono placeholder:text-slate-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all"
          />
        </div>
      </div>

      <!-- Category -->
      <div>
        <label for="select-item-category" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('logger.categoryLabel', locale)}
        </label>
        <select
          id="select-item-category"
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 px-3 py-2 text-xs sm:text-sm text-slate-900 dark:text-slate-100 font-medium bg-white dark:bg-slate-800 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all shadow-2xs cursor-pointer"
        >
          <option value="Housing">🏠 {t('categories.Housing', locale)}</option>
          <option value="Food" selected>🥗 {t('categories.Food', locale)}</option>
          <option value="Transport">🚗 {t('categories.Transport', locale)}</option>
          <option value="Utilities">⚡ {t('categories.Utilities', locale)}</option>
          <option value="Entertainment">🎟️ {t('categories.Entertainment', locale)}</option>
          <option value="Savings">🏦 {t('categories.Savings', locale)}</option>
          <option value="Miscellany">📦 {t('categories.Miscellany', locale)}</option>
          <option value="Income">💵 {t('categories.Income', locale)}</option>
        </select>
      </div>
    </div>

    <!-- Quick Preset Chips -->
    <div>
      <span class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1.5 uppercase tracking-wider">
        {t('logger.quickPresets', locale)}
      </span>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-preset-name="Monthly House Rent"
          data-preset-amount="15000"
          data-preset-category="Housing"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          🏠 {t('categories.Housing', locale)}
        </button>
        <button
          type="button"
          data-preset-name="Supermarket & Groceries"
          data-preset-amount="3500"
          data-preset-category="Food"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          🥗 {t('categories.Food', locale)}
        </button>
        <button
          type="button"
          data-preset-name="Electricity Bill"
          data-preset-amount="1800"
          data-preset-category="Utilities"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          ⚡ {t('categories.Utilities', locale)}
        </button>
        <button
          type="button"
          data-preset-name="Petrol & Metro Travel"
          data-preset-amount="1200"
          data-preset-category="Transport"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors border border-slate-200 dark:border-slate-700 cursor-pointer"
        >
          🚗 {t('categories.Transport', locale)}
        </button>
        <button
          type="button"
          data-preset-name="Emergency Fund / SIP"
          data-preset-amount="5000"
          data-preset-category="Savings"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 dark:bg-emerald-950/60 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 transition-colors border border-emerald-200 dark:border-emerald-800 cursor-pointer"
        >
          🏦 {t('categories.Savings', locale)}
        </button>
      </div>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      class="w-full py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      {t('logger.btnAddExpense', locale)}
    </button>
  </form>
</div>
