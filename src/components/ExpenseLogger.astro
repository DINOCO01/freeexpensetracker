---
---

<div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-6 shadow-xs space-y-4 sm:space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
    <div>
      <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif] flex items-center gap-2">
        <span>✍️</span> Quick Expense Logger
      </h3>
      <p class="text-xs text-slate-600 mt-0.5">
        Add individual outflows, presets, or scan a receipt photo.
      </p>
    </div>

    <!-- Quick Action: Scan Receipt -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Hidden file input for receipt photo -->
      <input
        type="file"
        id="input-receipt-photo"
        accept="image/*, .png, .jpg, .jpeg, .webp, .heic, .heif, .bmp, .tiff, .tif, .gif, .avif, .svg, .ico, .pdf"
        class="hidden"
      />

      <button
        type="button"
        id="btn-scan-receipt-logger"
        class="text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-2.5 sm:px-3 py-1.5 rounded-lg transition-colors cursor-pointer flex items-center gap-1 sm:gap-1.5 shadow-2xs"
        title="Scan Receipt Photo or Bill"
      >
        <span>📸</span>
        <span>Scan Receipt</span>
      </button>
    </div>
  </div>

  <!-- OCR Scanning Progress Banner -->
  <div id="receipt-scanning-indicator" class="hidden p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 space-y-1.5">
    <div class="flex items-center justify-between font-bold">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 animate-spin text-emerald-700" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
        Reading Receipt Photo with AI OCR...
      </span>
      <span id="receipt-ocr-progress" class="font-mono">0%</span>
    </div>
    <p class="text-[11px] text-emerald-700">Extracting merchant, grand total bill, and category...</p>
  </div>

  <!-- Form -->
  <form id="form-expense-logger" class="space-y-4">
    <!-- Item Description -->
    <div>
      <label for="input-item-name" class="block text-xs font-semibold text-slate-700 mb-1">
        Expense Description / Merchant
      </label>
      <input
        type="text"
        id="input-item-name"
        required
        placeholder="e.g. Trader Joe's Groceries"
        class="block w-full rounded-xl border border-slate-300 px-3.5 py-2 text-xs sm:text-sm text-slate-900 font-medium placeholder:text-slate-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all shadow-2xs"
      />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <!-- Amount -->
      <div>
        <label for="input-item-amount" class="block text-xs font-semibold text-slate-700 mb-1">
          Amount (<span class="currency-label font-mono">₹</span>)
        </label>
        <div class="relative rounded-xl shadow-2xs">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <span class="currency-label text-slate-400 font-medium text-xs">₹</span>
          </div>
          <input
            type="number"
            id="input-item-amount"
            min="0.01"
            step="0.01"
            required
            placeholder="0.00"
            class="block w-full rounded-xl border border-slate-300 pl-7 pr-3 py-2 text-xs sm:text-sm text-slate-900 font-bold font-mono placeholder:text-slate-400 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all"
          />
        </div>
      </div>

      <!-- Category -->
      <div>
        <label for="select-item-category" class="block text-xs font-semibold text-slate-700 mb-1">
          Category
        </label>
        <select
          id="select-item-category"
          class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-xs sm:text-sm text-slate-900 font-medium bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all shadow-2xs cursor-pointer"
        >
          <option value="Housing">🏠 Housing & Rent</option>
          <option value="Food" selected>🥗 Food & Groceries</option>
          <option value="Transport">🚗 Transport & Transit</option>
          <option value="Utilities">⚡ Utilities & Bills</option>
          <option value="Entertainment">🎟️ Entertainment & Fun</option>
          <option value="Savings">🏦 Savings & Investing</option>
          <option value="Miscellany">📦 Miscellany & General</option>
        </select>
      </div>
    </div>

    <!-- Quick Preset Chips -->
    <div>
      <span class="block text-[11px] font-semibold text-slate-500 mb-1.5 uppercase tracking-wider">
        Quick Presets
      </span>
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-preset-name="Monthly House Rent"
          data-preset-amount="15000"
          data-preset-category="Housing"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200 cursor-pointer"
        >
          🏠 Rent (₹15,000)
        </button>
        <button
          type="button"
          data-preset-name="Supermarket & Groceries"
          data-preset-amount="3500"
          data-preset-category="Food"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200 cursor-pointer"
        >
          🥗 Groceries (₹3,500)
        </button>
        <button
          type="button"
          data-preset-name="Electricity Bill"
          data-preset-amount="1800"
          data-preset-category="Utilities"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200 cursor-pointer"
        >
          ⚡ Electric (₹1,800)
        </button>
        <button
          type="button"
          data-preset-name="Petrol & Metro Travel"
          data-preset-amount="1200"
          data-preset-category="Transport"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200 cursor-pointer"
        >
          🚗 Fuel/Travel (₹1,200)
        </button>
        <button
          type="button"
          data-preset-name="Emergency Fund / SIP"
          data-preset-amount="5000"
          data-preset-category="Savings"
          class="btn-preset-chip px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 hover:bg-emerald-100 text-emerald-800 transition-colors border border-emerald-200 cursor-pointer"
        >
          🏦 Save / SIP (₹5,000)
        </button>
      </div>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      class="w-full py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add to Monthly Ledger
    </button>
  </form>
</div>
