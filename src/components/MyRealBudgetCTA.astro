---
/**
 * MyRealBudgetCTA.astro
 * Contextual cross-link CTA promoting My Real Budget — a complementary budgeting tool.
 * Placed once on the homepage between the SEO Content Section and FAQ Section.
 */
---

<div class="bg-white border border-slate-200 rounded-3xl p-5 sm:p-8 shadow-xs">
  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-8">
    <!-- Icon -->
    <div class="flex-shrink-0 w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>

    <!-- Content -->
    <div class="flex-1 space-y-2">
      <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif]">
        Want to take control of your budget?
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
        Already tracking your expenses? Start planning where your money should go with My Real Budget. Create a monthly budget, follow the 50/30/20 rule, and build better money habits.
      </p>
    </div>

    <!-- CTA Button -->
    <div class="flex-shrink-0 w-full sm:w-auto">
      <a
        href="https://myrealbudget.com/"
        target="_blank"
        rel="noopener"
        id="cta-my-real-budget"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] transition-all shadow-sm w-full sm:w-auto cursor-pointer"
      >
        Explore My Real Budget
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var ctaLink = document.getElementById('cta-my-real-budget');
    if (!ctaLink || ctaLink.dataset.gaBound) return;
    ctaLink.dataset.gaBound = 'true';
    ctaLink.addEventListener('click', function () {
      if (typeof gtag === 'function') {
        gtag('event', 'cross_site_cta_click', {
          destination: 'myrealbudget.com',
          source_page: window.location.pathname,
          cta_name: 'my_real_budget'
        });
      }
    });
  })();
</script>

