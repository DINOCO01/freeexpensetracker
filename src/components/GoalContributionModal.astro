---
---

<!-- Goal Contribution Entry Modal Backdrop -->
<div
  id="goal-contribution-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-contribution-title"
>
  <div class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 flex items-center justify-center font-bold text-sm border border-emerald-200 dark:border-emerald-800/60">
          💰
        </div>
        <div>
          <h3 id="modal-contribution-title" class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
            Record Contribution
          </h3>
          <p id="modal-contribution-subtitle" class="text-xs text-slate-500 dark:text-slate-400">
            Goal: <span id="modal-contrib-goal-name" class="font-semibold text-slate-700 dark:text-slate-300"></span>
          </p>
        </div>
      </div>
      <button
        type="button"
        id="btn-close-contribution-modal"
        class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1 rounded-lg transition-colors cursor-pointer"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Form -->
    <form id="form-goal-contribution" class="space-y-4">
      <input type="hidden" id="input-contrib-goal-id" />
      <input type="hidden" id="input-contrib-entry-id" />

      <!-- Date Field -->
      <div>
        <label for="input-contrib-date" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          Contribution Date
        </label>
        <input
          type="date"
          id="input-contrib-date"
          required
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:outline-none"
        />
        <p class="text-[10px] text-slate-500 dark:text-slate-400 mt-1">
          You can record multiple contributions in the same month. They will be automatically summed.
        </p>
      </div>

      <!-- Planned & Month Summary Info Box -->
      <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="text-slate-500 dark:text-slate-400">Planned Monthly Allocation:</span>
          <div class="flex items-center gap-1.5">
            <span id="display-contrib-planned" class="font-bold font-mono text-slate-900 dark:text-slate-100">₹0</span>
            <button
              type="button"
              id="btn-toggle-edit-plan"
              class="text-[11px] text-emerald-700 dark:text-emerald-400 hover:underline font-semibold cursor-pointer"
              title="Change future planned monthly allocation"
            >
              Edit
            </button>
          </div>
        </div>

        <!-- Inline Future Monthly Allocation Editor -->
        <div id="container-edit-plan" class="hidden pt-1 border-t border-slate-200 dark:border-slate-700 flex items-center gap-2">
          <input
            type="number"
            id="input-edit-plan-value"
            min="0"
            max="10000000"
            step="any"
            placeholder="New monthly plan"
            class="block w-full rounded-lg border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-2 py-1 text-xs font-mono font-bold"
          />
          <button
            type="button"
            id="btn-save-plan-value"
            class="px-3 py-1 text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-700 rounded-lg cursor-pointer shrink-0"
          >
            Update Plan
          </button>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span>Remaining to Goal:</span>
          <span id="display-contrib-remaining" class="font-mono text-slate-700 dark:text-slate-300">₹0</span>
        </div>

        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 border-t border-slate-200/60 dark:border-slate-800/80 pt-1.5">
          <span>Already Saved This Month:</span>
          <span id="display-contrib-month-actual" class="font-mono font-bold text-slate-900 dark:text-slate-100">₹0</span>
        </div>
      </div>

      <!-- Contribution Amount Field -->
      <div>
        <label for="input-contrib-actual" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          Contribution Amount (<span class="currency-label font-mono">₹</span>)
        </label>
        <input
          type="number"
          id="input-contrib-actual"
          required
          min="1"
          step="any"
          placeholder="e.g. 5000"
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs font-bold font-mono text-slate-900 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-600 focus:outline-none"
        />
      </div>

      <!-- Informational Difference Feedback -->
      <div id="contrib-diff-feedback" class="text-xs p-2.5 rounded-xl hidden transition-all"></div>

      <!-- Error Message -->
      <div id="contrib-error-msg" class="text-xs p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60 hidden"></div>

      <!-- Modal Actions -->
      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
        <button
          type="button"
          id="btn-cancel-contribution"
          class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="btn-submit-contribution"
          class="px-5 py-2 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-700 transition-colors cursor-pointer shadow-xs disabled:opacity-50"
        >
          Add Contribution
        </button>
      </div>
    </form>
  </div>
</div>
