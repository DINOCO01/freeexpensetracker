---
import { t, type SupportedLocale } from '../locales';

export interface FAQItem {
  question: string;
  answer: string;
  category: string;
}

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;

export const getFaqData = (loc: SupportedLocale = 'en'): FAQItem[] => [
  {
    question: t('faq.q1', loc),
    answer: t('faq.a1', loc),
    category: t('faq.catGeneralPricing', loc)
  },
  {
    question: t('faq.q2', loc),
    answer: t('faq.a2', loc),
    category: t('faq.catTemplatesSheets', loc)
  },
  {
    question: t('faq.q3', loc),
    answer: t('faq.a3', loc),
    category: t('faq.catHowToDIY', loc)
  },
  {
    question: t('faq.q4', loc),
    answer: t('faq.a4', loc),
    category: t('faq.catPrivacySecurity', loc)
  },
  {
    question: t('faq.q5', loc),
    answer: t('faq.a5', loc),
    category: t('faq.catHowToDIY', loc)
  },
  {
    question: t('faq.q6', loc),
    answer: t('faq.a6', loc),
    category: t('faq.catGeneralExamples', loc)
  },
  {
    question: t('faq.q7', loc),
    answer: t('faq.a7', loc),
    category: t('faq.catFinancialStrategy', loc)
  },
  {
    question: t('faq.q8', loc),
    answer: t('faq.a8', loc),
    category: t('faq.catAppComparison', loc)
  }
];

export const FAQ_DATA = getFaqData('en');
const currentFaqData = getFaqData(locale);

// Generate JSON-LD schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": currentFaqData.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq-section" class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-8 md:p-10 shadow-xs space-y-6 sm:space-y-8">
  <!-- FAQ Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-100 pb-5 sm:pb-6">
    <div class="space-y-1.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
        <span>❓</span>
        <span>{t('faq.badge', locale)}</span>
      </div>
      <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight font-['Outfit',sans-serif]">
        {t('faq.title', locale)}
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-2xl">
        {t('faq.subtitle', locale)}
      </p>
    </div>

    <!-- Live Filter Input -->
    <div class="w-full md:w-72 relative">
      <input
        type="text"
        id="faq-search-input"
        placeholder={t('faq.filterPlaceholder', locale)}
        class="w-full text-xs rounded-xl border border-slate-200 pl-8 pr-3 py-2 text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-500 shadow-2xs"
      />
      <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- FAQ Accordion List -->
  <div id="faq-items-container" class="space-y-3">
    {currentFaqData.map((item, index) => (
      <details
        class="faq-item group border border-slate-200 hover:border-emerald-300 rounded-2xl p-3.5 sm:p-5 transition-all bg-white hover:bg-emerald-50/20 open:bg-slate-50/50 open:border-emerald-400 shadow-2xs"
        data-question={item.question.toLowerCase()}
        data-answer={item.answer.toLowerCase()}
      >
        <summary class="flex items-start sm:items-center justify-between gap-3 font-bold text-slate-900 cursor-pointer list-none select-none text-xs sm:text-base font-['Outfit',sans-serif]">
          <span class="flex items-start sm:items-center gap-2.5 sm:gap-3">
            <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5 sm:mt-0">
              Q{index + 1}
            </span>
            <span class="group-hover:text-emerald-900 transition-colors">
              {item.question}
            </span>
          </span>
          <span class="w-6 h-6 rounded-full bg-slate-100 group-hover:bg-emerald-100 text-slate-500 group-hover:text-emerald-800 flex items-center justify-center shrink-0 transition-transform group-open:rotate-180 mt-0.5 sm:mt-0">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-3.5 pt-3.5 border-t border-slate-200/80 text-xs sm:text-sm text-slate-600 leading-relaxed space-y-2">
          <p>{item.answer}</p>
          <div class="flex items-center gap-2 pt-1 text-[11px] text-slate-400 font-mono">
            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">{t('faq.topicLabel', locale)}: {item.category}</span>
            <span>•</span>
            <span class="text-emerald-700 font-medium">{t('faq.verifiedLabel', locale)}</span>
          </div>
        </div>
      </details>
    ))}
  </div>

  <!-- Empty Search Results -->
  <div id="faq-empty-state" class="hidden p-8 text-center bg-slate-50 border border-slate-200 rounded-2xl space-y-2">
    <div class="text-2xl">🔍</div>
    <div class="text-sm font-bold text-slate-800">{t('faq.noMatches', locale)}</div>
    <p class="text-xs text-slate-500">{t('faq.noMatchesHint', locale)}</p>
  </div>

  <!-- Structured Data JSON-LD for Google Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<script>
  const faqSearchInput = document.getElementById('faq-search-input') as HTMLInputElement;
  const faqItems = document.querySelectorAll('.faq-item');
  const faqEmptyState = document.getElementById('faq-empty-state');

  faqSearchInput?.addEventListener('input', () => {
    const query = faqSearchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    faqItems.forEach((el) => {
      const q = el.getAttribute('data-question') || '';
      const a = el.getAttribute('data-answer') || '';

      if (!query || q.includes(query) || a.includes(query)) {
        el.classList.remove('hidden');
        visibleCount++;
        if (query) {
          (el as HTMLDetailsElement).open = true;
        }
      } else {
        el.classList.add('hidden');
        (el as HTMLDetailsElement).open = false;
      }
    });

    if (faqEmptyState) {
      if (visibleCount === 0) {
        faqEmptyState.classList.remove('hidden');
      } else {
        faqEmptyState.classList.add('hidden');
      }
    }
  });
</script>
