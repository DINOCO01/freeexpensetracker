---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<footer class="no-print border-t border-slate-200 bg-white mt-12 py-10 text-slate-500 text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Mission -->
      <div class="space-y-3 md:col-span-2">
        <div class="flex items-center gap-2.5">
          <svg class="w-8 h-8 rounded-xl shadow-xs shrink-0" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="600" height="600" rx="73" fill="#000000"/>
            <g transform="translate(120.5, 120.5) scale(14.958333)" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
              <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
              <path d="M12 18V6"/>
            </g>
          </svg>
          <span class="font-bold text-base text-slate-900 font-['Outfit',sans-serif]">
            Free Expense Tracker
          </span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed max-w-md">
          {t('footer.about', locale)}
        </p>
        <div class="text-[11px] text-slate-400">
          {t('footer.domainNote', locale)}
        </div>
      </div>

      <!-- Col 2: Core Tools & Workflows -->
      <div class="space-y-2.5">
        <div class="font-bold text-slate-900 uppercase text-[11px] tracking-wider font-['Outfit',sans-serif]">
          {t('footer.headingTools', locale)}
        </div>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li>
            <a href="#tab-view-tracker" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkTracker', locale)}
            </a>
          </li>
          <li>
            <a href="#tab-view-templates" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkSheets', locale)}
            </a>
          </li>
          <li>
            <a href="#tab-view-templates" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkExcel', locale)}
            </a>
          </li>
          <li>
            <a href="#tab-view-debt" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkDebt', locale)}
            </a>
          </li>
          <li>
            <a href="#tab-view-targets" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkBudget', locale)}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources & Guides -->
      <div class="space-y-2.5">
        <div class="font-bold text-slate-900 uppercase text-[11px] tracking-wider font-['Outfit',sans-serif]">
          {t('footer.headingResources', locale)}
        </div>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li>
            <a href="#tab-view-knowledge" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkKnowledge', locale)}
            </a>
          </li>
          <li>
            <a href="/templates/" class="hover:text-emerald-700 transition-colors">
              Spreadsheet Templates (.xlsx)
            </a>
          </li>
          <li>
            <a href="#tab-view-templates" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkPdf', locale)}
            </a>
          </li>
          <li>
            <a href="#tab-view-import" class="hover:text-emerald-700 transition-colors">
              {t('importer.title', locale)}
            </a>
          </li>
          <li>
            <a href="#section-faq" class="hover:text-emerald-700 transition-colors">
              {t('faq.title', locale)}
            </a>
          </li>
          <li>
            <a href="#section-seo-guide" class="hover:text-emerald-700 transition-colors">
              {t('seoGuide.title', locale)}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Company & Legal -->
      <div class="space-y-2.5">
        <div class="font-bold text-slate-900 uppercase text-[11px] tracking-wider font-['Outfit',sans-serif]">
          {t('footer.headingLegal', locale)}
        </div>
        <ul class="space-y-1.5 text-xs text-slate-600">
          <li>
            <a href="/about-us/" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkAbout', locale)}
            </a>
          </li>
          <li>
            <a href="/privacy-policy/" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkPrivacy', locale)}
            </a>
          </li>
          <li>
            <a href="/terms-and-conditions/" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkTerms', locale)}
            </a>
          </li>
          <li>
            <a href="/contact-us/" class="hover:text-emerald-700 transition-colors">
              {t('footer.linkContact', locale)}
            </a>
          </li>
          <li>
            <span class="text-emerald-700 font-medium">{t('footer.clientSidePrivacy', locale)}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar: Links, Keywords & Copyright -->
    <div class="border-t border-slate-100 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-slate-400">
      <div>
        © 2026 {t('footer.copyright', locale)}
      </div>
      <div class="flex items-center gap-3 flex-wrap justify-center text-slate-500">
        <a href="/about-us/" class="hover:text-emerald-700 transition-colors">{t('footer.linkAbout', locale)}</a>
        <span>•</span>
        <a href="/privacy-policy/" class="hover:text-emerald-700 transition-colors">{t('footer.linkPrivacy', locale)}</a>
        <span>•</span>
        <a href="/terms-and-conditions/" class="hover:text-emerald-700 transition-colors">{t('footer.linkTerms', locale)}</a>
        <span>•</span>
        <a href="/contact-us/" class="hover:text-emerald-700 transition-colors">{t('footer.linkContact', locale)}</a>
      </div>
    </div>
  </div>
</footer>
