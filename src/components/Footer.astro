<footer class="no-print border-t border-slate-200 bg-white mt-12 py-10 text-slate-500 text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Mission -->
      <div class="space-y-3 md:col-span-2">
        <div class="flex items-center gap-2.5">
          <svg class="w-8 h-8 rounded-xl shadow-xs shrink-0" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="600" height="600" rx="73" fill="#000000"/>
            <g transform="translate(120.5, 120.5) scale(14.958333)" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
