---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<section class="space-y-6">
  <!-- Headline & Value Proposition -->
  <div class="text-center max-w-3xl mx-auto space-y-3 pt-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
      <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
      {t('hero.badge', locale)}
    </div>

    <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-tight">
      {t('hero.title1', locale)} <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-600 bg-clip-text text-transparent">
        {t('hero.title2', locale)}
      </span>
    </h1>

    <p class="text-xs sm:text-base text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed px-1">
      {t('hero.description', locale)}
    </p>
  </div>
</section>
