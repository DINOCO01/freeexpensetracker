---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const isEn = locale === 'en';
---

<section class="space-y-3 sm:space-y-4">
  <!-- Headline & Value Proposition -->
  <div class="text-center max-w-2xl mx-auto space-y-2 sm:space-y-3 pt-1 sm:pt-2">
    <!-- Compact Badge -->
    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-2xs">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse shrink-0"></span>
      <span>{isEn ? '100% Free • No Sign-Up • Private Browser Storage' : t('hero.badge', locale)}</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-2xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-tight">
      {locale === 'en' ? (
        <span>Free Expense Tracker</span>
      ) : locale === 'fr' ? (
        <span>{t('hero.h1', locale)}</span>
      ) : (
        <>
          {t('hero.title1', locale)} <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-teal-600 bg-clip-text text-transparent">
            {t('hero.title2', locale)}
          </span>
        </>
      )}
    </h1>

    <!-- Shorter supporting line -->
    <p class="text-xs sm:text-base text-slate-600 dark:text-slate-400 max-w-lg mx-auto leading-relaxed px-2">
      {isEn ? 'Take control of your money with our free monthly expense tracker: monitor income and spending, plan budgets, and download free financial templates.' : t('hero.description', locale)}
    </p>
  </div>
</section>

