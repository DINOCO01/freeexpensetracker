---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<div class="space-y-6">
  <!-- Knowledge Header -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-3">
    <div class="flex items-center gap-2">
      <h2 class="text-lg font-bold text-slate-900 font-['Outfit',sans-serif]">
        🏛️ {t('knowledge.title', locale)}
      </h2>
      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 uppercase tracking-wider">
        {t('knowledge.badge', locale)}
      </span>
    </div>
    <p class="text-xs text-slate-600 leading-relaxed max-w-3xl">
      {t('knowledge.subtitle', locale)}
    </p>

    <!-- Four Pillars Road Map Banner -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 pt-2">
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-800">
          <span>💧</span> Pillar 1
        </div>
        <div class="text-xs font-bold text-slate-900">{t('knowledge.p1Title', locale)}</div>
        <p class="text-[11px] text-slate-500">{t('knowledge.p1Sub', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <div class="flex items-center gap-1.5 text-xs font-bold text-sky-800">
          <span>🛡️</span> Pillar 2
        </div>
        <div class="text-xs font-bold text-slate-900">{t('knowledge.p2Title', locale)}</div>
        <p class="text-[11px] text-slate-500">{t('knowledge.p2Sub', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <div class="flex items-center gap-1.5 text-xs font-bold text-indigo-800">
          <span>📈</span> Pillar 3
        </div>
        <div class="text-xs font-bold text-slate-900">{t('knowledge.p3Title', locale)}</div>
        <p class="text-[11px] text-slate-500">{t('knowledge.p3Sub', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <div class="flex items-center gap-1.5 text-xs font-bold text-teal-800">
          <span>🏰</span> Pillar 4
        </div>
        <div class="text-xs font-bold text-slate-900">{t('knowledge.p4Title', locale)}</div>
        <p class="text-[11px] text-slate-500">{t('knowledge.p4Sub', locale)}</p>
      </div>
    </div>
  </div>

  <!-- The Four Pillars Detailed Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {/* PILLAR 1: Cash Flow & Mindful Budgeting */}
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4 hover:border-slate-300 transition-colors">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center font-bold text-xl border border-emerald-100">
            💧
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700">{t('knowledge.p1Tag', locale)}</span>
            <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
              {t('knowledge.p1Heading', locale)}
            </h3>
          </div>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700">{t('knowledge.p1Badge', locale)}</span>
      </div>

      <p class="text-xs text-slate-600 leading-relaxed">
        {t('knowledge.p1Lead', locale)}
      </p>

      <div class="space-y-2.5 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p1_1Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p1_1Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p1_2Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p1_2Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p1_3Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p1_3Desc', locale)}
          </p>
        </div>
      </div>
    </div>

    {/* PILLAR 2: Debt Optimization & Risk Protection */}
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4 hover:border-slate-300 transition-colors">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-800 flex items-center justify-center font-bold text-xl border border-sky-100">
            🛡️
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-sky-700">{t('knowledge.p2Tag', locale)}</span>
            <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
              {t('knowledge.p2Heading', locale)}
            </h3>
          </div>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700">{t('knowledge.p2Badge', locale)}</span>
      </div>

      <p class="text-xs text-slate-600 leading-relaxed">
        {t('knowledge.p2Lead', locale)}
      </p>

      <div class="space-y-2.5 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p2_1Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p2_1Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p2_2Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p2_2Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p2_3Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p2_3Desc', locale)}
          </p>
        </div>
      </div>
    </div>

    {/* PILLAR 3: Disciplined Wealth Accumulation */}
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4 hover:border-slate-300 transition-colors">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-800 flex items-center justify-center font-bold text-xl border border-indigo-100">
            📈
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700">{t('knowledge.p3Tag', locale)}</span>
            <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
              {t('knowledge.p3Heading', locale)}
            </h3>
          </div>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700">{t('knowledge.p3Badge', locale)}</span>
      </div>

      <p class="text-xs text-slate-600 leading-relaxed">
        {t('knowledge.p3Lead', locale)}
      </p>

      <div class="space-y-2.5 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p3_1Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p3_1Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p3_2Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p3_2Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p3_3Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p3_3Desc', locale)}
          </p>
        </div>
      </div>
    </div>

    {/* PILLAR 4: Long-Term Preservation & Autonomy */}
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4 hover:border-slate-300 transition-colors">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-800 flex items-center justify-center font-bold text-xl border border-teal-100">
            🏰
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700">{t('knowledge.p4Tag', locale)}</span>
            <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
              {t('knowledge.p4Heading', locale)}
            </h3>
          </div>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700">{t('knowledge.p4Badge', locale)}</span>
      </div>

      <p class="text-xs text-slate-600 leading-relaxed">
        {t('knowledge.p4Lead', locale)}
      </p>

      <div class="space-y-2.5 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p4_1Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p4_1Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p4_2Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p4_2Desc', locale)}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
          <strong class="text-slate-900 block font-semibold">{t('knowledge.p4_3Title', locale)}</strong>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            {t('knowledge.p4_3Desc', locale)}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Essential Financial Glossary & Benchmarks -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
    <div class="border-b border-slate-100 pb-3">
      <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
        {t('knowledge.glossaryTitle', locale)}
      </h3>
      <p class="text-xs text-slate-600 mt-0.5">
        {t('knowledge.glossarySubtitle', locale)}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g1Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g1Def', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g2Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g2Def', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g3Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g3Def', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g4Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g4Def', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g5Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g5Def', locale)}</p>
      </div>

      <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 space-y-1">
        <span class="font-bold text-slate-900">{t('knowledge.g6Term', locale)}</span>
        <p class="text-slate-600">{t('knowledge.g6Def', locale)}</p>
      </div>
    </div>
  </div>
</div>
