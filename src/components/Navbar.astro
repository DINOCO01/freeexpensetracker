---
---

<header class="no-print sticky top-0 z-40 w-full backdrop-blur-md bg-white/95 border-b border-slate-200 transition-colors shadow-xs">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group shrink-0" aria-label="Free Expense Tracker Home">
      <svg class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl shadow-xs group-hover:scale-105 transition-transform shrink-0" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="600" height="600" rx="73" fill="#000000"/>
        <g transform="translate(120.5, 120.5) scale(14.958333)" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
          <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
          <path d="M12 18V6"/>
        </g>
      </svg>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm sm:text-base tracking-tight text-slate-900 font-['Outfit',sans-serif] whitespace-nowrap">
            Free Expense Tracker
          </span>
          <span class="hidden md:inline-block px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
            No Login • 100% Private
          </span>
        </div>
        <p class="text-[11px] text-slate-500 hidden sm:block">
          freexpensetracker.com • Live Web Expense Tracker, Debt Planner & Financial Knowledge
        </p>
      </div>
    </a>

    <!-- Top Controls: Currency, Import Statement & Reset -->
    <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
      <!-- Currency Dropdown -->
      <div class="relative">
        <label for="currency-selector" class="sr-only">Currency</label>
        <select
          id="currency-selector"
          class="text-xs font-semibold bg-white hover:bg-slate-50 border border-slate-300 rounded-lg px-1.5 sm:px-2.5 py-1.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer shadow-2xs transition-colors max-w-[68px] sm:max-w-none"
        >
          <option value="USD">USD ($)</option>
          <option value="EUR">EUR (€)</option>
          <option value="GBP">GBP (£)</option>
          <option value="CAD">CAD (CA$)</option>
          <option value="AUD">AUD (AU$)</option>
          <option value="INR">INR (₹)</option>
          <option value="JPY">JPY (¥)</option>
          <option value="CHF">CHF (CHF)</option>
          <option value="CNY">CNY (¥)</option>
          <option value="SGD">SGD (S$)</option>
          <option value="NZD">NZD (NZ$)</option>
          <option value="AED">AED (AED)</option>
          <option value="SAR">SAR (SAR)</option>
          <option value="BRL">BRL (R$)</option>
          <option value="MXN">MXN (Mex$)</option>
          <option value="ZAR">ZAR (R)</option>
          <option value="SEK">SEK (kr)</option>
          <option value="KRW">KRW (₩)</option>
          <option value="PHP">PHP (₱)</option>
          <option value="MYR">MYR (RM)</option>
          <option value="IDR">IDR (Rp)</option>
          <option value="TRY">TRY (₺)</option>
          <option value="PKR">PKR (Rs)</option>
          <option value="BDT">BDT (৳)</option>
          <option value="NGN">NGN (₦)</option>
        </select>
      </div>

      <!-- Import Statement Tab (Separate, placed on left of Reset button) -->
      <button
        type="button"
        id="btn-open-file-importer-nav"
        data-tab="import"
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-all shadow-2xs cursor-pointer"
        title="Import Statements & Receipts (All image formats & PDFs supported)"
      >
        <span class="text-xs">📥</span>
        <span>Import<span class="hidden sm:inline"> Statement</span></span>
        <span class="hidden md:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
          Multi
        </span>
      </button>

      <!-- Clear / Reset Data Button -->
      <button
        id="btn-open-reset-modal"
        class="text-xs font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200 px-2 sm:px-3 py-1.5 rounded-lg transition-colors cursor-pointer shadow-2xs"
        title="Reset All Data"
      >
        Reset
      </button>
    </div>
  </div>
</header>
