---
import { SUPPORTED_LOCALES, type SupportedLocale, DEFAULT_LOCALE, t } from '../locales';

interface Props {
  currentLocale?: SupportedLocale;
}

const { currentLocale = DEFAULT_LOCALE } = Astro.props;
const currentInfo = SUPPORTED_LOCALES[currentLocale] || SUPPORTED_LOCALES.en;
const homeUrl = currentLocale === DEFAULT_LOCALE ? '/' : `/${currentLocale}/`;
---

<header class="no-print sticky top-0 z-40 w-full backdrop-blur-md bg-white/95 dark:bg-[#090D16]/95 border-b border-slate-200 dark:border-slate-800 transition-colors shadow-xs">
  <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2 sm:gap-3 group shrink-0" aria-label="Free Expense Tracker Home">
      <svg class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl shadow-xs group-hover:scale-105 transition-transform shrink-0" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="600" height="600" rx="73" fill="#000000"/>
        <g transform="translate(120.5, 120.5) scale(14.958333)" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
          <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/>
          <path d="M12 18V6"/>
        </g>
      </svg>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-sm sm:text-base tracking-tight text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] whitespace-nowrap">
            {t('nav.brand', currentLocale)}
          </span>
          <span class="hidden md:inline-block px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
            {t('nav.tagline', currentLocale)}
          </span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block">
          {t('nav.subtagline', currentLocale)}
        </p>
      </div>
    </a>

    <!-- Top Controls: Language Selector, Theme Toggle & Import Statement -->
    <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
      <!-- Language Selector Dropdown -->
      <div class="relative" id="lang-selector-dropdown-wrapper">
        <button
          type="button"
          id="btn-lang-selector"
          class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-all shadow-2xs cursor-pointer"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t('nav.selectLanguage', currentLocale)}
          title={t('nav.selectLanguage', currentLocale)}
        >
          <span class="text-xs">🌐</span>
          <span class="hidden sm:inline text-[11px] sm:text-xs font-medium">{currentInfo.name}</span>
          <span class="sm:hidden text-[10px] font-mono font-bold uppercase">{currentInfo.code}</span>
          <svg class="w-3 h-3 text-slate-400 dark:text-slate-500 transition-transform duration-200" id="lang-dropdown-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute right-0 mt-1.5 w-48 sm:w-52 py-1 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-lg z-50 text-xs transition-all"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="btn-lang-selector"
        >
          {Object.values(SUPPORTED_LOCALES).map((loc) => {
            const isSelected = loc.code === currentLocale;
            const targetUrl = loc.code === DEFAULT_LOCALE ? '/' : `/${loc.code}/`;
            return (
              <a
                href={targetUrl}
                data-lang={loc.code}
                role="menuitem"
                class={`lang-menu-item flex items-center justify-between px-3 py-2 text-xs transition-colors cursor-pointer ${
                  isSelected
                    ? 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 font-bold'
                    : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium'
                }`}
              >
                <div class="flex items-center gap-2 truncate">
                  <span class="shrink-0">{loc.flag}</span>
                  <span class="truncate font-semibold">{loc.name}</span>
                  <span class="text-[10px] text-slate-400 dark:text-slate-500 font-normal shrink-0">({loc.englishName})</span>
                </div>
                {isSelected && (
                  <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Dark / Light Theme Toggle Button -->
      <button
        type="button"
        id="btn-theme-toggle"
        class="inline-flex items-center gap-1.5 px-2 sm:px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-all shadow-2xs cursor-pointer"
        title={t('nav.themeToggleTitle', currentLocale)}
        aria-label={t('nav.themeToggleAria', currentLocale)}
      >
        <!-- Moon Icon (Visible in Light Mode) -->
        <svg class="w-3.5 h-3.5 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <!-- Sun Icon (Visible in Dark Mode) -->
        <svg class="w-3.5 h-3.5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <span class="hidden sm:inline dark:hidden text-[11px] sm:text-xs">{t('nav.themeDark', currentLocale)}</span>
        <span class="hidden sm:dark:inline text-[11px] sm:text-xs text-amber-300">{t('nav.themeLight', currentLocale)}</span>
      </button>

      <!-- Import Statement Tab -->
      <button
        type="button"
        id="btn-open-file-importer-nav"
        data-tab="import"
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/60 dark:hover:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 transition-all shadow-2xs cursor-pointer"
        title="Import Statements & Receipts (All image formats & PDFs supported)"
      >
        <span class="text-xs">📥</span>
        <span class="hidden sm:inline">{t('nav.importStatement', currentLocale)}</span>
        <span class="sm:hidden">{t('buttons.import', currentLocale)}</span>
        <span class="hidden md:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-100 dark:bg-emerald-900/80 text-emerald-800 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700">
          {t('nav.multi', currentLocale)}
        </span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function initLanguageSelector() {
    function setupLangDropdown() {
      const btn = document.getElementById('btn-lang-selector');
      const menu = document.getElementById('lang-dropdown-menu');
      const arrow = document.getElementById('lang-dropdown-arrow');
      if (!btn || !menu || btn.dataset.boundLang) return;
      btn.dataset.boundLang = 'true';

      function toggleMenu(show) {
        const isHidden = menu.classList.contains('hidden');
        const shouldShow = typeof show === 'boolean' ? show : isHidden;
        if (shouldShow) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (arrow) arrow.style.transform = 'rotate(180deg)';
        } else {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
      }

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
          toggleMenu(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          toggleMenu(false);
          btn.focus();
        }
      });

      // Handle item click for persistence
      const items = menu.querySelectorAll('.lang-menu-item');
      items.forEach((item) => {
        item.addEventListener('click', (e) => {
          const lang = item.getAttribute('data-lang');
          if (lang) {
            try {
              localStorage.setItem('user_language', lang);
            } catch (_) {}
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLangDropdown);
    } else {
      setupLangDropdown();
    }
  })();
</script>
