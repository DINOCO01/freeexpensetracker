    const principal = parseFloat(inputDebtPaymentPrincipal?.value || '0') || 0;
    // Auto-calculate interest paid as totalPayment - principalPaid
    if (total >= principal && inputDebtPaymentInterest) {
      inputDebtPaymentInterest.value = Math.max(0, total - principal).toString();
    }
    updateDebtPaymentLiveFeedback();
  });

  inputDebtPaymentPrincipal?.addEventListener('input', () => {
