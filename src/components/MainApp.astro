---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TrackingChoiceHero from '../components/TrackingChoiceHero.astro';
import TabNav from '../components/TabNav.astro';
import HeroSummary from '../components/HeroSummary.astro';
import FinancialHealthCard from '../components/FinancialHealthCard.astro';
import SmartSuggestions from '../components/SmartSuggestions.astro';
import ExpenseLogger from '../components/ExpenseLogger.astro';
import TransactionLedger from '../components/TransactionLedger.astro';
import DebtManagement from '../components/DebtManagement.astro';
import BudgetPlanning from '../components/BudgetPlanning.astro';
import FinancialKnowledge from '../components/FinancialKnowledge.astro';
import BlogHub from '../components/BlogHub.astro';
import CompetitiveEdge from '../components/CompetitiveEdge.astro';
import StatementImporterTab from '../components/StatementImporterTab.astro';
import SpreadsheetsAndPrintable from '../components/SpreadsheetsAndPrintable.astro';
import SEOContentSection from '../components/SEOContentSection.astro';
import FAQSection from '../components/FAQSection.astro';
import MyRealBudgetCTA from '../components/MyRealBudgetCTA.astro';
import Footer from '../components/Footer.astro';
import FileImportModal from '../components/FileImportModal.astro';
import ResetModal from '../components/ResetModal.astro';
import GoalContributionModal from '../components/GoalContributionModal.astro';
import DebtPaymentModal from '../components/DebtPaymentModal.astro';
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<Layout
  currentLocale={locale}
  title={t('meta.title', locale)}
  description={t('meta.description', locale)}
  keywords={t('meta.keywords', locale)}
>
  <Navbar currentLocale={locale} />

  <main class="max-w-6xl mx-auto px-3 sm:px-6 py-5 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Hero Header & Value Proposition -->
    <TrackingChoiceHero locale={locale} />

    <!-- Navigation Tab Bar -->
    <TabNav locale={locale} />

    <!-- TAB 1: Live Expense Tracker & Smart Suggestions -->
    <section id="tab-view-tracker" class="tab-view space-y-6">
      <div id="live-tool-anchor" class="scroll-mt-24"></div>

      <!-- Parallel Top: Income Tracker & Financial Health Indicator Side-by-Side -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
        <HeroSummary locale={locale} />
        <FinancialHealthCard locale={locale} />
      </div>

      <!-- Quick Expense Logger & Transaction Ledger Below Tracker -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div class="lg:col-span-5">
          <ExpenseLogger locale={locale} />
        </div>
        <div class="lg:col-span-7">
          <TransactionLedger locale={locale} />
        </div>
      </div>

      <!-- Smart Spending Suggestions & Alternatives in Last -->
      <SmartSuggestions locale={locale} />
    </section>

    <!-- TAB 2: Free Templates (Google Sheets, Excel & Printables) -->
    <section id="tab-view-templates" class="tab-view space-y-6 hidden">
      <SpreadsheetsAndPrintable locale={locale} />
    </section>

    <!-- TAB 3: Universal Statement & Receipt Importer (Multi-file & Multi-format) -->
    <section id="tab-view-import" class="tab-view space-y-6 hidden">
      <StatementImporterTab locale={locale} />
    </section>

    <!-- TAB 4: Debt Management & Payoff Planner -->
    <section id="tab-view-debt" class="tab-view space-y-8 hidden">
      <DebtManagement locale={locale} />
    </section>

    <!-- TAB 3: Target & Budget Goal Planning -->
    <section id="tab-view-targets" class="tab-view space-y-8 hidden">
      <BudgetPlanning locale={locale} />
    </section>

    <!-- Combined TAB: Financial Knowledge & Educational Blogs -->
    <section id="tab-view-knowledge" class="tab-view space-y-8 hidden">
      <BlogHub locale={locale} />
      <FinancialKnowledge locale={locale} />
      <CompetitiveEdge locale={locale} />
    </section>

    <!-- Comprehensive On-Page SEO Educational & Explanatory Guide (800-1200 words) -->
    <section id="section-seo-guide" class="pt-6">
      <SEOContentSection locale={locale} />
    </section>

    <!-- Contextual Cross-Link: My Real Budget -->
    <section id="section-budget-cta" class="pt-2">
      <MyRealBudgetCTA />
    </section>

    <!-- SEO-Friendly Interactive FAQ Section with JSON-LD Schema -->
    <section id="section-faq" class="pt-2">
      <FAQSection locale={locale} />
    </section>
  </main>

  <!-- Global SEO Footer -->
  <Footer locale={locale} />

  <!-- Reusable Contextual Feedback Widget (hidden until a tool action completes) -->
  <div id="contextual-feedback" class="hidden mt-6 pt-4 border-t border-slate-200/80 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
    <div id="feedback-prompt-container" class="flex flex-col sm:flex-row items-center justify-between w-full gap-3">
      <span class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">{t('feedback.helpful', locale)}</span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-feedback-yes"
          class="px-4 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-emerald-950/60 hover:text-emerald-700 dark:hover:text-emerald-300 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 transition-all cursor-pointer shadow-2xs active:scale-95 flex items-center gap-1.5"
        >
          <span>👍</span> {t('feedback.yes', locale)}
        </button>
        <a
          href="/contact-us/"
          id="btn-feedback-no"
          class="px-4 py-1.5 rounded-xl border border-slate-300 dark:border-slate-700 hover:border-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/60 hover:text-rose-700 dark:hover:text-rose-300 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 transition-all cursor-pointer shadow-2xs active:scale-95 flex items-center gap-1.5"
        >
          <span>👎</span> {t('feedback.no', locale)}
        </a>
      </div>
    </div>
    <div id="feedback-confirmation" class="hidden w-full text-center sm:text-left py-2 px-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs sm:text-sm font-semibold">
      {t('feedback.thanks', locale)}
    </div>
  </div>

  <!-- Modals -->
  <FileImportModal locale={locale} />
  <ResetModal locale={locale} />
  <GoalContributionModal locale={locale} />
  <DebtPaymentModal locale={locale} />
</Layout>

<script>
  import {
    t,
    getLocalizedCategory,
    getLocale,
    type SupportedLocale
  } from '../locales';

  const activeLocale: SupportedLocale = typeof document !== 'undefined'
    ? getLocale(document.documentElement.dataset.locale)
    : 'en';

  import {
    SUPPORTED_CURRENCIES,
    formatCurrency,
    normalizeToMonthly,
    calculateFinancialHealthScore,
    calculateSavingsMetrics,
    CATEGORY_TYPES,
    CATEGORY_ICONS,
    type Frequency,
    type BudgetModel,
    type Transaction,
    type ExpenseCategory
  } from '../utils/calculations';

  import {
    loadStoredState,
    saveStoredState,
    clearAllStoredData,
    exportTransactionsToCSV,
    exportBudgetToExcel,
    type AppState
  } from '../utils/storage';

  import {
    parseAndInterpretFile,
    parseAndInterpretMultipleFiles,
    buildFileInterpretationInsights,
    buildMultiFileInsights,
    type FileInterpretationResult,
    type MultiFileInterpretationResult
  } from '../utils/fileImporter';

  import {
    generateExcelTemplate,
    openPrintableDocument
  } from '../utils/templateDownloader';

  // --- 1. State Interfaces & Initial Load ---
  export interface DebtPaymentRecord {
    id: string;
    date: string; // "YYYY-MM-DD"
    month?: string; // "YYYY-MM"
    totalPayment: number;
    principalPaid: number;
    interestPaid: number;
    extraPrepayment: number;
    notes?: string;
  }

  export interface DebtItem {
    id: string;
    name: string;
    debtName?: string;
    originalPrincipal: number;
    currentOutstandingPrincipal: number;
    balance: number; // Synchronized with currentOutstandingPrincipal for backwards compatibility
    interestRate: number;
    rate: number; // Synchronized with interestRate
    monthlyEMI: number;
    minimum: number; // Synchronized with monthlyEMI
    paymentHistory?: DebtPaymentRecord[];
    active?: boolean;
    paidOff?: boolean;
  }

  export interface GoalContribution {
    id?: string;
    date?: string; // "YYYY-MM-DD"
    month: string; // "YYYY-MM"
    planned?: number;
    actual: number;
  }

  export interface GoalItem {
    id: string;
    name: string;
    target: number;
    current: number;
    initialAmount?: number;
    monthly: number;
    contributions?: GoalContribution[];
  }

  let state: AppState = loadStoredState();
  let pendingImportResult: FileInterpretationResult | null = null;
  let pendingTabImportResult: MultiFileInterpretationResult | null = null;

  // Debts State (Empty by default; no demo debts)
  const DEBT_STORAGE_KEY = 'fet_debts_v4';
  let debts: DebtItem[] = [];
  try {
    const rawDebts = localStorage.getItem(DEBT_STORAGE_KEY);
    if (rawDebts) {
      const parsed = JSON.parse(rawDebts);
      debts = Array.isArray(parsed)
        ? parsed
            .filter((d: any) => !['debt-1', 'debt-2', 'debt-3'].includes(d.id))
            .map((d: any) => {
              const orig = Number(d.originalPrincipal ?? d.balance ?? 0);
              const curr = Number(d.currentOutstandingPrincipal ?? d.balance ?? orig);
              const rateVal = Number(d.interestRate ?? d.rate ?? 0);
              const emiVal = Number(d.monthlyEMI ?? d.minimum ?? 0);
              const nameStr = String(d.name || d.debtName || 'Loan Account');
              const rawHistory = Array.isArray(d.paymentHistory) ? d.paymentHistory : [];
              const paymentHistory: DebtPaymentRecord[] = rawHistory.map((p: any, idx: number) => ({
                id: p.id || `pay-${d.id}-${idx}-${p.date || 'unknown'}`,
                date: p.date || new Date().toISOString().slice(0, 10),
                month: p.month || (p.date ? p.date.slice(0, 7) : new Date().toISOString().slice(0, 7)),
                totalPayment: Number(p.totalPayment ?? p.amount ?? 0),
                principalPaid: Number(p.principalPaid ?? 0),
                interestPaid: Number(p.interestPaid ?? 0),
                extraPrepayment: Number(p.extraPrepayment ?? 0),
                notes: p.notes || ''
              }));
              const isPaid = d.paidOff === true || curr <= 0;
              const normalizedCurr = isPaid ? 0 : Math.max(0, curr);
              return {
                id: d.id,
                name: nameStr,
                debtName: nameStr,
                originalPrincipal: orig,
                currentOutstandingPrincipal: normalizedCurr,
                balance: normalizedCurr,
                interestRate: rateVal,
                rate: rateVal,
                monthlyEMI: emiVal,
                minimum: emiVal,
                paymentHistory,
                active: !isPaid,
                paidOff: isPaid
              };
            })
        : [];
    } else {
      debts = [];
    }
  } catch (e) {
    debts = [];
  }
  let debtStrategy: 'avalanche' | 'snowball' | 'foir' = 'avalanche';
  let extraMonthlyDebtPayment = 0;

  // Goals State (Empty by default; no demo goals)
  const GOAL_STORAGE_KEY = 'fet_goals_v4';
  let goals: GoalItem[] = [];
  try {
    const rawGoals = localStorage.getItem(GOAL_STORAGE_KEY);
    if (rawGoals) {
      const parsed = JSON.parse(rawGoals);
      goals = Array.isArray(parsed)
        ? parsed
            .filter((g: GoalItem) => !['goal-1', 'goal-2', 'goal-3'].includes(g.id))
            .map((g: GoalItem) => {
              const rawContribs = Array.isArray(g.contributions) ? g.contributions : [];
              const contributions: GoalContribution[] = rawContribs.map((c: any, idx: number) => {
                const month = c.month || (c.date ? c.date.slice(0, 7) : new Date().toISOString().slice(0, 7));
                const date = c.date || `${month}-01`;
                const actual = Number(c.actual ?? c.amount) || 0;
                const id = c.id || `contrib-${g.id}-${idx}-${date}`;
                return {
                  id,
                  date,
                  month,
                  actual,
                  planned: typeof c.planned === 'number' ? c.planned : g.monthly
                };
              });
              const initialAmount = typeof g.initialAmount === 'number' ? g.initialAmount : (g.current || 0);
              const totalActual = contributions.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
              return {
                ...g,
                contributions,
                initialAmount,
                current: initialAmount + totalActual
              };
            })
        : [];
    } else {
      goals = [];
    }
  } catch (e) {
    goals = [];
  }

  // --- 2. Blog Articles Database: Educational Guides ---
  const BLOG_ARTICLES: Record<string, { title: string; category: string; readTime: string; contentHtml: string }> = {
    'blog-1': {
      title: 'Automating Your Financial Life: How to Build a Frictionless Payday Routine',
      category: 'Financial Systems & Habits',
      readTime: '6 min read',
      contentHtml: `
        <p>Relying on manual discipline and daily willpower to manage personal finances is exhausting and error-prone. The most reliable way to achieve consistent financial success is to <strong>automate your money flow</strong> on the day you get paid.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">1. The Three-Account Triage System</h4>
        <p>A simple, powerful architecture to eliminate cognitive stress involves segregating cash across three distinct accounts:</p>
        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 mt-1">
          <li><strong>Salary & Fixed Bills Account:</strong> Where your paycheck lands and from where mandatory obligations (rent/mortgage, utilities, EMIs, insurance) are auto-debited.</li>
          <li><strong>Wealth & Emergency Bucket:</strong> High-yield savings or mutual fund SIPs that debit automatically 24–48 hours after salary day.</li>
          <li><strong>Discretionary Living Account:</strong> A separate checking account or UPI-linked card loaded with your budgeted "guilt-free spending" for food, dining, and leisure.</li>
        </ul>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">2. Synchronizing Debit Dates 24 Hours Post-Payday</h4>
        <p>Schedule your systematic investment transfers (SIPs, PPF, index funds) and major loan EMIs to process 1 to 2 business days after your usual salary credit date. This ensures your savings and debt pre-payments are captured before discretionary month-end spending begins.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">3. The Psychological Advantage: Guilt-Free Spending</h4>
        <p>When bills and long-term investments are funded automatically on day one, whatever remains in your discretionary account can be spent without guilt, hesitation, or complex spreadsheet calculations.</p>

        <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 my-3">
          <strong>Advisory Note:</strong> Review your automated transfers twice a year or whenever your income changes. A system that runs smoothly on autopilot protects your financial future even during your busiest work weeks.
        </div>
      `
    },
    'blog-2': {
      title: 'Plugging Silent Cash Flow Leaks: Auditing Subscriptions & Lifestyle Creep',
      category: 'Pillar 1: Cash Flow',
      readTime: '5 min read',
      contentHtml: `
        <p>Even households with comfortable incomes can find themselves living paycheck to paycheck if their cash flow is allowed to drift without intentional boundaries.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">1. Identifying Frictionless Spending Leaks</h4>
        <p>Modern digital convenience makes spending almost imperceptible. Recurring app memberships, streaming bundles, delivery convenience fees, and quick-commerce orders slip past unnoticed because individual charges seem modest.</p>
        <p><strong>Practical Action:</strong> Conduct a quarterly statement audit. Highlight every recurring auto-debit and cancel any service not actively utilized within the preceding 30 days.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">2. Defeating Lifestyle Inflation</h4>
        <p>As career earnings grow, living expenses naturally tend to expand to consume the new ceiling through upgraded housing, frequent dining out, or vehicle upgrades.</p>
        <p><strong>The 50% Rule for Increments:</strong> Whenever you receive a raise, bonus, or new income stream, commit at least 50% of the net increase directly into automated investments before adjusting your discretionary lifestyle upward.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">3. The 72-Hour Impulse Delay</h4>
        <p>For any non-essential purchase exceeding $50, institute an intentional 72-hour cooling-off delay. In a significant number of instances, the initial emotional urge dissipates, leaving your cash flow intact for true priorities.</p>
      `
    },
    'blog-3': {
      title: 'Strategic Debt Payoff: Mathematical Avalanche vs. Behavioral Snowball',
      category: 'Pillar 2: Debt & Protection',
      readTime: '5 min read',
      contentHtml: `
        <p>Carrying high-interest debt is like running a marathon with a weighted vest. Selecting a clear, systematic repayment strategy transforms chaotic stress into steady, measurable progress.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Mathematical Champion: Debt Avalanche</h4>
        <p>Under the Avalanche method, debts are ordered strictly by interest rate from highest to lowest. You pay mandatory minimums on all obligations while directing every surplus rupee toward the account charging the highest APR (typically credit card revolving dues at 36%–44% p.a., followed by personal loans at 12%–16%).</p>
        <p><strong>Advantage:</strong> Minimizes the total cumulative interest paid over the life of your loans and achieves debt freedom in the shortest possible calendar time.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Psychological Motivator: Debt Snowball</h4>
        <p>The Snowball method orders debts from smallest principal balance to largest, ignoring interest rates entirely. Extra funds go toward wiping out the smallest balance completely.</p>
        <p><strong>Advantage:</strong> Eliminating an entire account early generates an immediate psychological boost and eliminates one monthly payment deadline, building behavioral stamina.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Advisory Perspective</h4>
        <p>Choose the model that aligns with your personality: choose Avalanche if you are motivated by numbers and cost minimization; choose Snowball if you benefit from quick, tangible milestone wins to stay the course.</p>
      `
    },
    'blog-4': {
      title: 'Building Your Emergency Shield: Sizing and Parking 3–6 Months of Living Costs',
      category: 'Pillar 2: Debt & Protection',
      readTime: '4 min read',
      contentHtml: `
        <p>An emergency reserve is not an investment meant to produce high returns; it is an insurance policy that preserves your sanity and protects your wealth accumulation engine.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Calculating Your True Emergency Number</h4>
        <p>Calculate your bare-bones survival budget rather than your total current spending. Include essential housing rent/EMI, groceries, utilities, mandatory loan minimums, and basic medical needs. Multiply this baseline by 3 to 6 months depending on income stability (freelancers and single-income families should target 6 to 9 months).</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Optimal Parking Instruments</h4>
        <p>Emergency capital must meet two strict criteria: <em>capital safety</em> and <em>instant liquidity</em>.</p>
        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 mt-1">
          <li><strong>Auto-Sweep Fixed Deposits:</strong> Provides term-deposit yields with instantaneous liquidity linked to your checking account.</li>
          <li><strong>Liquid Mutual Funds:</strong> Invest in high-credit short-term money market instruments with minimal exit charges after 7 days.</li>
        </ul>
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs font-mono text-slate-700 my-2">
          Rule: Never invest emergency funds in volatile equities or locked illiquid schemes. Accessibility is paramount.
        </div>
      `
    },
    'blog-5': {
      title: 'The Mechanics of Compounding: Harnessing the Rule of 72 & Systematic Investing',
      category: 'Pillar 3: Wealth Building',
      readTime: '5 min read',
      contentHtml: `
        <p>Compounding is the mathematical engine of personal wealth. When the returns generated by your investments begin generating their own returns, growth shifts from linear addition to exponential multiplication.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Rule of 72 Simplified</h4>
        <p>To estimate how long it takes for invested capital to double at a given annual return rate, divide 72 by that rate:</p>
        <div class="p-2.5 rounded-lg bg-indigo-50/50 border border-indigo-200 font-mono text-xs my-2 text-indigo-950">
          • At 6% annual return: 72 / 6 = 12 years to double <br />
          • At 12% annual return: 72 / 12 = 6 years to double
        </div>
        <p>Over a 30-year working career, an investment doubling every 6 years undergoes 5 doubling cycles (a 32x multiplier on initial principal).</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Disciplined Power of SIPs</h4>
        <p>Systematic Investment Plans (SIPs) remove the emotional pitfalls of market timing. By purchasing consistently through market highs and lows, you naturally acquire more units when valuations are discounted (rupee-cost averaging), allowing compounding to work uninterrupted.</p>
      `
    },
    'blog-6': {
      title: 'Defending Purchasing Power: Outpacing Inflation & Achieving Time Autonomy',
      category: 'Pillar 4: Preservation & Autonomy',
      readTime: '5 min read',
      contentHtml: `
        <p>Earning money is only half the battle; preserving its purchasing power against the relentless erosion of inflation is what ultimately secures lasting freedom.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Nominal Yield vs. Real Purchasing Power</h4>
        <p>If a fixed-income instrument yields 6.5% annually while headline inflation is 5.5%, your real post-tax yield may actually be negative. Over 15 to 20 years, low-yielding cash balances lose a substantial portion of their real buying power.</p>
        <p><strong>Advisory Approach:</strong> Balance short-term stability with productive growth assets (broad equities, real estate, or inflation-indexed instruments) capable of generating positive real returns over multi-year horizons.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The True Meaning of Financial Independence</h4>
        <p>True wealth is measured not in luxury possessions, but in <em>time autonomy</em>—the freedom to wake up each morning and decide how to spend your hours, whom to collaborate with, and which meaningful pursuits to undertake without financial duress.</p>
        <p>By mastering the Four Pillars, you build an enduring foundation that turns financial security into a sustainable, lifelong reality.</p>
      `
    }
  };

  // --- 3. DOM Elements ---
  const currencySelector = document.getElementById('currency-selector') as HTMLSelectElement;
  const inputIncome = document.getElementById('input-income-amount') as HTMLInputElement;
  const incomeSlider = document.getElementById('income-range-slider') as HTMLInputElement;
  const incomeNormalizedAmount = document.getElementById('income-normalized-amount');
  const btnFreqs = document.querySelectorAll('.btn-freq');

  const statTotalIncome = document.getElementById('stat-total-income');
  const statTotalExpenses = document.getElementById('stat-total-expenses');
  const statExpensesPct = document.getElementById('stat-expenses-pct');
  const statRemainingBalance = document.getElementById('stat-remaining-balance');
  const statCashflowLabel = document.getElementById('stat-cashflow-label');
  const statSavingsRate = document.getElementById('stat-savings-rate');

  // Health Card
  const healthTierBadge = document.getElementById('health-tier-badge');
  const healthTierText = document.getElementById('health-tier-text');
  const healthScoreNumber = document.getElementById('health-score-number');
  const scoreCircleStroke = document.getElementById('score-circle-stroke');
  const scoreSavingsRateLabel = document.getElementById('score-savings-rate-label');
  const barSavingsScore = document.getElementById('bar-savings-score');
  const scoreFixedCostLabel = document.getElementById('score-fixed-cost-label');
  const barFixedScore = document.getElementById('bar-fixed-score');
  const scoreBufferLabel = document.getElementById('score-buffer-label');
  const barBufferScore = document.getElementById('bar-buffer-score');
  const healthRecommendationsList = document.getElementById('health-recommendations-list');

  // Smart Suggestions
  const smartSuggestionsContainer = document.getElementById('smart-suggestions-container');
  const potentialSavingsTotal = document.getElementById('potential-savings-total');

  // Logger Form
  const formExpenseLogger = document.getElementById('form-expense-logger') as HTMLFormElement;
  const inputItemName = document.getElementById('input-item-name') as HTMLInputElement;
  const inputItemAmount = document.getElementById('input-item-amount') as HTMLInputElement;
  const selectItemCategory = document.getElementById('select-item-category') as HTMLSelectElement;
  const presetChips = document.querySelectorAll('.btn-preset-chip');
  const btnScanReceiptLogger = document.getElementById('btn-scan-receipt-logger');
  const btnClearLogger = document.getElementById('btn-clear-logger');
  const inputReceiptPhoto = document.getElementById('input-receipt-photo') as HTMLInputElement;
  const receiptScanningIndicator = document.getElementById('receipt-scanning-indicator');
  const receiptOcrProgress = document.getElementById('receipt-ocr-progress');

  // Ledger Elements
  const transactionsTbody = document.getElementById('transactions-tbody');
  const emptyLedgerState = document.getElementById('empty-ledger-state');
  const txCountDisplay = document.getElementById('tx-count-display');
  const searchTransactionsInput = document.getElementById('search-transactions') as HTMLInputElement;
  const btnExportCsv = document.getElementById('btn-export-csv');

  // Debt Management Elements
  const statTotalDebt = document.getElementById('stat-total-debt');
  const debtItemCount = document.getElementById('debt-item-count');
  const statDtiRatio = document.getElementById('stat-dti-ratio');
  const statDtiTier = document.getElementById('stat-dti-tier');
  const statDebtFreeDate = document.getElementById('stat-debt-free-date');
  const statDebtMonthsLeft = document.getElementById('stat-debt-months-left');
