  function updateDebtPaymentLiveFeedback() {
    const debtId = inputDebtPaymentDebtId?.value;
    const debt = debts.find((d) => d.id === debtId);
    if (!debt) return;

    const principal = parseFloat(inputDebtPaymentPrincipal?.value || '0') || 0;
    const extra = parseFloat(inputDebtPaymentExtra?.value || '0') || 0;
    const totalReduction = principal + extra;
    const projectedNew = Math.max(0, debt.currentOutstandingPrincipal - totalReduction);

    if (displayPaymentPrincipalReduction) {
      displayPaymentPrincipalReduction.textContent = formatMoney(totalReduction);
    }
    if (displayPaymentNewBalance) {
      if (projectedNew === 0) {
        displayPaymentNewBalance.innerHTML = `<span class="text-emerald-700 dark:text-emerald-400 font-bold">${formatMoney(0)} (Loan Cleared! 🎉)</span>`;
      } else {
        displayPaymentNewBalance.textContent = formatMoney(projectedNew);
      }
    }
  }

  function renderDebtModalHistory(debt: DebtItem) {
    if (!modalDebtHistoryTbody || !modalDebtHistoryCount) return;
    const history = debt.paymentHistory || [];
    modalDebtHistoryCount.textContent = `${history.length} payment${history.length === 1 ? '' : 's'}`;

    if (history.length === 0) {
      modalDebtHistoryTbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-4 text-center text-[10px] text-slate-400 dark:text-slate-500">
            No payments recorded yet for this account.
          </td>
        </tr>
      `;
      return;
    }

    // Sort newest date first
    const sorted = [...history].sort((a, b) => b.date.localeCompare(a.date));
    modalDebtHistoryTbody.innerHTML = sorted
      .map(
        (p) => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60">
          <td class="py-1.5 px-2.5 whitespace-nowrap">
            <span class="font-medium text-slate-800 dark:text-slate-200">${formatDateDisplay(p.date)}</span>
            ${p.notes ? `<span class="block text-[9px] text-slate-400 font-sans italic truncate max-w-[120px]">${escapeHtml(p.notes)}</span>` : ''}
          </td>
          <td class="py-1.5 px-2 text-right font-bold text-slate-900 dark:text-slate-100 whitespace-nowrap">${formatMoney(p.totalPayment)}</td>
          <td class="py-1.5 px-2 text-right text-emerald-700 dark:text-emerald-400 font-semibold whitespace-nowrap">${formatMoney(p.principalPaid)}</td>
          <td class="py-1.5 px-2 text-right text-rose-600 dark:text-rose-400 whitespace-nowrap">${formatMoney(p.interestPaid)}</td>
          <td class="py-1.5 px-2 text-right text-slate-600 dark:text-slate-300 whitespace-nowrap">${formatMoney(p.extraPrepayment)}</td>
          <td class="py-1.5 px-2 text-center whitespace-nowrap">
            <button
              type="button"
              data-delete-payment-id="${p.id}"
              data-debt-id="${debt.id}"
              class="btn-delete-payment text-slate-400 hover:text-rose-600 p-0.5 rounded transition-colors cursor-pointer"
              title="Delete payment record and revert balance"
              aria-label="Delete payment record"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
          </td>
        </tr>
      `
      )
      .join('');

    // Attach delete payment listeners
    modalDebtHistoryTbody.querySelectorAll('.btn-delete-payment').forEach((btn) => {
      btn.addEventListener('click', () => {
        const paymentId = btn.getAttribute('data-delete-payment-id');
        const dId = btn.getAttribute('data-debt-id');
        const targetDebt = debts.find((d) => d.id === dId);
        if (!targetDebt || !paymentId) return;

        const pIndex = (targetDebt.paymentHistory || []).findIndex((p) => p.id === paymentId);
        if (pIndex >= 0) {
          const removed = targetDebt.paymentHistory![pIndex];
          targetDebt.paymentHistory!.splice(pIndex, 1);
          // Restore balance
          const restored = targetDebt.currentOutstandingPrincipal + removed.principalPaid + removed.extraPrepayment;
          targetDebt.currentOutstandingPrincipal = Math.min(targetDebt.originalPrincipal, restored);
          targetDebt.balance = targetDebt.currentOutstandingPrincipal;
          if (targetDebt.currentOutstandingPrincipal > 0) {
            targetDebt.paidOff = false;
            targetDebt.active = true;
          }
          localStorage.setItem(DEBT_STORAGE_KEY, JSON.stringify(debts));
          renderDebtModalHistory(targetDebt);
          if (modalDebtCurrentPrincipal) {
            modalDebtCurrentPrincipal.textContent = formatMoney(targetDebt.currentOutstandingPrincipal);
          }
          updateDebtPaymentLiveFeedback();
          renderAll();
        }
      });
    });
  }

  function openDebtPaymentModal(debtId: string, historyOnly = false) {
    const debt = debts.find((d) => d.id === debtId);
    if (!debt || !debtPaymentModal) return;

    if (inputDebtPaymentDebtId) inputDebtPaymentDebtId.value = debt.id;
    if (modalDebtName) modalDebtName.textContent = debt.name;
    if (modalDebtCurrentPrincipal) modalDebtCurrentPrincipal.textContent = formatMoney(debt.currentOutstandingPrincipal);
    if (modalDebtRateEmi) {
      modalDebtRateEmi.textContent = `${formatMoney(debt.monthlyEMI)}/mo @ ${debt.interestRate}% p.a.`;
    }

    const todayStr = new Date().toISOString().split('T')[0];
    if (inputDebtPaymentDate) inputDebtPaymentDate.value = todayStr;

    // Default payment values
    const defaultTotal = debt.monthlyEMI > 0
      ? Math.min(debt.monthlyEMI, debt.currentOutstandingPrincipal)
      : Math.min(5000, debt.currentOutstandingPrincipal);

    // Initial 1-month interest estimate for user convenience
    const estInterest = Math.min(
      defaultTotal,
      Math.round(debt.currentOutstandingPrincipal * (debt.interestRate / 100) / 12)
    );
    const estPrincipal = Math.max(0, Math.min(debt.currentOutstandingPrincipal, defaultTotal - estInterest));

    if (inputDebtPaymentTotal) inputDebtPaymentTotal.value = defaultTotal.toString();
    if (inputDebtPaymentPrincipal) inputDebtPaymentPrincipal.value = estPrincipal.toString();
    if (inputDebtPaymentInterest) inputDebtPaymentInterest.value = estInterest.toString();
    if (inputDebtPaymentExtra) inputDebtPaymentExtra.value = '0';
    if (inputDebtPaymentNotes) inputDebtPaymentNotes.value = '';

    if (paymentEstimateNotice) paymentEstimateNotice.classList.add('hidden');
    hideDebtPaymentError();

    renderDebtModalHistory(debt);
    updateDebtPaymentLiveFeedback();

    isSubmittingDebtPayment = false;
    if (btnSaveDebtPayment) {
      btnSaveDebtPayment.disabled = debt.paidOff === true;
      if (debt.paidOff) {
        btnSaveDebtPayment.textContent = 'Account Paid Off';
      } else {
        btnSaveDebtPayment.innerHTML = '<span>💾</span> Save Payment';
      }
    }

    debtPaymentModal.classList.remove('hidden');
    if (!historyOnly && inputDebtPaymentTotal) {
      inputDebtPaymentTotal.focus();
    }
  }

  function closeDebtPaymentModal() {
    debtPaymentModal?.classList.add('hidden');
    hideDebtPaymentError();
    isSubmittingDebtPayment = false;
    if (btnSaveDebtPayment) btnSaveDebtPayment.disabled = false;
  }

  btnDebtEstimateSplit?.addEventListener('click', () => {
    const debtId = inputDebtPaymentDebtId?.value;
    const debt = debts.find((d) => d.id === debtId);
    if (!debt || !inputDebtPaymentTotal) return;

    const total = parseFloat(inputDebtPaymentTotal.value) || 0;
    if (total <= 0) {
      showDebtPaymentError('Please enter a total payment amount first.');
      return;
    }

    const estInterest = Math.min(
      total,
      Math.round(debt.currentOutstandingPrincipal * (debt.interestRate / 100) / 12)
    );
    const estPrincipal = Math.max(0, Math.min(debt.currentOutstandingPrincipal, total - estInterest));

    if (inputDebtPaymentPrincipal) inputDebtPaymentPrincipal.value = estPrincipal.toString();
    if (inputDebtPaymentInterest) inputDebtPaymentInterest.value = estInterest.toString();
    if (inputDebtPaymentExtra) inputDebtPaymentExtra.value = '0';

    if (paymentEstimateNotice) paymentEstimateNotice.classList.remove('hidden');
    hideDebtPaymentError();
    updateDebtPaymentLiveFeedback();
  });

