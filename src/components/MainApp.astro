  formGoalContribution?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (isSubmittingContrib) return;

    const goalId = inputContribGoalId?.value;
    const goal = goals.find((g) => g.id === goalId);
    if (!goal) return;

    const dateVal = inputContribDate?.value;
    if (!dateVal) {
      if (contribErrorMsg) {
        contribErrorMsg.textContent = 'Please select a valid contribution date.';
        contribErrorMsg.classList.remove('hidden');
      }
      return;
    }

    const actual = parseFloat(inputContribActual?.value || '');
    if (isNaN(actual) || actual <= 0) {
      if (contribErrorMsg) {
        contribErrorMsg.textContent = 'Contribution amount must be greater than 0.';
        contribErrorMsg.classList.remove('hidden');
      }
      return;
    }

    const entryId = inputContribEntryId?.value;

    // Validation: Do not allow total contributions to exceed remaining goal amount
    const startingAmount = typeof goal.initialAmount === 'number' ? goal.initialAmount : (goal.current || 0);
    const otherActuals = (goal.contributions || [])
      .filter((c) => c.id !== entryId)
      .reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
    const currentWithoutThis = startingAmount + otherActuals;
    const maxAllowed = Math.max(0, goal.target - currentWithoutThis);

    if (actual > maxAllowed) {
      if (contribErrorMsg) {
        contribErrorMsg.textContent = `Contribution cannot exceed remaining goal amount (${formatMoney(maxAllowed)}).`;
        contribErrorMsg.classList.remove('hidden');
      }
      return;
    }

    isSubmittingContrib = true;
    if (btnSubmitContribution) btnSubmitContribution.disabled = true;

    if (!goal.contributions) goal.contributions = [];
    const month = dateVal.slice(0, 7);

    if (entryId) {
      // Editing existing entry
      const existingIdx = goal.contributions.findIndex((c) => c.id === entryId);
      if (existingIdx >= 0) {
        goal.contributions[existingIdx] = {
          ...goal.contributions[existingIdx],
          date: dateVal,
          month,
          actual
        };
      }
    } else {
      // Adding a separate valid contribution (supports multiple in the same month/date)
      goal.contributions.push({
        id: `contrib-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        date: dateVal,
        month,
        planned: goal.monthly,
        actual
      });
    }

    // Sort chronologically by date
    goal.contributions.sort((a, b) => (a.date || a.month).localeCompare(b.date || b.month));

    // Recalculate current saved
    const totalActual = goal.contributions.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
    goal.current = startingAmount + totalActual;

    localStorage.setItem(GOAL_STORAGE_KEY, JSON.stringify(goals));
    closeContributionModal();
    renderAll();
    showContextualFeedback(document.getElementById('tab-view-targets'));
  });

