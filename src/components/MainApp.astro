          })
          .join('');
      } else {
        containerPaidDebts.classList.add('hidden');
      }
    }

    // Attach Event Listeners to Debt Table Buttons
    document.querySelectorAll('.btn-record-debt-payment').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-record-payment-id');
        if (id) openDebtPaymentModal(id, false);
      });
    });

    document.querySelectorAll('.btn-history-debt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-history-debt-id');
        if (id) openDebtPaymentModal(id, true);
      });
    });

    document.querySelectorAll('.btn-delete-debt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-delete-debt-id');
        if (!id) return;
        debts = debts.filter((d) => d.id !== id);
        localStorage.setItem(DEBT_STORAGE_KEY, JSON.stringify(debts));
        renderAll();
      });
    });

    document.querySelectorAll('.btn-reopen-debt').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-reopen-debt-id');
        const debt = debts.find((d) => d.id === id);
        if (!debt) return;
        const newPrincipal = prompt(`Reopen "${debt.name}". Enter new outstanding principal amount:`, debt.originalPrincipal.toString());
        if (newPrincipal !== null) {
          const parsed = parseFloat(newPrincipal);
          if (!isNaN(parsed) && parsed > 0) {
            debt.currentOutstandingPrincipal = parsed;
            debt.balance = parsed;
            debt.paidOff = false;
            debt.active = true;
            localStorage.setItem(DEBT_STORAGE_KEY, JSON.stringify(debts));
            renderAll();
          }
        }
      });
    });
  }

  // --- 8. Target & Budget Planning Engine ---
  function renderBudgetPlanning(totalMonthlyExpenses: number) {
    // Emergency Fund Benchmark
    if (efundMonthlyOutflow) efundMonthlyOutflow.textContent = `${formatMoney(totalMonthlyExpenses)}/mo`;
    if (targetEfund3mo) targetEfund3mo.textContent = formatMoney(totalMonthlyExpenses * 3);
    if (targetEfund6mo) targetEfund6mo.textContent = formatMoney(totalMonthlyExpenses * 6);

    // Render Active Goals
    if (!goalsContainer) return;

    if (goals.length === 0) {
      goalsContainer.innerHTML = `
        <div class="col-span-1 md:col-span-2 lg:col-span-3 p-8 text-center text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-2">
          <div class="text-2xl">🎯</div>
          <div class="font-bold text-slate-800 dark:text-slate-100 text-sm">No Financial Targets Added Yet</div>
          <p class="max-w-md mx-auto text-slate-600 dark:text-slate-300">
            Define your custom financial milestones, savings targets, or vehicle/home fund using the form below.
          </p>
        </div>
      `;
      return;
    }

    goalsContainer.innerHTML = goals
      .map((g) => {
        const startingAmount = typeof g.initialAmount === 'number' ? g.initialAmount : (g.current || 0);
        const contributions = Array.isArray(g.contributions) ? g.contributions : [];
        const totalActual = contributions.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
        const totalSaved = startingAmount + totalActual;
        const pct = g.target > 0 ? Math.min(100, Math.round((totalSaved / g.target) * 100)) : 0;
        const remaining = Math.max(0, g.target - totalSaved);
        const plannedMonthsLeft = g.monthly > 0 ? Math.ceil(remaining / g.monthly) : 0;

        let plannedProjectionText = '';
        if (remaining === 0) {
          plannedProjectionText = 'Goal Reached!';
        } else if (g.monthly > 0) {
          plannedProjectionText = `${plannedMonthsLeft} mos to goal`;
        } else {
          plannedProjectionText = 'No monthly plan set';
        }

        // Distinct monthly totals for actual pace
        const monthlyTotalsMap = new Map<string, number>();
        contributions.forEach((c) => {
          const m = c.month || (c.date ? c.date.slice(0, 7) : '');
          if (m) monthlyTotalsMap.set(m, (monthlyTotalsMap.get(m) || 0) + (Number(c.actual) || 0));
        });
        const monthlyTotals = Array.from(monthlyTotalsMap.values());
        const recentMonths = monthlyTotals.slice(-6);
        const sumRecent = recentMonths.reduce((sum, v) => sum + v, 0);
        const avgActual = recentMonths.length > 0 ? sumRecent / recentMonths.length : 0;

        let actualProjectionText = '';
        if (remaining === 0) {
          actualProjectionText = 'Goal Reached!';
        } else if (contributions.length > 0) {
          if (avgActual > 0) {
            const actualMonthsLeft = Math.ceil(remaining / avgActual);
            actualProjectionText = `${actualMonthsLeft} mos left (~${formatMoney(Math.round(avgActual))}/mo)`;
          } else {
            actualProjectionText = `${getCurrencySymbol()}0 contributed recently`;
          }
        }

        // Group contributions by month
        const monthGroups = new Map<string, GoalContribution[]>();
        contributions.forEach((c) => {
          const m = c.month || (c.date ? c.date.slice(0, 7) : '');
          if (!m) return;
          if (!monthGroups.has(m)) monthGroups.set(m, []);
          monthGroups.get(m)!.push(c);
        });

        // Sort months descending (newest month first)
        const sortedMonthKeys = Array.from(monthGroups.keys()).sort((a, b) => b.localeCompare(a));

        const historyHtml = sortedMonthKeys
          .map((m) => {
            const monthEntries = monthGroups.get(m)!;
            // Sort entries chronologically descending within the month
            monthEntries.sort((a, b) => (b.date || '').localeCompare(a.date || ''));
            const monthActual = monthEntries.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
            const monthPlanned = typeof monthEntries[0]?.planned === 'number' ? monthEntries[0].planned : g.monthly;
            const diff = monthActual - monthPlanned;
            const diffText = diff < 0
              ? `-${formatMoney(Math.abs(diff))}`
              : diff > 0
                ? `+${formatMoney(diff)}`
                : formatMoney(0);
            const diffClass = diff < 0
              ? 'text-rose-700 dark:text-rose-400 font-semibold'
              : diff > 0
                ? 'text-emerald-700 dark:text-emerald-400 font-semibold'
                : 'text-slate-500 dark:text-slate-400';

            return `
              <div class="rounded-xl border border-slate-200/80 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/90 p-2 space-y-1.5">
                <div class="flex flex-wrap items-center justify-between gap-1 text-[10px] font-mono border-b border-slate-200/60 dark:border-slate-800 pb-1">
                  <span class="font-bold text-slate-800 dark:text-slate-200">${formatMonthYear(m)}</span>
                  <div class="flex items-center gap-1.5 sm:gap-2">
                    <span class="text-slate-500 dark:text-slate-400">Plan: ${formatMoney(monthPlanned)}</span>
                    <span class="font-bold text-slate-900 dark:text-slate-100">Actual: ${formatMoney(monthActual)}</span>
                    <span class="${diffClass}">(${diffText})</span>
                  </div>
                </div>
                <div class="divide-y divide-slate-200/40 dark:divide-slate-800 font-mono text-[10px]">
                  ${monthEntries
                    .map(
                      (c) => `
                    <div class="flex items-center justify-between py-1 px-0.5">
                      <span class="text-slate-600 dark:text-slate-300 font-medium">${formatDateDisplay(c.date || c.month)}</span>
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-slate-900 dark:text-slate-100">${formatMoney(c.actual)}</span>
                        <div class="flex items-center gap-0.5">
                          <button
                            type="button"
                            data-edit-contrib-id="${c.id}"
                            data-goal-id="${g.id}"
                            class="btn-edit-contrib text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 p-0.5 rounded transition-colors cursor-pointer"
                            title="Edit contribution (${formatDateDisplay(c.date || c.month)})"
                            aria-label="Edit contribution (${formatDateDisplay(c.date || c.month)})"
                          >
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                          </button>
                          <button
                            type="button"
                            data-delete-contrib-id="${c.id}"
                            data-goal-id="${g.id}"
                            class="btn-delete-contrib text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-0.5 rounded transition-colors cursor-pointer"
                            title="Remove contribution"
                            aria-label="Remove contribution"
                          >
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  `
                    )
                    .join('')}
                </div>
              </div>
            `;
          })
          .join('');

        return `
        <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 shadow-xs hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate pr-2" title="${escapeHtml(g.name)}">${escapeHtml(g.name)}</h4>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                  ${pct}% Done
                </span>
                <button
                  type="button"
                  data-delete-goal-id="${g.id}"
                  class="btn-delete-goal text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 p-1 rounded-md transition-colors cursor-pointer"
                  title="Remove financial target"
                  aria-label="Remove financial target"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between items-baseline text-xs font-mono">
                <span class="font-bold text-slate-900 dark:text-slate-100">${formatMoney(totalSaved)}</span>
                <span class="text-slate-500 dark:text-slate-400">Target: ${formatMoney(g.target)}</span>
              </div>
              <div class="flex justify-between items-center text-[10px] font-mono text-slate-500 dark:text-slate-400">
                <span>Remaining: <strong class="text-slate-700 dark:text-slate-300 font-semibold">${formatMoney(remaining)}</strong></span>
                <span>Starting: ${formatMoney(startingAmount)}</span>
              </div>
            </div>

            <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-emerald-600 h-2 rounded-full transition-all duration-500" style="width: ${pct}%"></div>
            </div>

            <div class="space-y-1 pt-1 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400 font-mono">
              <div class="flex justify-between items-center">
                <span class="flex items-center gap-1">
                  Plan: +${formatMoney(g.monthly)}/mo
                  <button
                    type="button"
                    data-edit-plan-goal-id="${g.id}"
                    class="btn-edit-plan text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 cursor-pointer"
                    title="Edit planned monthly allocation"
                    aria-label="Edit planned monthly allocation"
                  >
                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </button>
                </span>
                <span class="font-medium text-slate-700 dark:text-slate-300">${plannedProjectionText}</span>
              </div>
              ${actualProjectionText ? `
              <div class="flex justify-between items-center text-[10px]">
                <span class="text-slate-400">Actual:</span>
                <span class="font-medium text-emerald-800 dark:text-emerald-300">${actualProjectionText}</span>
              </div>
              ` : ''}
            </div>

            <!-- Contribution Action -->
            <button
              type="button"
              data-open-contrib-goal-id="${g.id}"
              class="btn-open-contrib-modal w-full text-xs font-semibold py-1.5 px-3 rounded-xl border border-emerald-200 dark:border-emerald-800/80 bg-emerald-50 hover:bg-emerald-100/80 dark:bg-emerald-950/40 dark:hover:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Record Contribution</span>
            </button>

            <!-- Compact Contribution History Section -->
            ${contributions.length > 0 ? `
            <details class="text-[11px] border border-slate-200/70 dark:border-slate-800 rounded-xl p-2 bg-slate-50/60 dark:bg-slate-850/60 group">
              <summary class="cursor-pointer font-semibold text-slate-700 dark:text-slate-300 flex items-center justify-between select-none text-[11px]">
                <span>Contribution History (${contributions.length} ${contributions.length === 1 ? 'entry' : 'entries'})</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <div class="mt-2 space-y-2">
                ${historyHtml}
              </div>
            </details>
            ` : `
            <div class="text-[10px] text-slate-500 dark:text-slate-400 text-center py-0.5">
              No actual contributions recorded yet
            </div>
            `}
          </div>
        </div>
      `;
      })
      .join('');

    // Attach delete handlers to target cards
    document.querySelectorAll('.btn-delete-goal').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-delete-goal-id');
        if (!id) return;
        goals = goals.filter((g) => g.id !== id);
        localStorage.setItem(GOAL_STORAGE_KEY, JSON.stringify(goals));
        renderAll();
      });
    });

    // Attach open contribution modal handlers
    document.querySelectorAll('.btn-open-contrib-modal').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-open-contrib-goal-id');
        if (!id) return;
        openContributionModal(id);
      });
    });

    // Attach edit contribution handlers
    document.querySelectorAll('.btn-edit-contrib').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const goalId = btn.getAttribute('data-goal-id');
        const contribId = btn.getAttribute('data-edit-contrib-id');
        if (!goalId || !contribId) return;
        openContributionModal(goalId, undefined, false, contribId);
      });
    });

    // Attach delete contribution handlers
    document.querySelectorAll('.btn-delete-contrib').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const goalId = btn.getAttribute('data-goal-id');
        const contribId = btn.getAttribute('data-delete-contrib-id');
        if (!goalId || !contribId) return;
        const goal = goals.find((g) => g.id === goalId);
        if (!goal || !goal.contributions) return;

        goal.contributions = goal.contributions.filter((c) => c.id !== contribId);
        const starting = typeof goal.initialAmount === 'number' ? goal.initialAmount : (goal.current || 0);
        const totalActual = goal.contributions.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
        goal.current = starting + totalActual;
        localStorage.setItem(GOAL_STORAGE_KEY, JSON.stringify(goals));
        renderAll();
      });
    });

    // Attach edit plan handlers
    document.querySelectorAll('.btn-edit-plan').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const goalId = btn.getAttribute('data-edit-plan-goal-id');
        if (!goalId) return;
        openContributionModal(goalId, undefined, true);
      });
    });
  }

  // --- 9. Ledger Table Renderer ---
  function renderLedger() {
    if (!transactionsTbody) return;

    const searchTerm = (searchTransactionsInput?.value || '').toLowerCase().trim();
    const filtered = state.transactions.filter(
      (t) =>
        t.name.toLowerCase().includes(searchTerm) ||
        t.category.toLowerCase().includes(searchTerm) ||
        t.date.includes(searchTerm)
    );

    if (txCountDisplay) {
      txCountDisplay.textContent = t('ledger.entriesCount', activeLocale, { count: state.transactions.length });
    }

    if (filtered.length === 0) {
      transactionsTbody.innerHTML = '';
      emptyLedgerState?.classList.remove('hidden');
      return;
    }

    emptyLedgerState?.classList.add('hidden');

    transactionsTbody.innerHTML = filtered
      .map(
        (tx) => `
      <tr class="hover:bg-slate-50 transition-colors">
        <td class="py-2 px-3 font-mono text-[11px] text-slate-500 whitespace-nowrap">${tx.date}</td>
        <td class="py-2 px-3 font-medium text-slate-900 max-w-[180px] truncate" title="${escapeHtml(tx.name)}">
          ${escapeHtml(tx.name)}
        </td>
        <td class="py-2 px-3 whitespace-nowrap">
          ${tx.type === 'income'
            ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300">
                💵 ${t('categories.Income', activeLocale)}
              </span>`
            : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                ${CATEGORY_ICONS[tx.category] || '📦'} ${getLocalizedCategory(tx.category, activeLocale)}
              </span>`
          }
        </td>
        <td class="py-2 px-3 whitespace-nowrap">
          ${
            tx.source === 'imported'
              ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-teal-50 text-teal-800 border border-teal-200">file</span>`
              : `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-semibold bg-slate-100 text-slate-600">manual</span>`
          }
        </td>
        <td class="py-2 px-3 text-right font-mono font-bold ${tx.type === 'income' ? 'text-emerald-700' : 'text-slate-900'} whitespace-nowrap">
          ${tx.type === 'income' ? '+' : ''}${formatMoney(tx.amount)}
        </td>
        <td class="py-2 px-3 text-center">
          <button
            type="button"
            data-delete-id="${tx.id}"
            class="btn-delete-tx text-slate-400 hover:text-rose-600 p-1 rounded-md transition-colors cursor-pointer"
            title="Delete entry"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </td>
      </tr>
    `
      )
      .join('');

    document.querySelectorAll('.btn-delete-tx').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-delete-id');
        if (!id) return;
        state.transactions = state.transactions.filter((tx) => tx.id !== id);
        saveStoredState({ transactions: state.transactions });
        renderAll();
      });
    });

    // Update importer tab and modal if results are loaded
    if (pendingTabImportResult) {
      renderTabImporterResults();
    }
    if (pendingImportResult) {
      renderModalImporterResults();
    }
  }

  // --- 10. Event Listeners ---

  // --- GA4 Event Tracking Helper ---
  function track(name: string, params?: Record<string, any>) {
    try {
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', name, params);
      }
    } catch (_) {
      // never throws
    }
  }

  // GA4 event tracking states
  let expenseLoggerMethod: 'manual' | 'preset' = 'manual';
  let incomeSetTracked = false;
  let incomeSetDebounceTimer: any = null;

  function trackIncomeSet() {
    if (incomeSetTracked) return;
    clearTimeout(incomeSetDebounceTimer);
    incomeSetDebounceTimer = setTimeout(() => {
      if (incomeSetTracked) return;
      incomeSetTracked = true;
      track('income_set', { frequency: state.frequency });
    }, 500);
  }

  // Currency
  currencySelector?.addEventListener('change', () => {
    state.currency = currencySelector.value;
    saveStoredState({ currency: state.currency });
    renderAll();
    track('currency_changed', { currency: state.currency });
  });

  // Income Input
  inputIncome?.addEventListener('input', () => {
    state.income = parseFloat(inputIncome.value) || 0;
    saveStoredState({ income: state.income });
    renderAll();
    trackIncomeSet();
  });

  // Income Slider
  incomeSlider?.addEventListener('input', () => {
    const val = parseFloat(incomeSlider.value) || 0;
    if (state.frequency === 'monthly') {
      state.income = val;
    } else if (state.frequency === 'bi-weekly') {
      state.income = Math.round((val * 12) / 26);
    } else if (state.frequency === 'weekly') {
      state.income = Math.round((val * 12) / 52);
    }
    saveStoredState({ income: state.income });
    renderAll();
    trackIncomeSet();
  });

  // Frequency Buttons
  btnFreqs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const freq = btn.getAttribute('data-freq') as Frequency;
      if (freq) {
        state.frequency = freq;
        saveStoredState({ frequency: state.frequency });
        renderAll();
        trackIncomeSet();
      }
    });
  });

  // Pending Receipt OCR metadata for Quick Expense Logger
  let pendingReceiptMeta: { date?: string; type?: 'expense' | 'income'; source?: 'imported' } | null = null;

  // Expense Logger Submit
  formExpenseLogger?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = inputItemName.value.trim();
    const amount = parseFloat(inputItemAmount.value);
    const category = selectItemCategory.value as ExpenseCategory;

    if (!name || isNaN(amount) || amount <= 0) return;

    // Determine direction from receipt metadata, or from category selection as fallback.
    // If user selects 'Income' category, the transaction is income regardless of form defaults.
    const txType = pendingReceiptMeta?.type || (category === 'Income' ? 'income' : 'expense');
    const txDate = pendingReceiptMeta?.date || new Date().toISOString().split('T')[0];
    const txSource = pendingReceiptMeta?.source || 'manual';
    const txId = pendingReceiptMeta ? `rcpt-${Date.now()}` : `tx-${Date.now()}`;

    const newTx: Transaction = {
      id: txId,
      name,
      amount,
      category,
      date: txDate,
      source: txSource,
      type: txType
    };

    state.transactions.unshift(newTx);
    saveStoredState({ transactions: state.transactions });

    track('expense_added', {
      category: category.toLowerCase(),
      method: expenseLoggerMethod
    });

    expenseLoggerMethod = 'manual';
    pendingReceiptMeta = null;
    inputItemName.value = '';
    inputItemAmount.value = '';
    renderAll();
    const ledgerContainer = document.getElementById('transactions-tbody')?.closest('div') as HTMLElement | null;
    showContextualFeedback(ledgerContainer || document.getElementById('tab-view-tracker'));
  });

  // Preset Chips
  presetChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      pendingReceiptMeta = null;
      expenseLoggerMethod = 'preset';
      const name = chip.getAttribute('data-preset-name');
      const amount = chip.getAttribute('data-preset-amount');
      const cat = chip.getAttribute('data-preset-category');

      if (name && inputItemName) inputItemName.value = name;
      if (amount && inputItemAmount) inputItemAmount.value = amount;
      if (cat && selectItemCategory) selectItemCategory.value = cat;

      inputItemAmount?.focus();
    });
  });

  inputItemName?.addEventListener('input', () => { expenseLoggerMethod = 'manual'; });
  inputItemAmount?.addEventListener('input', () => { expenseLoggerMethod = 'manual'; });

  // Clear Quick Expense Logger entry
  btnClearLogger?.addEventListener('click', () => {
    expenseLoggerMethod = 'manual';
    pendingReceiptMeta = null;
    if (inputItemName) inputItemName.value = '';
    if (inputItemAmount) inputItemAmount.value = '';
    if (selectItemCategory) selectItemCategory.value = 'Food';
    if (inputReceiptPhoto) inputReceiptPhoto.value = '';
    receiptScanningIndicator?.classList.add('hidden');
    if (receiptOcrProgress) receiptOcrProgress.textContent = '0%';
  });

  // Receipt Photo OCR Scanner from Quick Logger
  btnScanReceiptLogger?.addEventListener('click', () => {
    inputReceiptPhoto?.click();
  });

  inputReceiptPhoto?.addEventListener('change', async () => {
    if (!inputReceiptPhoto.files || inputReceiptPhoto.files.length === 0) return;
    const file = inputReceiptPhoto.files[0];

    receiptScanningIndicator?.classList.remove('hidden');
    if (receiptOcrProgress) receiptOcrProgress.textContent = '10%';

    try {
      const { scanReceiptImage } = await import('../utils/receiptScanner');
      const result = await scanReceiptImage(file, (progress) => {
        if (receiptOcrProgress) receiptOcrProgress.textContent = `${progress}%`;
      });

      if (inputItemName) inputItemName.value = result.merchantName;
      if (inputItemAmount) inputItemAmount.value = result.amount > 0 ? result.amount.toString() : '';
      if (selectItemCategory) selectItemCategory.value = result.category;

      pendingReceiptMeta = {
        date: result.date || undefined,
        type: result.type || 'expense',
        source: 'imported'
      };

      inputItemAmount?.focus();
      track('receipt_scanned', { success: true });
    } catch (err: any) {
      track('receipt_scanned', { success: false });
      alert(err.message || 'Failed to scan receipt image. Please ensure image is well-lit and legible.');
    } finally {
      receiptScanningIndicator?.classList.add('hidden');
      inputReceiptPhoto.value = '';
    }
