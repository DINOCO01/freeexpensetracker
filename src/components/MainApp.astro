  // --- Goal Contribution Modal Engine ---
  let isSubmittingContrib = false;

  function openContributionModal(goalId: string, defaultDate?: string, openPlanEdit = false, editContribId?: string) {
    const goal = goals.find((g) => g.id === goalId);
    if (!goal || !goalContributionModal) return;

    if (inputContribGoalId) inputContribGoalId.value = goal.id;
    if (modalContribGoalName) modalContribGoalName.textContent = goal.name;
    if (displayContribPlanned) displayContribPlanned.textContent = formatMoney(goal.monthly);

    // Calculate total saved and remaining for this goal
    const startingAmount = typeof goal.initialAmount === 'number' ? goal.initialAmount : (goal.current || 0);
    const contribs = Array.isArray(goal.contributions) ? goal.contributions : [];
    const totalActual = contribs.reduce((sum, c) => sum + (Number(c.actual) || 0), 0);
    const totalSaved = startingAmount + totalActual;
    const remaining = Math.max(0, goal.target - totalSaved);
    if (displayContribRemaining) displayContribRemaining.textContent = formatMoney(remaining);

    const todayStr = new Date().toISOString().split('T')[0];

    if (editContribId) {
      const existingEntry = contribs.find((c) => c.id === editContribId);
      if (existingEntry) {
        if (inputContribEntryId) inputContribEntryId.value = existingEntry.id || editContribId;
        if (inputContribDate) inputContribDate.value = existingEntry.date || `${existingEntry.month}-01`;
        if (inputContribActual) inputContribActual.value = existingEntry.actual.toString();
        if (modalContributionTitle) modalContributionTitle.textContent = 'Edit Contribution';
        if (btnSubmitContribution) btnSubmitContribution.textContent = 'Update Contribution';
      }
    } else {
      if (inputContribEntryId) inputContribEntryId.value = '';
      if (inputContribDate) inputContribDate.value = defaultDate || todayStr;
      if (inputContribActual) inputContribActual.value = '';
      if (modalContributionTitle) modalContributionTitle.textContent = 'Record Contribution';
      if (btnSubmitContribution) btnSubmitContribution.textContent = 'Add Contribution';
    }

    updateContributionFeedback(goal);

    // Plan edit container
    if (containerEditPlan) {
      if (openPlanEdit) {
        containerEditPlan.classList.remove('hidden');
        if (inputEditPlanValue) {
          inputEditPlanValue.value = goal.monthly.toString();
          inputEditPlanValue.focus();
        }
      } else {
        containerEditPlan.classList.add('hidden');
      }
    }

    if (contribErrorMsg) {
      contribErrorMsg.textContent = '';
      contribErrorMsg.classList.add('hidden');
    }

    isSubmittingContrib = false;
    if (btnSubmitContribution) btnSubmitContribution.disabled = false;
    goalContributionModal.classList.remove('hidden');
  }

  function closeContributionModal() {
    goalContributionModal?.classList.add('hidden');
    if (contribErrorMsg) contribErrorMsg.classList.add('hidden');
    if (contribDiffFeedback) contribDiffFeedback.classList.add('hidden');
    if (containerEditPlan) containerEditPlan.classList.add('hidden');
    isSubmittingContrib = false;
    if (btnSubmitContribution) btnSubmitContribution.disabled = false;
  }

  function updateContributionFeedback(goal: GoalItem) {
    const selectedDate = inputContribDate?.value || new Date().toISOString().split('T')[0];
    const selectedMonth = selectedDate.slice(0, 7);
    const editingId = inputContribEntryId?.value;

    // Calculate how much has ALREADY been contributed in this selected month (excluding the one being edited, if any)
    const existingMonthContributions = (goal.contributions || [])
      .filter((c) => (c.month || c.date?.slice(0, 7)) === selectedMonth && c.id !== editingId)
      .reduce((sum, c) => sum + (Number(c.actual) || 0), 0);

    if (displayContribMonthActual) {
      displayContribMonthActual.textContent = formatMoney(existingMonthContributions);
    }

    if (!contribDiffFeedback || !inputContribActual) return;
    const actualStr = inputContribActual.value.trim();
    if (!actualStr) {
      contribDiffFeedback.className = 'hidden';
      contribDiffFeedback.textContent = '';
      return;
    }
    const enteredAmount = parseFloat(actualStr);
    if (isNaN(enteredAmount) || enteredAmount <= 0) {
      contribDiffFeedback.className = 'hidden';
      contribDiffFeedback.textContent = '';
      return;
    }

    const monthName = formatMonthYear(selectedMonth);
    const newMonthTotal = existingMonthContributions + enteredAmount;
    const planned = goal.monthly;
    const diff = newMonthTotal - planned;

    if (diff < 0) {
      contribDiffFeedback.textContent = `With this contribution, ${monthName} total will be ${formatMoney(newMonthTotal)} (${formatMoney(Math.abs(diff))} below planned allocation).`;
      contribDiffFeedback.className = 'text-xs p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 block';
    } else if (diff > 0) {
      contribDiffFeedback.textContent = `With this contribution, ${monthName} total will be ${formatMoney(newMonthTotal)} (${formatMoney(diff)} above planned allocation).`;
      contribDiffFeedback.className = 'text-xs p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 block';
    } else {
