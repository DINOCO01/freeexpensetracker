    showContextualFeedback(ledgerContainer || document.getElementById('tab-view-tracker'));
  });

  btnTabApplyAppend?.addEventListener('click', () => {
    if (!pendingTabImportResult) return;
    state.transactions = [...pendingTabImportResult.transactions, ...state.transactions];
    saveStoredState({ transactions: state.transactions });
    renderAll();
    switchTab('tracker');
    const anchor = document.getElementById('live-tool-anchor');
    anchor?.scrollIntoView({ behavior: 'smooth' });
    const ledgerContainer = document.getElementById('transactions-tbody')?.closest('div') as HTMLElement | null;
    showContextualFeedback(ledgerContainer || document.getElementById('tab-view-tracker'));
  });

  btnTabResetImport?.addEventListener('click', () => {
    pendingTabImportResult = null;
    if (tabImporterResults) tabImporterResults.classList.add('hidden');
    if (tabImporterFileInput) tabImporterFileInput.value = '';
    if (tabImporterError) tabImporterError.classList.add('hidden');
  });

  const TAB_PARAM_MAP: Record<string, string> = {
    'tracker': 'live_tracker',
    'templates': 'templates',
    'debt': 'debt_planner',
    'targets': 'budget_goals',
    'knowledge': 'guides'
  };
  let currentActiveTab = 'tracker';

  // Tab Navigation
  function switchTab(tabId: string) {
    if (tabId !== currentActiveTab && TAB_PARAM_MAP[tabId]) {
      track('tab_opened', { tab: TAB_PARAM_MAP[tabId] });
      currentActiveTab = tabId;
    } else if (tabId) {
      currentActiveTab = tabId;
    }
    tabButtons.forEach((btn) => {
      const target = btn.getAttribute('data-tab');
      const isCapsule = btn.classList.contains('capsule-tab-btn');
      const isMobileKnowledge = btn.classList.contains('mobile-tab-knowledge');
      const mobileOnlyClass = isMobileKnowledge ? 'mobile-tab-knowledge sm:hidden ' : '';

      if (target === tabId) {
        if (isCapsule) {
          btn.className = 'tab-btn active capsule-tab-btn min-h-[36px] sm:min-h-[38px] px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all bg-emerald-700 text-white border border-emerald-800 shadow-xs cursor-pointer text-left shrink truncate';
        } else {
          btn.className = `tab-btn active ${mobileOnlyClass}shrink-0 whitespace-nowrap sm:w-full min-h-[38px] sm:min-h-[44px] px-3 py-2 sm:py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between gap-1.5 transition-all bg-white dark:bg-slate-800 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-600 shadow-2xs cursor-pointer text-left`;
        }
      } else {
        if (isCapsule) {
          btn.className = 'tab-btn capsule-tab-btn min-h-[36px] sm:min-h-[38px] px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-medium flex items-center gap-1.5 transition-all bg-slate-200/60 hover:bg-slate-200 dark:bg-slate-800/60 dark:hover:bg-slate-800 text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100 border border-slate-200/80 dark:border-slate-700/80 shadow-2xs cursor-pointer text-left shrink truncate';
        } else {
          btn.className = `tab-btn ${mobileOnlyClass}shrink-0 whitespace-nowrap sm:w-full min-h-[38px] sm:min-h-[44px] px-3 py-2 sm:py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between gap-1.5 transition-all bg-white/70 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200/80 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 shadow-2xs cursor-pointer text-left`;
        }
      }
    });

    if (btnOpenImporterNav) {
      if (tabId === 'import') {
        btnOpenImporterNav.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-700 text-white border border-emerald-800 transition-all shadow-xs cursor-pointer';
      } else {
        btnOpenImporterNav.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-all shadow-2xs cursor-pointer';
      }
    }

    tabViews.forEach((view) => {
      if (view.id === `tab-view-${tabId}`) {
        view.classList.remove('hidden');
      } else {
        view.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  // --- Check URL Query Parameters for Tab & Preset Selection on Page Load ---
  (function handleQueryDeepLinks() {
    try {
      if (typeof window === 'undefined' || !window.location || !window.location.search) return;
      var urlParams = new URLSearchParams(window.location.search);
      var requestedTab = urlParams.get('tab');
      var requestedPreset = urlParams.get('preset');

      if (requestedTab) {
        var tabAliases = {
          'debt': 'debt',
          'goals': 'targets',
          'targets': 'targets',
          'budget': 'tracker',
          'tracker': 'tracker',
          'live_tracker': 'tracker',
          'templates': 'templates',
          'import': 'import',
          'knowledge': 'knowledge'
        };
        var lowerTab = (requestedTab || '').toLowerCase();
        var mappedTab = tabAliases[lowerTab];
        if (mappedTab && typeof switchTab === 'function') {
          switchTab(mappedTab);
          if (requestedPreset) {
            var p = (requestedPreset || '').toLowerCase();
            setTimeout(function() {
              try {
                if (mappedTab === 'debt') {
                  if (p === 'snowball') {
                    var btnSnow = document.getElementById('btn-strat-snowball');
                    if (btnSnow && typeof btnSnow.click === 'function') btnSnow.click();
                  } else if (p === 'avalanche') {
                    var btnAva = document.getElementById('btn-strat-avalanche');
                    if (btnAva && typeof btnAva.click === 'function') btnAva.click();
                  }
                  var tabDebt = document.getElementById('tab-view-debt');
                  if (tabDebt && typeof tabDebt.scrollIntoView === 'function') {
                    tabDebt.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  }
                } else if (mappedTab === 'targets') {
                  if (p === 'emergency-fund') {
                    var efundCard = document.getElementById('target-efund-3mo');
                    var cardParent = efundCard ? efundCard.closest('div') : null;
                    if (cardParent && typeof cardParent.scrollIntoView === 'function') {
                      cardParent.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                  } else {
                    var tabTargets = document.getElementById('tab-view-targets');
                    if (tabTargets && typeof tabTargets.scrollIntoView === 'function') {
                      tabTargets.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                  }
                } else if (mappedTab === 'tracker') {
                  if (p === 'paycheck') {
                    var inputInc = document.getElementById('input-income');
                    if (inputInc && typeof inputInc.scrollIntoView === 'function') {
                      inputInc.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                  }
                }
              } catch (_) {}
            }, 150);
          }
        }
      }
    } catch (_) {
      // Ignore unknown or inaccessible search parameters safely
    }
  })();

  // Universal handler: Scroll to Live Tracker from ANY tab or link
  const scrollToLiveTrackerElements = document.querySelectorAll('a[href="#live-tool-anchor"], #btn-scroll-to-live-tracker');
  scrollToLiveTrackerElements.forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab('tracker');
      setTimeout(() => {
        const anchor = document.getElementById('live-tool-anchor');
        if (anchor) {
          anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          document.getElementById('tab-view-tracker')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 50);
    });
  });

  // Universal handler: Switch and scroll to tabs when internal anchor links are clicked
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#tab-view-"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const hash = link.getAttribute('href');
      if (!hash) return;
      const tabName = hash.replace('#tab-view-', '');
      if (tabName) {
        e.preventDefault();
        switchTab(tabName);
        setTimeout(() => {
          const targetView = document.getElementById(`tab-view-${tabName}`);
          targetView?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);
      }
    });
  });

  // --- Templates Hub Handlers ---
  const tmplFilterBtns = document.querySelectorAll('.btn-tmpl-filter');
  const templateCards = document.querySelectorAll('.template-card');
  const inputSearchTemplates = document.getElementById('input-search-templates') as HTMLInputElement;
  const templatesEmptyState = document.getElementById('templates-empty-state');
  const btnTriggerTemplates = document.querySelectorAll('.btn-trigger-template');
  const btnSwitchToImporterFromTemplates = document.getElementById('btn-switch-to-importer-from-templates');

  let currentTmplFilter = 'all';

  function filterTemplates() {
    const query = (inputSearchTemplates?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    templateCards.forEach((card) => {
      const cat = card.getAttribute('data-category') || '';
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';

      const matchesCat = currentTmplFilter === 'all' || cat === currentTmplFilter;
      const matchesQuery = !query || title.includes(query) || desc.includes(query) || cat.includes(query);

      if (matchesCat && matchesQuery) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (templatesEmptyState) {
      if (visibleCount === 0) {
        templatesEmptyState.classList.remove('hidden');
      } else {
        templatesEmptyState.classList.add('hidden');
      }
    }
  }

  tmplFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentTmplFilter = btn.getAttribute('data-template-filter') || 'all';
      tmplFilterBtns.forEach((b) => {
        b.className = 'btn-tmpl-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer whitespace-nowrap flex items-center gap-1.5';
      });
      btn.className = 'btn-tmpl-filter active px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-700 text-white shadow-2xs cursor-pointer whitespace-nowrap flex items-center gap-1.5';
      filterTemplates();
    });
  });

  inputSearchTemplates?.addEventListener('input', () => {
    filterTemplates();
  });

  btnTriggerTemplates.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tmplId = btn.getAttribute('data-id') || '';
      const tmplType = btn.getAttribute('data-type');
      const tmplUrl = btn.getAttribute('data-url');

      if (tmplType === 'google-sheet' && tmplUrl) {
        track('template_sheet_opened', { template_name: tmplId });
        window.open(tmplUrl, '_blank', 'noopener,noreferrer');
      } else if (tmplType === 'excel-download') {
        generateExcelTemplate(tmplId);
      } else if (tmplType === 'printable') {
        openPrintableDocument(tmplId);
      }
    });
  });

  btnSwitchToImporterFromTemplates?.addEventListener('click', () => {
    switchTab('import');
    const tabImportEl = document.getElementById('tab-view-import');
    tabImportEl?.scrollIntoView({ behavior: 'smooth' });
  });

  // Template Google Sheets Open Tracking
  document.querySelectorAll<HTMLAnchorElement>('.btn-open-google-sheets').forEach((link) => {
    link.addEventListener('click', () => {
      const tmplName = link.getAttribute('data-template-name') || link.getAttribute('data-id') || 'template';
      track('template_sheet_opened', { template_name: tmplName });
    });
  });

  // --- Contextual Feedback Flow ---
  function showContextualFeedback(targetContainer: HTMLElement | null) {
    const feedbackEl = document.getElementById('contextual-feedback');
    if (!feedbackEl || !targetContainer) return;
    targetContainer.appendChild(feedbackEl);
    feedbackEl.classList.remove('hidden');

    try {
      sessionStorage.setItem('fet_activity_completed', 'true');
    } catch (_) {}
    if (typeof (window as any).fetMarkActivityCompleted === 'function') {
      (window as any).fetMarkActivityCompleted();
    }
  }

  const btnFeedbackYes = document.getElementById('btn-feedback-yes');
  const feedbackPrompt = document.getElementById('feedback-prompt-container');
  const feedbackConfirmation = document.getElementById('feedback-confirmation');

  btnFeedbackYes?.addEventListener('click', () => {
    if (feedbackPrompt && feedbackConfirmation) {
      feedbackPrompt.classList.add('hidden');
      feedbackConfirmation.classList.remove('hidden');
    }
  });

  // Initial Render
  renderAll();
</script>
