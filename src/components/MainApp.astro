  });

  formDebtPayment?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (isSubmittingDebtPayment) return;

    const debtId = inputDebtPaymentDebtId?.value;
    const debt = debts.find((d) => d.id === debtId);
    if (!debt) return;

    if (debt.paidOff) {
      showDebtPaymentError('This debt is already fully paid off. Reopen the account to record further payments.');
      return;
    }

    const dateVal = inputDebtPaymentDate?.value;
    if (!dateVal) {
      showDebtPaymentError('Please select a valid payment date.');
      return;
    }

    const total = parseFloat(inputDebtPaymentTotal?.value || '0');
    const principal = parseFloat(inputDebtPaymentPrincipal?.value || '0');
    const interest = parseFloat(inputDebtPaymentInterest?.value || '0');
    const extra = parseFloat(inputDebtPaymentExtra?.value || '0');
    const notes = inputDebtPaymentNotes?.value.trim() || '';

    // Validations (Requirement 11)
    if (isNaN(total) || total < 0) {
      showDebtPaymentError('Total payment amount cannot be negative.');
      return;
    }
    if (isNaN(principal) || principal < 0) {
      showDebtPaymentError('Principal paid cannot be negative.');
      return;
    }
    if (isNaN(interest) || interest < 0) {
      showDebtPaymentError('Interest paid cannot be negative.');
      return;
    }
    if (isNaN(extra) || extra < 0) {
      showDebtPaymentError('Extra pre-payment cannot be negative.');
      return;
    }

    const totalReduction = principal + extra;
    if (totalReduction <= 0) {
      showDebtPaymentError(`Principal paid or extra pre-payment must be greater than ${getCurrencySymbol()}0.`);
      return;
    }

    if (totalReduction > debt.currentOutstandingPrincipal) {
      showDebtPaymentError(
        `Total principal reduction (${formatMoney(totalReduction)}) cannot exceed current outstanding principal (${formatMoney(debt.currentOutstandingPrincipal)}).`
      );
      return;
    }

    // Accidental duplicate submission prevention
    isSubmittingDebtPayment = true;
    if (btnSaveDebtPayment) btnSaveDebtPayment.disabled = true;

    // Formula: newOutstandingPrincipal = max(0, previousOutstandingPrincipal - principalPaid - extraPrepayment)
    const newOutstandingPrincipal = Math.max(0, debt.currentOutstandingPrincipal - principal - extra);

    const paymentRecord: DebtPaymentRecord = {
      id: `pay-${debt.id}-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
      date: dateVal,
      month: dateVal.slice(0, 7),
      totalPayment: total > 0 ? total : (principal + interest + extra),
      principalPaid: principal,
      interestPaid: interest,
      extraPrepayment: extra,
      notes
    };

    debt.paymentHistory = debt.paymentHistory || [];
    debt.paymentHistory.push(paymentRecord);
    debt.currentOutstandingPrincipal = newOutstandingPrincipal;
    debt.balance = newOutstandingPrincipal;

    // When debt is fully paid (Requirement 6)
    if (newOutstandingPrincipal <= 0) {
      debt.currentOutstandingPrincipal = 0;
      debt.balance = 0;
      debt.paidOff = true;
      debt.active = false;
    }

    localStorage.setItem(DEBT_STORAGE_KEY, JSON.stringify(debts));
    closeDebtPaymentModal();
    renderAll();
    showContextualFeedback(document.getElementById('tab-view-debt'));
  });

