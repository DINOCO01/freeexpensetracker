---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
  variant?: 'all' | 'desktop' | 'mobile';
}

const { locale = DEFAULT_LOCALE, variant = 'all' } = Astro.props;
---

<!-- ========================================================================= -->
<!-- 1. MOBILE FINANCIAL HEALTH INDICATOR (Exact Mobile UI Reference Layout < 640px) -->
<!-- ========================================================================= -->
{ (variant === 'all' || variant === 'mobile') && (
<div id="financial-health-mobile-card" class="sm:hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-4 shadow-xs flex flex-col space-y-2.5">
  <!-- Card Header: Title and Status Badge (No explanatory scoring text) -->
  <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
    <div class="flex items-center gap-2 flex-wrap min-w-0">
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] tracking-tight truncate">
        {t('health.title', locale)}
      </h3>
      <span
        id="health-tier-badge-mobile"
        class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 inline-flex items-center shrink-0"
      >
        <span id="health-tier-text-mobile">{t('health.tierExcellent', locale)}</span>
      </span>
    </div>
  </div>

  <!-- Single Multicolour Circular Indicator & 3-Row Legend Beside It -->
  <div class="flex items-center gap-3 w-full py-1">
    <!-- Left: Single Multicolour Donut Chart -->
    <div class="shrink-0 flex items-center justify-center">
      <div class="relative w-[88px] h-[88px] sm:w-24 sm:h-24 flex items-center justify-center">
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
          <!-- Background track -->
          <circle
            cx="50"
            cy="50"
            r="38"
            stroke="currentColor"
            stroke-width="8.5"
            fill="transparent"
            class="text-slate-100 dark:text-slate-800"
          />
          <!-- Segment 1: Savings (Green #16A34A) -->
          <circle
            id="donut-segment-savings"
            cx="50"
            cy="50"
            r="38"
            stroke="#16A34A"
            stroke-width="8.5"
            fill="transparent"
            stroke-dasharray="92.5 146.2"
            stroke-dashoffset="0"
            stroke-linecap="round"
            class="transition-all duration-700 ease-out"
          />
          <!-- Segment 2: Essential Expenses (Blue #3B82F6) -->
          <circle
            id="donut-segment-fixed"
            cx="50"
            cy="50"
            r="38"
            stroke="#3B82F6"
            stroke-width="8.5"
            fill="transparent"
            stroke-dasharray="92.5 146.2"
            stroke-dashoffset="-95.5"
            stroke-linecap="round"
            class="transition-all duration-700 ease-out"
          />
          <!-- Segment 3: Cash Buffer (Teal #14B8A6) -->
          <circle
            id="donut-segment-buffer"
            cx="50"
            cy="50"
            r="38"
            stroke="#14B8A6"
            stroke-width="8.5"
            fill="transparent"
            stroke-dasharray="44.7 194"
            stroke-dashoffset="-191"
            stroke-linecap="round"
            class="transition-all duration-700 ease-out"
          />
        </svg>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-center select-none">
          <span id="health-score-number-mobile" class="text-lg sm:text-xl font-black font-mono text-slate-900 dark:text-slate-100 tracking-tight leading-none">
            100
          </span>
          <span class="text-[8.5px] sm:text-[9px] font-bold text-slate-400 dark:text-slate-500 tracking-tight leading-none mt-0.5">
            /100
          </span>
        </div>
      </div>
    </div>

    <!-- Right: Three Financial Categories (Vertically Stacked with Progress Bars) -->
    <div class="flex-1 min-w-0 flex flex-col justify-center space-y-1.5">
      <!-- Row 1: Savings -->
      <div class="space-y-0.5">
        <div class="flex items-center justify-between gap-1">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="w-2 h-2 rounded-full bg-[#16A34A] shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-semibold text-slate-700 dark:text-slate-300 truncate">Savings</span>
          </div>
          <span id="mobile-legend-savings-val" class="font-mono text-xs sm:text-sm font-extrabold text-slate-900 dark:text-slate-100 shrink-0">38%</span>
        </div>
        <!-- Compact horizontal progress bar -->
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1 overflow-hidden">
          <div id="mobile-bar-savings" class="h-full rounded-full bg-[#16A34A] transition-all duration-700 ease-out" style="width: 100%;"></div>
        </div>
        <div class="flex items-center">
          <span class="inline-block px-1.5 py-0.2 rounded text-[8.5px] font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 whitespace-nowrap">
            Target: ~20% of income
          </span>
        </div>
      </div>

      <!-- Row 2: Fixed Essential Expenses -->
      <div class="space-y-0.5">
        <div class="flex items-center justify-between gap-1">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="w-2 h-2 rounded-full bg-[#3B82F6] shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-semibold text-slate-700 dark:text-slate-300 truncate">Fixed Essential Expenses</span>
          </div>
          <span id="mobile-legend-fixed-val" class="font-mono text-xs sm:text-sm font-extrabold text-slate-900 dark:text-slate-100 shrink-0">48%</span>
        </div>
        <!-- Compact horizontal progress bar -->
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1 overflow-hidden">
          <div id="mobile-bar-fixed" class="h-full rounded-full bg-[#3B82F6] transition-all duration-700 ease-out" style="width: 100%;"></div>
        </div>
        <div class="flex items-center">
          <span class="inline-block px-1.5 py-0.2 rounded text-[8.5px] font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 whitespace-nowrap">
            Target: ≤50% of income
          </span>
        </div>
      </div>

      <!-- Row 3: Cashflow Buffer -->
      <div class="space-y-0.5">
        <div class="flex items-center justify-between gap-1">
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="w-2 h-2 rounded-full bg-[#14B8A6] shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-semibold text-slate-700 dark:text-slate-300 truncate">Cashflow Buffer</span>
          </div>
          <span id="mobile-legend-buffer-val" class="font-mono text-xs sm:text-sm font-extrabold text-slate-900 dark:text-slate-100 shrink-0">38%</span>
        </div>
        <!-- Compact horizontal progress bar -->
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1 overflow-hidden">
          <div id="mobile-bar-buffer" class="h-full rounded-full bg-[#14B8A6] transition-all duration-700 ease-out" style="width: 100%;"></div>
        </div>
        <div class="flex items-center">
          <span class="inline-block px-1.5 py-0.2 rounded text-[8.5px] font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 whitespace-nowrap">
            Target: 3–6 months costs
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Collapsible Accordion Toggle Button -->
  <button
    type="button"
    id="btn-toggle-health-details"
    class="flex items-center justify-between w-full py-1.5 px-3 rounded-xl bg-slate-50 dark:bg-slate-800/70 text-xs font-semibold text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer select-none min-h-[30px]"
    aria-expanded="false"
    aria-controls="health-details-content"
  >
    <span class="flex items-center gap-1.5">
      <span>📊</span>
      <span>{locale === 'en' ? 'View Breakdown & Advice' : t('health.title', locale)}</span>
    </span>
    <svg id="health-details-chevron" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Collapsible Details: Score Ranges & Tailored Advice -->
  <div id="health-details-content" class="hidden space-y-2.5 pt-1">
    <!-- Score Ranges Indicator -->
    <div class="space-y-1.5 p-2.5 rounded-xl bg-slate-50/80 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
      <div class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Score Tiers</div>
      <div class="grid grid-cols-4 gap-1 text-center text-[10px] font-medium">
        <span class="px-1 py-0.5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 font-semibold border border-rose-200 dark:border-rose-900">&lt;50</span>
        <span class="px-1 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 font-semibold border border-amber-200 dark:border-amber-900">50-69</span>
        <span class="px-1 py-0.5 rounded bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 font-semibold border border-teal-200 dark:border-teal-900">70-84</span>
        <span class="px-1 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-900">85+</span>
      </div>
    </div>

    <!-- Tailored Advice Box -->
    <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-800 space-y-1.5">
      <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        {t('health.title', locale)} Recommendations
      </h4>
      <div id="health-recommendations-list-mobile" class="space-y-1 text-[11px] text-slate-600 dark:text-slate-400 leading-snug">
        <!-- Populated dynamically via JS -->
      </div>
    </div>
  </div>
</div>
)}

<!-- ========================================================================= -->
<!-- 2. DESKTOP FINANCIAL HEALTH INDICATOR (Original Pre-Redesign Layout >= 640px) -->
<!-- ========================================================================= -->
{ (variant === 'all' || variant === 'desktop') && (
<div id="financial-health-desktop-card" class="hidden sm:flex bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs flex-col justify-between space-y-4 h-full">
  <!-- Card Header -->
  <div class="flex items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
          {t('health.title', locale)}
        </h3>
        <span
          id="health-tier-badge"
          class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800"
        >
          <span id="health-tier-text">{t('health.tierExcellent', locale)}</span>
        </span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        {t('health.subtitle', locale)}
      </p>
    </div>

    <div class="hidden sm:flex items-center gap-1 text-[11px] text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700">
      <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      {t('health.privateBadge', locale)}
    </div>
  </div>

  <!-- Dial & 3 Metrics Row -->
  <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 items-center">
    <!-- Radial Score Dial -->
    <div class="sm:col-span-5 flex flex-col items-center justify-center p-2.5 sm:p-3 bg-slate-50/80 dark:bg-slate-800/80 rounded-xl border border-slate-100 dark:border-slate-800">
      <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center">
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
          <circle
            cx="50"
            cy="50"
            r="42"
            stroke="currentColor"
            stroke-width="8"
            fill="transparent"
            class="text-slate-200 dark:text-slate-700"
          />
          <circle
            id="score-circle-stroke"
            cx="50"
            cy="50"
            r="42"
            stroke="currentColor"
            stroke-width="8"
            fill="transparent"
            stroke-dasharray="264"
            stroke-dashoffset="30"
            stroke-linecap="round"
            class="text-emerald-600 transition-all duration-700 ease-out"
          />
        </svg>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
          <span id="health-score-number" class="text-xl sm:text-2xl font-extrabold font-mono text-slate-900 dark:text-slate-100 tracking-tight">
            88
          </span>
          <span class="text-[8px] sm:text-[9px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {t('health.scoreOver100', locale)}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-4 gap-0.5 w-full mt-2 text-center text-[9px] font-medium text-slate-500 dark:text-slate-400">
        <span class="px-1 py-0.5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 font-semibold border border-rose-200 dark:border-rose-900">&lt;50</span>
        <span class="px-1 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 font-semibold border border-amber-200 dark:border-amber-900">50-69</span>
        <span class="px-1 py-0.5 rounded bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 font-semibold border border-teal-200 dark:border-teal-900">70-84</span>
        <span class="px-1 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-semibold border border-emerald-200 dark:border-emerald-900">85+</span>
      </div>
    </div>

    <!-- 3 Metric Bars -->
    <div class="sm:col-span-7 space-y-2.5">
      <!-- Metric 1: Savings Rate -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            {t('health.savingsRate', locale)} (40%)
          </span>
          <span id="score-savings-rate-label" class="font-mono text-slate-900 dark:text-slate-100 font-bold">36 / 40 pts</span>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div id="bar-savings-score" class="bg-emerald-600 h-1.5 rounded-full transition-all duration-500" style="width: 90%"></div>
        </div>
      </div>

      <!-- Metric 2: Fixed Cost Burden -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-sky-600"></span>
            {t('health.fixedCosts', locale)} (40%)
          </span>
          <span id="score-fixed-cost-label" class="font-mono text-slate-900 dark:text-slate-100 font-bold">34 / 40 pts</span>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div id="bar-fixed-score" class="bg-sky-600 h-1.5 rounded-full transition-all duration-500" style="width: 85%"></div>
        </div>
      </div>

      <!-- Metric 3: Buffer -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-teal-600"></span>
            {t('health.cashflowBuffer', locale)} (20%)
          </span>
          <span id="score-buffer-label" class="font-mono text-slate-900 dark:text-slate-100 font-bold">18 / 20 pts</span>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
          <div id="bar-buffer-score" class="bg-teal-600 h-1.5 rounded-full transition-all duration-500" style="width: 90%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tailored Advice Box -->
  <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/90 dark:border-slate-800 space-y-1.5">
    <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100 flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      {t('health.title', locale)}
    </h4>
    <div id="health-recommendations-list" class="space-y-1 text-[11px] text-slate-600 dark:text-slate-400 leading-snug">
      <!-- Populated dynamically via JS -->
    </div>
  </div>
</div>
)}

<script is:inline>
  (function initHealthAccordion() {
    const btn = document.getElementById('btn-toggle-health-details');
    const content = document.getElementById('health-details-content');
    const chevron = document.getElementById('health-details-chevron');
    if (!btn || !content) return;

    btn.addEventListener('click', () => {
      const isExpanded = !content.classList.contains('hidden');
      if (isExpanded) {
        content.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        content.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>
