---
---

<div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs flex flex-col justify-between space-y-4 h-full">
  <!-- Card Header -->
  <div class="flex items-center justify-between gap-3 border-b border-slate-100 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
          Financial Health Indicator
        </h3>
        <span
          id="health-tier-badge"
          class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-800 border border-emerald-200"
        >
          <span id="health-tier-text">Excellent</span>
        </span>
      </div>
      <p class="text-xs text-slate-500 mt-0.5">
        Savings (40%), Fixed Costs (40%), Cash Buffer (20%).
      </p>
    </div>

    <div class="hidden sm:flex items-center gap-1 text-[11px] text-slate-500 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200">
      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      100% Private
    </div>
  </div>

  <!-- Dial & 3 Metrics Row -->
  <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-4 items-center">
    <!-- Radial Score Dial -->
    <div class="sm:col-span-5 flex flex-col items-center justify-center p-2.5 sm:p-3 bg-slate-50/80 rounded-xl border border-slate-100">
      <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center">
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
          <circle
            cx="50"
            cy="50"
            r="42"
            stroke="currentColor"
            stroke-width="8"
            fill="transparent"
            class="text-slate-200"
          />
          <circle
            id="score-circle-stroke"
            cx="50"
            cy="50"
            r="42"
            stroke="currentColor"
            stroke-width="8"
            fill="transparent"
            stroke-dasharray="264"
            stroke-dashoffset="30"
            stroke-linecap="round"
            class="text-emerald-600 transition-all duration-700 ease-out"
          />
        </svg>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
          <span id="health-score-number" class="text-xl sm:text-2xl font-extrabold font-mono text-slate-900 tracking-tight">
            88
          </span>
          <span class="text-[8px] sm:text-[9px] font-semibold uppercase tracking-wider text-slate-500">
            Score / 100
          </span>
        </div>
      </div>

      <div class="grid grid-cols-4 gap-0.5 w-full mt-2 text-center text-[9px] font-medium text-slate-500">
        <span class="px-1 py-0.5 rounded bg-rose-50 text-rose-700 font-semibold border border-rose-200">&lt;50</span>
        <span class="px-1 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold border border-amber-200">50-69</span>
        <span class="px-1 py-0.5 rounded bg-teal-50 text-teal-700 font-semibold border border-teal-200">70-84</span>
        <span class="px-1 py-0.5 rounded bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">85+</span>
      </div>
    </div>

    <!-- 3 Metric Bars -->
    <div class="sm:col-span-7 space-y-2.5">
      <!-- Metric 1: Savings Rate -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            Savings Rate (40%)
          </span>
          <span id="score-savings-rate-label" class="font-mono text-slate-900 font-bold">36 / 40 pts</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
          <div id="bar-savings-score" class="bg-emerald-600 h-1.5 rounded-full transition-all duration-500" style="width: 90%"></div>
        </div>
      </div>

      <!-- Metric 2: Fixed Cost Burden -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-sky-600"></span>
            Fixed Essentials (40%)
          </span>
          <span id="score-fixed-cost-label" class="font-mono text-slate-900 font-bold">34 / 40 pts</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
          <div id="bar-fixed-score" class="bg-sky-600 h-1.5 rounded-full transition-all duration-500" style="width: 85%"></div>
        </div>
      </div>

      <!-- Metric 3: Buffer -->
      <div>
        <div class="flex justify-between text-[11px] font-semibold mb-0.5">
          <span class="text-slate-700 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-teal-600"></span>
            Cash Buffer (20%)
          </span>
          <span id="score-buffer-label" class="font-mono text-slate-900 font-bold">18 / 20 pts</span>
        </div>
        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
          <div id="bar-buffer-score" class="bg-teal-600 h-1.5 rounded-full transition-all duration-500" style="width: 90%"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tailored Advice Box -->
  <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/90 space-y-1.5">
    <h4 class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Health Assessment
    </h4>
    <div id="health-recommendations-list" class="space-y-1 text-[11px] text-slate-600 leading-snug">
      <!-- Populated dynamically via JS -->
    </div>
  </div>
</div>
