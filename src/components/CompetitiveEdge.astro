---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<div class="space-y-6">
  <!-- Comparison Matrix -->
  <div class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
      <div class="flex items-center gap-2">
        <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
          {t('competitiveEdge.title', locale)}
        </h3>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
          {t('competitiveEdge.badge', locale)}
        </span>
      </div>
      <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
        {t('competitiveEdge.subtitle', locale)}
      </p>
    </div>

    <!-- Comparison Table -->
    <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl">
      <table class="w-full min-w-[620px] text-left border-collapse text-xs">
        <thead class="bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 font-bold border-b border-slate-200 dark:border-slate-800">
          <tr>
            <th class="py-3 px-4">{t('competitiveEdge.thCriteria', locale)}</th>
            <th class="py-3 px-4 text-emerald-900 dark:text-emerald-200 bg-emerald-50/70 dark:bg-emerald-950/70">{t('competitiveEdge.thFet', locale)}</th>
            <th class="py-3 px-4 text-slate-500 dark:text-slate-400">{t('competitiveEdge.thOthers', locale)}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c1Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c1Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c1Others', locale)}
            </td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c2Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c2Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c2Others', locale)}
            </td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c3Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c3Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c3Others', locale)}
            </td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c4Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c4Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c4Others', locale)}
            </td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c5Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c5Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c5Others', locale)}
            </td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900 dark:text-slate-100">{t('competitiveEdge.c6Name', locale)}</td>
            <td class="py-3 px-4 font-semibold text-emerald-800 dark:text-emerald-200 bg-emerald-50/30 dark:bg-emerald-950/40">
              {t('competitiveEdge.c6Fet', locale)}
            </td>
            <td class="py-3 px-4 text-slate-500 dark:text-slate-400">
              {t('competitiveEdge.c6Others', locale)}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
