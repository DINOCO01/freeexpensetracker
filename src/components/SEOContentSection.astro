---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<article class="bg-white border border-slate-200 rounded-3xl p-4 sm:p-8 md:p-12 shadow-xs space-y-8 sm:space-y-10 text-slate-700 leading-relaxed font-sans">
  <!-- Article Header -->
  <header class="border-b border-slate-100 pb-6 sm:pb-8 space-y-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
      <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
      <span>{t('seoGuide.badge', locale)}</span>
    </div>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight font-['Outfit',sans-serif]">
      {t('seoGuide.title', locale)}
    </h2>
    <p class="text-sm sm:text-base text-slate-600 max-w-3xl">
      {t('seoGuide.subtitle', locale)}
    </p>
  </header>

  <!-- Section 1: The Modern Budgeting Landscape -->
  <section class="space-y-4">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec1Title', locale)}
    </h3>
    <p>
      {t('seoGuide.sec1Text1', locale)}
    </p>
    <p>
      {t('seoGuide.sec1Text2', locale)}
    </p>
  </section>

  <!-- Section 2: Why It's the Best Free Expense Tracker -->
  <section class="space-y-4">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec2Title', locale)}
    </h3>
    <p>
      {t('seoGuide.sec2Text', locale)}
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <div class="text-xl">🔒</div>
        <h4 class="font-bold text-sm text-slate-900 font-['Outfit',sans-serif]">{t('seoGuide.sec2Pillar1Title', locale)}</h4>
        <p class="text-xs text-slate-600">
          {t('seoGuide.sec2Pillar1Text', locale)}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <div class="text-xl">📸</div>
        <h4 class="font-bold text-sm text-slate-900 font-['Outfit',sans-serif]">{t('seoGuide.sec2Pillar2Title', locale)}</h4>
        <p class="text-xs text-slate-600">
          {t('seoGuide.sec2Pillar2Text', locale)}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2">
        <div class="text-xl">⚡</div>
        <h4 class="font-bold text-sm text-slate-900 font-['Outfit',sans-serif]">{t('seoGuide.sec2Pillar3Title', locale)}</h4>
        <p class="text-xs text-slate-600">
          {t('seoGuide.sec2Pillar3Text', locale)}
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Web App vs Sheets vs Excel Spreadsheets -->
  <section class="space-y-4">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec3Title', locale)}
    </h3>
    <p>
      {t('seoGuide.sec3Text', locale)}
    </p>

    <div class="overflow-x-auto border border-slate-200 rounded-2xl">
      <table class="w-full min-w-[620px] text-xs text-left">
        <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">{t('seoGuide.tableMethod', locale)}</th>
            <th class="py-3 px-4">{t('seoGuide.tableAdvantages', locale)}</th>
            <th class="py-3 px-4">{t('seoGuide.tableSoftware', locale)}</th>
            <th class="py-3 px-4">{t('seoGuide.tableIdealFor', locale)}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">{t('seoGuide.m1Name', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m1Adv', locale)}</td>
            <td class="py-3 px-4 font-mono text-slate-600">{t('seoGuide.m1Soft', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m1Ideal', locale)}</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">{t('seoGuide.m2Name', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m2Adv', locale)}</td>
            <td class="py-3 px-4 font-mono text-slate-600">{t('seoGuide.m2Soft', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m2Ideal', locale)}</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">{t('seoGuide.m3Name', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m3Adv', locale)}</td>
            <td class="py-3 px-4 font-mono text-slate-600">{t('seoGuide.m3Soft', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m3Ideal', locale)}</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-bold text-slate-900">{t('seoGuide.m4Name', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m4Adv', locale)}</td>
            <td class="py-3 px-4 font-mono text-slate-600">{t('seoGuide.m4Soft', locale)}</td>
            <td class="py-3 px-4">{t('seoGuide.m4Ideal', locale)}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-xs text-slate-600">
      {t('seoGuide.sec3Note', locale)}
    </p>
  </section>

  <!-- Section 4: Practical Financial Strategy Guide -->
  <section class="space-y-4">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec4Title', locale)}
    </h3>
    <p>
      {t('seoGuide.sec4Text', locale)}
    </p>

    <div class="space-y-3">
      <div class="flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
        <div>
          <strong class="text-slate-900 text-sm">{t('seoGuide.step1Title', locale)}:</strong>
          <p class="text-xs text-slate-600 mt-0.5">
            {t('seoGuide.step1Desc', locale)}
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
        <div>
          <strong class="text-slate-900 text-sm">{t('seoGuide.step2Title', locale)}:</strong>
          <p class="text-xs text-slate-600 mt-0.5">
            {t('seoGuide.step2Desc', locale)}
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
        <div>
          <strong class="text-slate-900 text-sm">{t('seoGuide.step3Title', locale)}:</strong>
          <p class="text-xs text-slate-600 mt-0.5">
            {t('seoGuide.step3Desc', locale)}
          </p>
        </div>
      </div>

      <div class="flex items-start gap-3">
        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">4</span>
        <div>
          <strong class="text-slate-900 text-sm">{t('seoGuide.step4Title', locale)}:</strong>
          <p class="text-xs text-slate-600 mt-0.5">
            {t('seoGuide.step4Desc', locale)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Universal Importer & Multi-Format Ease -->
  <section class="space-y-4">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec5Title', locale)}
    </h3>
    <p>
      {t('seoGuide.sec5Text', locale)}
    </p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700">
      <li class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-emerald-600 font-bold">✓</span>
        <span>{t('seoGuide.sec5Item1', locale)}</span>
      </li>
      <li class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-emerald-600 font-bold">✓</span>
        <span>{t('seoGuide.sec5Item2', locale)}</span>
      </li>
      <li class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-emerald-600 font-bold">✓</span>
        <span>{t('seoGuide.sec5Item3', locale)}</span>
      </li>
      <li class="flex items-center gap-2 p-2 rounded-xl bg-slate-50 border border-slate-200">
        <span class="text-emerald-600 font-bold">✓</span>
        <span>{t('seoGuide.sec5Item4', locale)}</span>
      </li>
    </ul>
    <p class="text-xs text-slate-600">
      {t('seoGuide.sec5Note', locale)}
    </p>
  </section>

  <!-- Section 6: Frequently Asked Questions (FAQ) -->
  <section class="space-y-4 border-t border-slate-100 pt-8">
    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
      {t('seoGuide.sec6Title', locale)}
    </h3>

    <div class="space-y-3">
      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
        <h4 class="font-bold text-sm text-slate-900">{t('seoGuide.faq1Q', locale)}</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          {t('seoGuide.faq1A', locale)}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
        <h4 class="font-bold text-sm text-slate-900">{t('seoGuide.faq2Q', locale)}</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          {t('seoGuide.faq2A', locale)}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
        <h4 class="font-bold text-sm text-slate-900">{t('seoGuide.faq3Q', locale)}</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          {t('seoGuide.faq3A', locale)}
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1.5">
        <h4 class="font-bold text-sm text-slate-900">{t('seoGuide.faq4Q', locale)}</h4>
        <p class="text-xs text-slate-600 leading-relaxed">
          {t('seoGuide.faq4A', locale)}
        </p>
      </div>
    </div>
  </section>

  <!-- Article Footer Summary -->
  <footer class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="space-y-0.5">
      <strong class="font-bold text-sm">{t('seoGuide.ctaTitle', locale)}</strong>
      <p class="text-emerald-800">{t('seoGuide.ctaSubtitle', locale)}</p>
    </div>
    <a
      href="#live-tool-anchor"
      id="btn-scroll-to-live-tracker"
      class="shrink-0 px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-800 hover:bg-emerald-900 transition-colors shadow-2xs"
    >
      {t('seoGuide.ctaButton', locale)}
    </a>
  </footer>
</article>
