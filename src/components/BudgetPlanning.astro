---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<div class="space-y-6">
  <!-- Target Planning Header -->
  <div class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
      <div>
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] flex items-center gap-2">
          <span>🎯</span> {t('budget.title', locale)}
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
          {t('budget.subtitle', locale)}
        </p>
      </div>

      <!-- Quick Add Goal trigger -->
      <button
        type="button"
        id="btn-scroll-to-add-goal"
        class="text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-700 px-3.5 py-1.5 rounded-xl transition-colors cursor-pointer shadow-2xs flex items-center gap-1.5 shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        {t('budget.btnNewGoal', locale)}
      </button>
    </div>

    <!-- Automated Emergency Fund Benchmark Card -->
    <div class="p-4 rounded-xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 dark:from-emerald-950/40 dark:via-teal-950/30 dark:to-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 bg-emerald-100/80 dark:bg-emerald-900/60 px-2 py-0.5 rounded">
          {t('budget.benchmarkTitle', locale)}
        </span>
        <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-1">{t('budget.efundTitle', locale)}</h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
          {t('budget.efundSub', locale, { amount: '' })} (<span id="efund-monthly-outflow" class="font-bold font-mono text-slate-900 dark:text-slate-100">₹0/mo</span>).
        </p>
      </div>

      <div class="p-3 bg-white dark:bg-slate-800/90 rounded-xl border border-emerald-200/80 dark:border-emerald-800/50 text-center shadow-2xs">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">{t('budget.safetyNet3mo', locale)}</div>
        <div id="target-efund-3mo" class="text-lg font-bold font-mono text-slate-900 dark:text-slate-100">₹0</div>
        <div class="text-[10px] text-slate-600 dark:text-slate-400">{t('budget.safetyNet3moSub', locale)}</div>
      </div>

      <div class="p-3 bg-white dark:bg-slate-800/90 rounded-xl border border-emerald-200/80 dark:border-emerald-800/50 text-center shadow-2xs">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">{t('budget.shield6mo', locale)}</div>
        <div id="target-efund-6mo" class="text-lg font-bold font-mono text-emerald-700 dark:text-emerald-300">₹0</div>
        <div class="text-[10px] text-slate-600 dark:text-slate-400">{t('budget.shield6moSub', locale)}</div>
      </div>
    </div>
  </div>

  <!-- Active Target Goals Grid -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
        {t('budget.activeGoalsTitle', locale)}
      </h3>
      <span class="text-xs text-slate-500 dark:text-slate-400">{t('budget.activeGoalsSub', locale)}</span>
    </div>

    <div id="goals-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Populated dynamically via JS -->
    </div>
  </div>

  <!-- Add New Goal Form -->
  <div id="section-add-goal" class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
    <div class="border-b border-slate-100 dark:border-slate-800 pb-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] flex items-center gap-2">
        <span>➕</span> {t('budget.btnAddGoal', locale)}
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
        {t('budget.subtitle', locale)}
      </p>
    </div>

    <form id="form-add-goal" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
      <div>
        <label for="input-goal-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">{t('budget.goalName', locale)}</label>
        <input
          type="text"
          id="input-goal-name"
          required
          placeholder={t('budget.goalNamePlaceholder', locale)}
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs text-slate-900 font-medium placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-600 focus:outline-none"
        />
      </div>

      <div>
        <label for="input-goal-target" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('budget.targetAmount', locale)} (<span class="currency-label font-mono">₹</span>)
        </label>
        <input
          type="number"
          id="input-goal-target"
          required
          min="0"
          max="10000000"
          step="any"
          placeholder="1000000"
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-600 focus:outline-none"
        />
      </div>

      <div>
        <label for="input-goal-current" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('budget.currentAmount', locale)} (<span class="currency-label font-mono">₹</span>)
        </label>
        <input
          type="number"
          id="input-goal-current"
          required
          min="0"
          max="10000000"
          step="any"
          placeholder="250000"
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-600 focus:outline-none"
        />
      </div>

      <div>
        <label for="input-goal-monthly" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('budget.monthlyContribution', locale)} (<span class="currency-label font-mono">₹</span>)
        </label>
        <input
          type="number"
          id="input-goal-monthly"
          required
          min="0"
          max="10000000"
          step="any"
          placeholder="15000"
          class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-600 focus:outline-none"
        />
      </div>

      <div class="sm:col-span-2 lg:col-span-4 flex justify-end">
        <button
          type="submit"
          class="py-2.5 px-6 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-700 transition-colors shadow-xs cursor-pointer"
        >
          {t('budget.btnAddGoal', locale)}
        </button>
      </div>
    </form>
  </div>
</div>
