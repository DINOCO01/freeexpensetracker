---
import { DEFAULT_LOCALE, type SupportedLocale } from "../locales";

interface Props {
  locale?: SupportedLocale;
  isStandalone?: boolean;
  initialActiveTab?: string;
}

const {
  locale = DEFAULT_LOCALE,
  isStandalone = false,
  initialActiveTab = "tracker",
} = Astro.props;

const labels = {
  tracker: "Tracker",
  split: "Split",
  templates: "Templates",
  debt: "Debt",
  goals: "Goals",
  more: "More",
};

const basePrefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;

const activeIdx =
  initialActiveTab === "split"
    ? 1
    : initialActiveTab === "templates"
      ? 2
      : initialActiveTab === "debt"
        ? 3
        : initialActiveTab === "targets" || initialActiveTab === "goals"
          ? 4
          : initialActiveTab === "more"
            ? 5
            : 0;
---

<!-- Mobile Liquid Glass Bottom Navigation Bar (sm:hidden) -->
<nav
  id="mobile-bottom-nav"
  aria-label="Mobile Bottom Navigation"
  class="no-print sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/80 dark:bg-slate-950/80 backdrop-blur-xl border-t border-slate-200/80 dark:border-slate-800/80 shadow-[0_-8px_30px_rgba(0,0,0,0.08)] select-none transition-all"
  style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom, 0px));"
>
  <div class="relative max-w-lg mx-auto px-1 pt-1.5 pb-0.5">
    <!-- Active Pill Sliding Liquid Glass Indicator -->
    <div
      id="bottom-nav-active-pill"
      class="absolute top-1.5 h-[50px] rounded-xl bg-emerald-500/15 dark:bg-emerald-400/20 border border-emerald-500/30 dark:border-emerald-400/30 transition-all duration-300 ease-out pointer-events-none shadow-xs"
      style={`left: calc(${activeIdx} * (100% / 6)); width: calc(100% / 6);`}
    ></div>

    <!-- 6 Navigation Buttons Grid -->
    <div
      class="grid grid-cols-6 relative z-10"
      id="bottom-nav-buttons-container"
      data-is-standalone={isStandalone ? "true" : "false"}
      data-initial-index={activeIdx}
    >
      <!-- 1. Tracker -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=tracker`}
          data-bottom-tab="tracker"
          data-index="0"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer no-underline ${activeIdx === 0 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Live Expense Tracker"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">
            {labels.tracker}
          </span>
        </a>
      ) : (
        <button
          type="button"
          data-bottom-tab="tracker"
          data-index="0"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 0 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Live Expense Tracker"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">
            {labels.tracker}
          </span>
        </button>
      )}

      <!-- 2. Split (Bill Splitter) -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=split`}
          data-bottom-tab="split"
          data-index="1"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer no-underline ${activeIdx === 1 ? 'active text-emerald-700 dark:text-emerald-400 font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'}`}
          aria-label="Bill Splitter"
        >
          <svg class="w-5 h-5 mb-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.split}</span>
        </a>
      ) : (
        <button
          type="button"
          data-bottom-tab="split"
          data-index="1"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 1 ? 'active text-emerald-700 dark:text-emerald-400 font-bold' : 'text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium'}`}
          aria-label="Bill Splitter"
        >
          <svg class="w-5 h-5 mb-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.split}</span>
        </button>
      )}

      <!-- 3. Templates -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=templates`}
          data-bottom-tab="templates"
          data-index="2"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer no-underline ${activeIdx === 2 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Financial Templates"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">
            {labels.templates}
          </span>
        </a>
      ) : (
        <button
          type="button"
          data-bottom-tab="templates"
          data-index="2"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 2 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Financial Templates"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">
            {labels.templates}
          </span>
        </button>
      )}

      <!-- 4. Debt -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=debt`}
          data-bottom-tab="debt"
          data-index="3"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer no-underline ${activeIdx === 3 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Debt Planner"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.debt}</span>
        </a>
      ) : (
        <button
          type="button"
          data-bottom-tab="debt"
          data-index="3"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 3 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Debt Planner"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.debt}</span>
        </button>
      )}

      <!-- 5. Goals -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=targets`}
          data-bottom-tab="targets"
          data-index="4"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer no-underline ${activeIdx === 4 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Budget and Goals"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.goals}</span>
        </a>
      ) : (
        <button
          type="button"
          data-bottom-tab="targets"
          data-index="4"
          class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 4 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
          aria-label="Budget and Goals"
        >
          <svg
            class="w-5 h-5 mb-0.5 shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          <span class="text-[10px] leading-tight truncate">{labels.goals}</span>
        </button>
      )}

      <!-- 6. More (Opens Bottom Sheet) -->
      <button
        type="button"
        id="btn-bottom-nav-more"
        data-bottom-tab="more"
        data-index="5"
        class={`bottom-nav-btn flex flex-col items-center justify-center py-1 px-0.5 rounded-xl min-h-[50px] transition-colors cursor-pointer ${activeIdx === 5 ? "active text-emerald-700 dark:text-emerald-400 font-bold" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium"}`}
        aria-label="More Menu"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg
          class="w-5 h-5 mb-0.5 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <span class="text-[10px] leading-tight truncate">{labels.more}</span>
      </button>
    </div>
  </div>
</nav>

<!-- More Menu Bottom Sheet Overlay -->
<div
  id="more-menu-backdrop"
  class="no-print sm:hidden fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden transition-opacity duration-200 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<div
  id="more-menu-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="More Tools and Navigation"
  aria-hidden="true"
  class="no-print sm:hidden fixed inset-x-0 bottom-0 z-50 max-h-[85vh] bg-white dark:bg-slate-900 rounded-t-3xl border-t border-slate-200 dark:border-slate-800 shadow-2xl translate-y-full transition-transform duration-300 ease-out flex flex-col overflow-hidden hidden pointer-events-none"
  style="padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));"
>
  <!-- Handle Bar -->
  <div class="pt-3 pb-1 cursor-grab active:cursor-grabbing flex justify-center">
    <div class="w-10 h-1 rounded-full bg-slate-300 dark:bg-slate-700"></div>
  </div>

  <!-- Header -->
  <div class="flex items-center justify-between px-5 py-2.5 border-b border-slate-100 dark:border-slate-800">
    <div class="flex items-center gap-2">
      <span class="text-base">✨</span>
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
        More Tools & Resources
      </h3>
    </div>
    <button
      type="button"
      id="btn-close-more-sheet"
      class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
      aria-label="Close More Menu"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Sheet Scrollable Content -->
  <div class="overflow-y-auto px-5 py-4 space-y-4 no-scrollbar">
    <!-- Primary Features in More -->
    <div class="space-y-2">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        Tools & Features
      </p>

      <!-- Knowledge & Guides -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=knowledge`}
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group no-underline"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              📚
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                Knowledge & Guides
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">
                Personal finance rules, 50/30/20 guides & budgeting tips
              </div>
            </div>
          </div>
          <svg
            class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      ) : (
        <button
          type="button"
          data-more-action="knowledge"
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              📚
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                Knowledge & Guides
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">
                Personal finance rules, 50/30/20 guides & budgeting tips
              </div>
            </div>
          </div>
          <svg
            class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </button>
      )}

      <!-- Statement & Receipt Importer -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=import`}
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group no-underline"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-sky-100 dark:bg-sky-900/60 text-sky-700 dark:text-sky-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              📥
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                Universal Statement Importer
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">
                Auto-parse bank statements (PDF, CSV, Excel & receipts)
              </div>
            </div>
          </div>
          <svg
            class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      ) : (
        <button
          type="button"
          data-more-action="import"
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-sky-100 dark:bg-sky-900/60 text-sky-700 dark:text-sky-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              📥
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                Universal Statement Importer
              </div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">
                Auto-parse bank statements (PDF, CSV, Excel & receipts)
              </div>
            </div>
          </div>
          <svg
            class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </button>
      )}

      <!-- 62 Spreadsheet & Printable Templates -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=templates`}
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group no-underline"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              📋
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
                62 Free Financial Templates
              </div>
