      <!-- Bill Splitter -->
      {isStandalone ? (
        <a
          href={`${basePrefix}/?tab=split`}
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group no-underline"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-violet-100 dark:bg-violet-900/60 text-violet-700 dark:text-violet-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              ⚡
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">Bill Splitter</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">Equally, itemized & multi-currency group expense sharing</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      ) : (
        <button
          type="button"
          data-more-action="split"
          class="w-full flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-emerald-50/60 dark:bg-slate-800/60 dark:hover:bg-emerald-950/40 border border-slate-200/80 dark:border-slate-700/80 transition-all text-left cursor-pointer group"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-violet-100 dark:bg-violet-900/60 text-violet-700 dark:text-violet-300 flex items-center justify-center text-lg shrink-0 group-hover:scale-105 transition-transform">
              ⚡
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">Bill Splitter</div>
              <div class="text-[10px] text-slate-500 dark:text-slate-400 truncate">Equally, itemized & multi-currency group expense sharing</div>
            </div>
