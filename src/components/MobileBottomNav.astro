<script is:inline>
  (function initMobileBottomNav() {
    const nav = document.getElementById("mobile-bottom-nav");
    const pill = document.getElementById("bottom-nav-active-pill");
    const buttons = document.querySelectorAll(".bottom-nav-btn");
    const moreBtn = document.getElementById("btn-bottom-nav-more");
    const closeMoreBtn = document.getElementById("btn-close-more-sheet");
    const sheet = document.getElementById("more-menu-sheet");
    const backdrop = document.getElementById("more-menu-backdrop");
    const moreActionButtons = document.querySelectorAll("[data-more-action]");
    const container = document.getElementById("bottom-nav-buttons-container");

    if (!nav || !pill || !container) return;

    const isStandalone =
      container.getAttribute("data-is-standalone") === "true";
    const initialIndex = parseInt(
      container.getAttribute("data-initial-index") || "0",
      10,
    );

    let activeIndex = initialIndex;

    // If on homepage with ?tab=... query param, synchronize initial pill position
    if (!isStandalone && window.location.search) {
      try {
        const p = new URLSearchParams(window.location.search);
        const t = p.get('tab');
        if (t && typeof tabIndexMap[t] === 'number') {
          activeIndex = tabIndexMap[t];
        }
      } catch (e) {}
    }

    function updatePillPosition(index) {
      if (index < 0 || index > 5) return;
      activeIndex = index;
      pill.style.left = `calc(${index} * (100% / 6))`;

      buttons.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.add(
            "active",
            "text-emerald-700",
            "dark:text-emerald-400",
            "font-bold",
          );
          btn.classList.remove(
            "text-slate-500",
            "dark:text-slate-400",
            "font-medium",
          );
        } else {
          btn.classList.remove(
            "active",
            "text-emerald-700",
            "dark:text-emerald-400",
            "font-bold",
          );
          btn.classList.add(
            "text-slate-500",
            "dark:text-slate-400",
            "font-medium",
          );
        }
      });
    }

    // Tab Mapping: tabId -> index
    const tabIndexMap = {
      tracker: 0,
      split: 1,
      "bill-splitter": 1,
      bill_splitter: 1,
      templates: 2,
      debt: 3,
      targets: 4,
      goals: 4,
      knowledge: 5,
      import: 5,
    };

    // Open More Sheet (Strictly only triggered on user tap)
    function openMoreSheet() {
      if (!sheet || !backdrop) return;
      sheet.classList.remove("hidden", "pointer-events-none");
      sheet.setAttribute("aria-hidden", "false");
      backdrop.classList.remove("hidden", "pointer-events-none");
      backdrop.setAttribute("aria-hidden", "false");

      // Trigger reflow so browser registers removal of hidden before animating
      void sheet.offsetHeight;

      requestAnimationFrame(() => {
        backdrop.classList.add("opacity-100");
        sheet.classList.remove("translate-y-full");
        sheet.classList.add("translate-y-0");
        moreBtn?.setAttribute("aria-expanded", "true");
        document.body.classList.add("overflow-hidden");
      });
    }

    // Close More Sheet
    function closeMoreSheet() {
      if (!sheet || !backdrop) return;
      sheet.classList.add("translate-y-full", "pointer-events-none");
      sheet.classList.remove("translate-y-0");
      sheet.setAttribute("aria-hidden", "true");
      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("pointer-events-none");
      backdrop.setAttribute("aria-hidden", "true");
      moreBtn?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
      setTimeout(() => {
        sheet.classList.add("hidden");
        backdrop.classList.add("hidden");
      }, 300);
    }

    moreBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      openMoreSheet();
    });

    closeMoreBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      closeMoreSheet();
    });

    backdrop?.addEventListener("click", (e) => {
      e.preventDefault();
      closeMoreSheet();
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !sheet.classList.contains("hidden")) {
        closeMoreSheet();
      }
    });

    // Close sheet when tapping any link inside sheet
    sheet?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMoreSheet();
      });
    });

    // Handle More Actions (Knowledge, Import, Templates, Split)
    moreActionButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.getAttribute("data-more-action");
        closeMoreSheet();
        if (!action) return;

        if (action === "split") {
          if (isStandalone) {
            window.scrollTo({ top: 0, behavior: "smooth" });
            return;
          }
          if (typeof window.switchTab === "function") {
            window.switchTab("split");
          } else {
            window.dispatchEvent(
              new CustomEvent("app-switch-tab", { detail: { tabId: "split" } }),
            );
          }
          const target =
            document.getElementById("split-tool-anchor") ||
            document.getElementById("tab-view-split");
          target?.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }

        if (typeof window.switchTab === "function") {
          window.switchTab(action);
        } else {
          window.dispatchEvent(
            new CustomEvent("app-switch-tab", { detail: { tabId: action } }),
          );
        }

        if (action === "knowledge") {
          document
            .getElementById("tab-view-knowledge")
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (action === "import") {
          (
            document.getElementById("importer") ||
            document.getElementById("tab-view-import")
          )?.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (action === "templates") {
          document
            .getElementById("tab-view-templates")
            ?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Close sheet when reset button inside sheet is clicked
    const sheetResetBtn = sheet?.querySelector(".btn-open-reset-modal");
    sheetResetBtn?.addEventListener("click", () => {
      closeMoreSheet();
      if (isStandalone) {
        const bscResetModal = document.getElementById("modal-reset-confirm");
        if (bscResetModal) {
          bscResetModal.classList.remove("hidden");
        }
      }
    });

    // Handle Bottom Nav Tab Button Clicks
    buttons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const tab = btn.getAttribute("data-bottom-tab");
        const idx = parseInt(btn.getAttribute("data-index") || "0", 10);

        if (tab === "more") {
          return;
        }

        closeMoreSheet();

        if (isStandalone) {
          if (tab === 'split' && window.location.pathname.includes('/bill-splitter')) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
            updatePillPosition(1);
            return;
          }
          // Other tabs are <a> tags leading to /?tab=..., let default navigation happen
          return;
        }

        e.preventDefault();
        updatePillPosition(idx);

        if (tab) {
          if (typeof window.switchTab === "function") {
            window.switchTab(tab);
          } else {
            window.dispatchEvent(
              new CustomEvent("app-switch-tab", { detail: { tabId: tab } }),
            );
          }

          if (tab === "tracker") {
            window.scrollTo({ top: 0, behavior: "smooth" });
          } else if (tab === "split") {
            const splitAnchor =
              document.getElementById("split-tool-anchor") ||
              document.getElementById("tab-view-split");
            if (splitAnchor) {
              splitAnchor.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            } else {
              window.scrollTo({ top: 0, behavior: "smooth" });
            }
          } else {
            const targetView = document.getElementById(`tab-view-${tab}`);
            targetView?.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    });

    // Listen to tab changes from elsewhere in the app
    window.addEventListener("app-tab-changed", (e) => {
      if (e.detail && e.detail.tabId) {
        if (e.detail.tabId !== "knowledge" && e.detail.tabId !== "import") {
          closeMoreSheet();
        }
        const idx = tabIndexMap[e.detail.tabId];
        if (typeof idx === "number") {
          updatePillPosition(idx);
        }
      }
    });

    // Explicitly enforce that sheet and backdrop start strictly closed
    sheet.classList.add("hidden", "translate-y-full", "pointer-events-none");
    sheet.classList.remove("translate-y-0");
    sheet.setAttribute("aria-hidden", "true");
    backdrop.classList.add("hidden", "pointer-events-none");
    backdrop.classList.remove("opacity-100");
    backdrop.setAttribute("aria-hidden", "true");
    moreBtn?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");

    // Initialize pill position
    updatePillPosition(initialIndex);
  })();
</script>
