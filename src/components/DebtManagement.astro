---
---

<div class="space-y-6">
  <!-- Debt Header & Strategy Controls -->
  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-slate-900 font-['Outfit',sans-serif] flex items-center gap-2">
            <span>💳</span> Debt Freedom & Payoff Planner
          </h2>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-800 border border-sky-200 uppercase tracking-wider">
            Snowball & Avalanche
          </span>
        </div>
        <p class="text-xs text-slate-600 mt-1">
          Eliminate consumer debt systematically. Compare Snowball vs. Avalanche strategies, simulate extra monthly payments, and watch your debt-free date accelerate.
        </p>
      </div>

      <!-- Strategy Selector Buttons -->
      <div class="flex p-1 rounded-xl bg-slate-100 border border-slate-200 w-full sm:w-auto">
        <button
          type="button"
          id="btn-strat-avalanche"
          class="debt-strat-btn active flex-1 sm:flex-initial text-center px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-white text-emerald-800 shadow-2xs cursor-pointer"
        >
          <span>⚡ Avalanche</span><span class="hidden sm:inline"> (Highest APR)</span>
        </button>
        <button
          type="button"
          id="btn-strat-snowball"
          class="debt-strat-btn flex-1 sm:flex-initial text-center px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 cursor-pointer"
        >
          <span>❄️ Snowball</span><span class="hidden sm:inline"> (Lowest Balance)</span>
        </button>
      </div>
    </div>

    <!-- 4 Debt KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="text-[10px] uppercase font-bold text-slate-500">Total Debt Balance</div>
        <div id="stat-total-debt" class="text-xl sm:text-2xl font-bold font-mono text-slate-900">$29,500</div>
        <div class="text-[11px] text-slate-600"><span id="debt-item-count">3</span> active obligations</div>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="text-[10px] uppercase font-bold text-slate-500">Debt-to-Income (DTI)</div>
        <div id="stat-dti-ratio" class="text-xl sm:text-2xl font-bold font-mono text-slate-900">18%</div>
        <div id="stat-dti-tier" class="text-[11px] text-emerald-700 font-semibold">Healthy Range (&lt;36%)</div>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="text-[10px] uppercase font-bold text-slate-500">Projected Debt-Free</div>
        <div id="stat-debt-free-date" class="text-xl sm:text-2xl font-bold font-mono text-emerald-700">Nov 2028</div>
        <div id="stat-debt-months-left" class="text-[11px] text-slate-600">32 months remaining</div>
      </div>

      <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
        <div class="text-[10px] uppercase font-bold text-slate-500">Total Interest Saved</div>
        <div id="stat-interest-saved" class="text-xl sm:text-2xl font-bold font-mono text-emerald-700">$3,420</div>
        <div class="text-[11px] text-slate-600">With current extra payments</div>
      </div>
    </div>

    <!-- Extra Payment Slider -->
    <div class="p-4 rounded-xl bg-emerald-50/50 border border-emerald-200/80 space-y-3">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-slate-900 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Accelerate Payoff: Extra Monthly Contribution
        </span>
        <span class="font-mono font-bold text-emerald-800 text-sm">
          +<span id="extra-payment-label">$200</span>/month
        </span>
      </div>
      <input
        type="range"
        id="debt-extra-payment-slider"
        min="0"
        max="1000"
        step="25"
        value="200"
        class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600"
      />
      <div class="flex justify-between text-[10px] text-slate-500 font-mono">
        <span>$0 (Minimums Only)</span>
        <span>+$500/mo</span>
        <span>+$1,000/mo Acceleration</span>
      </div>
    </div>
  </div>

  <!-- Debt Entry Form & Active Debt List -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Form: Add Debt -->
    <div class="lg:col-span-5 bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif] flex items-center gap-2">
          <span>➕</span> Add a Loan or Credit Card
        </h3>
        <p class="text-xs text-slate-600 mt-0.5">
          Enter your current outstanding debts to include in the payoff simulation.
        </p>
      </div>

      <form id="form-add-debt" class="space-y-3">
        <div>
          <label for="input-debt-name" class="block text-xs font-semibold text-slate-700 mb-1">Debt Name</label>
          <input
            type="text"
            id="input-debt-name"
            required
            placeholder="e.g. Visa Credit Card"
            class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-900 font-medium placeholder:text-slate-400 focus:border-emerald-600 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="input-debt-balance" class="block text-xs font-semibold text-slate-700 mb-1">Remaining Balance ($)</label>
            <input
              type="number"
              id="input-debt-balance"
              required
              min="1"
              step="10"
              placeholder="3800"
              class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 focus:border-emerald-600 focus:outline-none"
            />
          </div>

          <div>
            <label for="input-debt-rate" class="block text-xs font-semibold text-slate-700 mb-1">Interest Rate (APR %)</label>
            <input
              type="number"
              id="input-debt-rate"
              required
              min="0"
              max="99"
              step="0.1"
              placeholder="22.9"
              class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 focus:border-emerald-600 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="input-debt-minimum" class="block text-xs font-semibold text-slate-700 mb-1">Minimum Monthly Payment ($)</label>
          <input
            type="number"
            id="input-debt-minimum"
            required
            min="1"
            step="5"
            placeholder="120"
            class="block w-full rounded-xl border border-slate-300 px-3 py-2 text-xs text-slate-900 font-bold font-mono placeholder:text-slate-400 focus:border-emerald-600 focus:outline-none"
          />
        </div>

        <button
          type="submit"
          class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer mt-2"
        >
          Add to Payoff Schedule
        </button>
      </form>
    </div>

    <!-- Active Debts Table -->
    <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-base font-bold text-slate-900 font-['Outfit',sans-serif]">
            Prioritized Payoff Order
          </h3>
          <p class="text-xs text-slate-600 mt-0.5">
            Debts are ranked in target payoff sequence based on your chosen strategy.
          </p>
        </div>
        <span id="active-strategy-pill" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
          Avalanche (APR First)
        </span>
      </div>

      <div class="overflow-x-auto border border-slate-200 rounded-xl">
        <table class="w-full min-w-[480px] text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold uppercase text-[10px]">
            <tr>
              <th class="py-2.5 px-3">Priority</th>
              <th class="py-2.5 px-3">Debt Name</th>
              <th class="py-2.5 px-3 text-right">Balance</th>
              <th class="py-2.5 px-3 text-right">APR</th>
              <th class="py-2.5 px-3 text-right">Min Payment</th>
              <th class="py-2.5 px-3 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="debts-tbody" class="divide-y divide-slate-100 text-slate-700">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
