---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<!-- =========================================================================
     DESKTOP & TABLET: ORIGINAL FULL TRANSACTION LEDGER (sm:block, 640px+)
     Restored exactly as original: full ledger, search, exports, full table.
     ========================================================================= -->
<div id="desktop-tablet-ledger" class="hidden sm:block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xs space-y-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
          {t('ledger.title', locale)}
        </h3>
        <span
          id="tx-count-display"
          class="px-2 py-0.5 rounded-full text-[11px] font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"
        >
          {t('ledger.entriesCount', locale, { count: 6 })}
        </span>
      </div>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
        {t('ledger.subtitle', locale)}
      </p>
    </div>

    <!-- Search & Export Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2 w-full sm:w-auto flex-wrap">
      <!-- Search -->
      <div class="relative flex-1 sm:w-44 sm:flex-initial">
        <input
          type="text"
          id="search-transactions"
          placeholder={t('ledger.searchPlaceholder', locale)}
          class="w-full text-xs rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 pl-7 pr-2.5 py-1.5 focus:border-emerald-600 focus:outline-none placeholder:text-slate-400"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      <!-- CSV export button -->
      <button
        type="button"
        id="btn-export-csv"
        class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-2xs cursor-pointer flex items-center gap-1 shrink-0"
        title={t('ledger.exportCsv', locale)}
      >
        <span>CSV</span>
      </button>

      <!-- Excel export button -->
      <button
        type="button"
        id="btn-export-excel-quick"
        class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 hover:bg-teal-100 dark:hover:bg-teal-900/60 transition-colors shadow-2xs cursor-pointer flex items-center gap-1 shrink-0"
        title={t('ledger.exportExcel', locale)}
      >
        <span>XLSX</span>
      </button>

      <!-- JSON Backup button -->
      <button
        type="button"
        id="btn-backup-json"
        class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-colors shadow-2xs cursor-pointer flex items-center gap-1 shrink-0"
        title="Download complete JSON backup of all expenses, debts, goals & settings"
      >
        <span>Backup</span>
      </button>

      <!-- JSON Restore button -->
      <button
        type="button"
        id="btn-restore-json"
        class="text-xs font-semibold px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shadow-2xs cursor-pointer flex items-center gap-1 shrink-0"
        title="Restore data from previously exported JSON backup"
      >
        <span>Restore</span>
      </button>
      <input type="file" id="input-restore-json" accept=".json,application/json" class="hidden" />
    </div>
  </div>

  <!-- Original Full Table Container -->
  <div class="overflow-x-auto max-h-[360px] overflow-y-auto border border-slate-200/80 dark:border-slate-800 rounded-xl">
    <table class="w-full min-w-[500px] text-left border-collapse text-xs">
      <thead class="sticky top-0 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-semibold uppercase text-[10px] tracking-wider z-10">
        <tr>
          <th class="py-2.5 px-3">{t('ledger.thDate', locale)}</th>
          <th class="py-2.5 px-3">{t('ledger.thDescription', locale)}</th>
          <th class="py-2.5 px-3">{t('ledger.thCategory', locale)}</th>
          <th class="py-2.5 px-3">{t('ledger.thSource', locale)}</th>
          <th class="py-2.5 px-3 text-right">{t('ledger.thAmount', locale)}</th>
          <th class="py-2.5 px-3 text-center w-12">{t('ledger.thAction', locale)}</th>
        </tr>
      </thead>
      <tbody id="transactions-tbody" class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
        <!-- Rendered via JS -->
      </tbody>
    </table>
  </div>

  <!-- Empty State for Desktop & Tablet -->
  <div id="empty-ledger-state" class="hidden p-8 text-center space-y-2">
    <div class="text-3xl">📝</div>
    <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">{t('ledger.emptyTitle', locale)}</p>
    <p class="text-[11px] text-slate-500 dark:text-slate-400">
      {t('ledger.emptySubtitle', locale)}
    </p>
  </div>
</div>

<!-- =========================================================================
     MOBILE ONLY: COMPACT TRANSACTION LEDGER (<640px)
     Scope: MOBILE ONLY. Displays exactly 3 recent transactions, category icons,
     amount right aligned, View All in header, View All Transactions at bottom.
     ========================================================================= -->
<div id="mobile-compact-ledger" class="sm:hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-xs space-y-3">
  <!-- Mobile Header -->
  <div class="flex items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800 pb-3">
    <div>
      <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
        {t('ledger.title', locale)}
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
        {t('ledger.recentSubtitle', locale)}
      </p>
    </div>

    <!-- Top-Right View All Link -->
    <button
      type="button"
      class="btn-open-tx-history text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors flex items-center gap-1 cursor-pointer group"
      title={t('ledger.viewAll', locale)}
    >
      <span>{t('ledger.viewAll', locale)}</span>
      <svg class="w-3.5 h-3.5 text-emerald-500 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>

  <!-- Mobile Recent 3 Transactions Rows Container -->
  <div id="mobile-recent-transactions" class="divide-y divide-slate-100 dark:divide-slate-800">
    <!-- Rendered via JS: exactly 3 newest transactions -->
  </div>

  <!-- Empty State for Mobile Recent Transactions -->
  <div id="empty-mobile-recent-transactions" class="hidden py-6 text-center space-y-2">
    <div class="text-2xl">📝</div>
    <p class="text-xs font-semibold text-slate-800 dark:text-slate-200">{t('ledger.emptyTitle', locale)}</p>
    <p class="text-[11px] text-slate-500 dark:text-slate-400">
      {t('ledger.emptySubtitle', locale)}
    </p>
  </div>

  <!-- Bottom Prominent View All Transactions Button -->
  <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
    <button
      type="button"
      class="btn-open-tx-history w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors flex items-center justify-center gap-1.5 cursor-pointer shadow-2xs group"
    >
      <span>{t('ledger.viewAllTransactions', locale)}</span>
      <svg class="w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
</div>
