---
// src/components/bill-splitter/BillSplitterFAQ.astro

export const BILL_SPLITTER_FAQS = [
  {
    question: "Can I split uneven or itemized bills?",
    answer: "Yes. In Itemized Split mode, you can add individual dishes, drinks, or items with their exact prices and assign them to specific people or mark them as shared among everyone. The calculator calculates individual subtotals, allocates tax and tips proportionally based on consumption, and ensures no one overpays."
  },
  {
    question: "How does the bill splitter handle taxes and tips for shared items?",
    answer: "Taxes and tips are distributed proportionally using the Largest Remainder Method (Hare-Niemeyer method). Rather than splitting taxes equally (which unfairly charges someone who only ordered a side salad), tax and tip are allocated based on each person's share of the food subtotal. Any minor-unit rounding fractions are distributed deterministically so the sum of individual shares exactly matches the bill total to the exact cent or paisa."
  },
  {
    question: "Is this bill splitter really 100% free with no sign-up?",
    answer: "Yes, completely free. There are no accounts, no subscriptions, no paywalls, and no advertisements. Everything runs directly in your web browser using client-side JavaScript, ensuring 100% privacy and lightning-fast speed."
  },
  {
    question: "How does the group debt simplification algorithm work?",
    answer: "In Trip / Group Split mode, our debt simplification engine uses a greedy min-cash-flow algorithm. It calculates each participant's net balance (total money paid minus fair share owed). It then iteratively matches the person who owes the most (largest debtor) with the person who is owed the most (largest creditor). This settles all debts with the absolute minimum number of peer-to-peer transfers, reducing what could be dozens of confusing payments down to at most N-1 transactions."
  },
  {
    question: "Can I use different currencies like USD, EUR, INR, or JPY?",
    answer: "Yes! FreeExpenseTracker Bill Splitter supports 10 major global currencies: INR (₹), USD ($), EUR (€), GBP (£), CAD ($), AUD ($), SGD ($), AED (AED), CHF (CHF), and JPY (¥). Zero-decimal currencies like Japanese Yen (¥) are automatically handled without decimals, and Indian Rupees follow lakh and crore formatting standards."
  },
  {
    question: "Will my data be saved if I refresh the page?",
    answer: "Yes. Your active mode, currency, participants, items, and expenses are automatically saved to your browser's private local storage (bs_v1). You can safely refresh the tab or revisit the page later without losing your calculations. You can clear your data anytime using the 'Reset All' button."
  },
  {
    question: "How do I share the calculated split with my friends?",
    answer: "You can click 'Share via WhatsApp' to instantly open a pre-filled message in WhatsApp, tap 'Copy Breakdown' to paste the itemized receipt summary into iMessage, SMS, or Slack, or use the native 'Share' button on mobile devices."
  }
];
---

<section id="section-bill-splitter-faq" class="space-y-6 pt-6">
  <div class="border-t border-slate-200 dark:border-slate-800 pt-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 mb-3">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Got Questions?</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight font-['Outfit',sans-serif]">
      Frequently Asked Questions
    </h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      Everything you need to know about splitting bills, math accuracy, tipping customs, and privacy.
    </p>
  </div>

  <div class="space-y-3">
    {BILL_SPLITTER_FAQS.map((faq, index) => (
      <details
        class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-xs transition-all duration-200 hover:border-slate-300 dark:hover:border-slate-700"
        open={index === 0}
      >
        <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer select-none text-left font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
          <span class="flex items-center gap-3">
            <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-normal">0{index + 1}.</span>
            {faq.question}
          </span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-4 sm:px-5 pb-5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-3">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>
