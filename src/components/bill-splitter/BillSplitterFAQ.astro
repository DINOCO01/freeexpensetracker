---
// src/components/bill-splitter/BillSplitterFAQ.astro

export const BILL_SPLITTER_FAQS = [
  {
    question: "How do I split a bill with different amounts?",
    answer: "Use the Itemized Split mode to enter each item and assign it to specific individuals or mark it as shared. The tool computes individual subtotals and proportionally allocates shared taxes and tips based on each person's consumption."
  },
  {
    question: "How does the bill splitter handle taxes and tips for shared items?",
    answer: "Taxes and tips are distributed proportionally using the Largest Remainder Method based on each person's share of the food subtotal. Any minor-unit rounding fractions are balanced deterministically so the sum of individual shares exactly equals the bill total."
  },
  {
    question: "Is FreeExpenseTracker Bill Splitter free, and do I need to create an account?",
    answer: "Yes, it is 100% free with no account registration, subscriptions, or advertisements. All calculations run client-side in your browser, keeping your expense numbers completely private."
  },
  {
    question: "How does group debt simplification work for trips?",
    answer: "In Trip mode, the tool calculates each person's net balance (amount paid minus fair share owed) and runs a greedy minimum-cash-flow algorithm. It pairs the largest debtor with the largest creditor, settling all group debts in at most N-1 total transfers."
  },
  {
    question: "Which currencies are supported?",
    answer: "The calculator supports 10 global currencies including INR (₹), USD ($), EUR (€), GBP (£), CAD ($), AUD ($), SGD ($), AED, CHF, and JPY (¥). Zero-decimal currencies like JPY are automatically rounded to whole numbers without decimal places."
  },
  {
    question: "Will my calculations be saved if I refresh the page?",
    answer: "Yes, your active split mode, currency, participants, items, and expenses are automatically saved to your browser's private local storage. You can refresh or revisit the tab anytime without losing progress, or reset data with the 'Reset All' button."
  },
  {
    question: "How do I share the calculated split with my friends?",
    answer: "Click 'Share via WhatsApp' to open a pre-filled summary in WhatsApp, tap 'Copy Breakdown' to paste the receipt into messages or Slack, or use your mobile device's native share menu."
  }
];
---

<section id="section-bill-splitter-faq" class="space-y-6 pt-6">
  <div class="border-t border-slate-200 dark:border-slate-800 pt-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 mb-3">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Got Questions?</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight font-['Outfit',sans-serif]">
      Frequently Asked Questions
    </h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      Everything you need to know about splitting bills, math accuracy, tipping customs, and privacy.
    </p>
  </div>

  <div class="space-y-3">
    {BILL_SPLITTER_FAQS.map((faq, index) => (
      <details
        class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-xs transition-all duration-200 hover:border-slate-300 dark:hover:border-slate-700"
        open={index === 0}
      >
        <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer select-none text-left font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
          <span class="flex items-center gap-3">
            <span class="font-mono text-xs text-emerald-600 dark:text-emerald-400 font-normal">0{index + 1}.</span>
            {faq.question}
          </span>
          <svg class="w-5 h-5 text-slate-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-4 sm:px-5 pb-5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-3">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>
