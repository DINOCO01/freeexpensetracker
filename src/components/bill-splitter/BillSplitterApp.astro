---
// src/components/bill-splitter/BillSplitterApp.astro
import { BILL_SPLITTER_CURRENCIES } from '../../utils/bill-splitter/money';
---

<div id="bill-splitter-container" class="max-w-xl mx-auto space-y-6">
  <!-- Main Calculator Card (Splitkaro-inspired single focused container) -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-5 sm:p-7 shadow-sm space-y-6">
    
    <!-- Top Utility Bar: Currency Selector & Reset -->
    <div class="flex items-center justify-between pb-3.5 border-b border-slate-100 dark:border-slate-800/80">
      <div class="flex items-center gap-2">
        <label for="select-currency" class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
          Currency:
        </label>
        <select
          id="select-currency"
          class="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 text-xs sm:text-sm font-semibold rounded-xl px-2.5 py-1.5 focus:ring-2 focus:ring-emerald-500 focus:outline-none cursor-pointer transition-colors"
          aria-label="Select currency"
        >
          {Object.values(BILL_SPLITTER_CURRENCIES).map((c) => (
            <option value={c.code} selected={c.code === 'INR'}>
              {c.symbol} {c.code} - {c.name}
            </option>
          ))}
        </select>
      </div>

      <button
        type="button"
        id="btn-open-reset-modal"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-500 hover:text-rose-600 dark:text-slate-400 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
        title="Reset all inputs to defaults"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        <span>Reset</span>
      </button>
    </div>

    <!-- Mode Selector Tabs (Splitkaro segmented pill control) -->
    <div class="grid grid-cols-3 gap-1.5 p-1.5 bg-slate-100 dark:bg-slate-800/80 rounded-2xl border border-slate-200/80 dark:border-slate-700/80" role="tablist" aria-label="Splitter Modes">
      <button
        type="button"
        id="tab-btn-even"
        role="tab"
        aria-selected="true"
        aria-controls="mode-panel-even"
        class="mode-tab-btn flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition-all shadow-xs bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border border-slate-200/80 dark:border-slate-700 cursor-pointer"
      >
        <span>⚡</span>
        <span>Even Split</span>
      </button>
      <button
        type="button"
        id="tab-btn-itemized"
        role="tab"
        aria-selected="false"
        aria-controls="mode-panel-itemized"
        class="mode-tab-btn flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-medium transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
      >
        <span>📋</span>
        <span>Itemized</span>
      </button>
      <button
        type="button"
        id="tab-btn-trip"
        role="tab"
        aria-selected="false"
        aria-controls="mode-panel-trip"
        class="mode-tab-btn flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-medium transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
      >
        <span>🏖️</span>
        <span>Trip Split</span>
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- MODE 1: EVEN SPLIT -->
    <!-- ========================================================================= -->
    <section id="mode-panel-even" role="tabpanel" aria-labelledby="tab-btn-even" class="space-y-5">
      <!-- Total Bill Input -->
      <div>
        <label for="input-even-bill" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
          Total Bill Amount *
        </label>
        <div class="relative">
          <span class="currency-symbol-display absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-mono text-xl font-bold">
            ₹
          </span>
          <input
            type="text"
            inputmode="decimal"
            id="input-even-bill"
            placeholder="0.00"
            class="w-full pl-10 pr-4 py-3 bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-900 dark:text-slate-100 font-mono text-2xl font-extrabold focus:ring-2 focus:ring-emerald-500 focus:outline-none transition-colors"
          />
        </div>
      </div>

      <!-- Who's Splitting It (Participants List) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
            Who's splitting it?
          </span>
          <div class="flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700">
            <button
              type="button"
              id="btn-even-people-minus"
              class="w-7 h-7 rounded-lg bg-white dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center transition-colors cursor-pointer"
              aria-label="Decrease number of people"
            >
              −
            </button>
            <input
              type="number"
              min="1"
              max="100"
              id="input-even-people"
              value="3"
              class="w-12 text-center py-0.5 bg-transparent text-slate-900 dark:text-slate-100 font-mono text-sm font-bold focus:outline-none"
            />
            <button
              type="button"
              id="btn-even-people-plus"
              class="w-7 h-7 rounded-lg bg-white dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold text-sm flex items-center justify-center transition-colors cursor-pointer"
              aria-label="Increase number of people"
            >
              +
            </button>
          </div>
        </div>

        <!-- Participant Names Rows (Splitkaro style) -->
        <div id="even-participants-names-container" class="space-y-2">
          <!-- Dynamically populated name inputs -->
        </div>

        <button
          type="button"
          id="btn-even-add-person"
          class="w-full py-2 px-3 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-500 text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Add another person</span>
        </button>
      </div>

      <!-- Tax & Tip Adjustments (Compact & Clean) -->
      <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <span class="block text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">
          Tax & Tip (Optional)
        </span>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="input-even-tax" class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">
              Tax Rate (%)
            </label>
            <div class="relative">
              <input
                type="number"
                step="0.1"
                min="0"
                id="input-even-tax"
                placeholder="5"
                class="w-full pl-3 pr-7 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-slate-100 font-mono text-xs sm:text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"
              />
              <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400 text-xs font-bold">%</span>
            </div>
          </div>

          <div>
            <label for="input-even-tip" class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">
              Tip / Gratuity (%)
            </label>
            <div class="relative">
              <input
                type="number"
                step="0.5"
                min="0"
                id="input-even-tip"
                placeholder="10"
                class="w-full pl-3 pr-7 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-slate-100 font-mono text-xs sm:text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"
              />
              <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400 text-xs font-bold">%</span>
            </div>
          </div>
        </div>

        <!-- Tip Quick Presets -->
        <div class="flex items-center gap-1.5 flex-wrap pt-0.5" id="even-tip-presets">
          <span class="text-[11px] font-semibold text-slate-400 mr-1">Presets:</span>
          {[0, 5, 10, 15, 18, 20].map((pct) => (
            <button
              type="button"
              data-tip={pct}
              class="btn-tip-preset px-2 py-0.5 rounded-lg text-[11px] font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-50 hover:text-emerald-700 dark:hover:bg-emerald-950 dark:hover:text-emerald-300 transition-colors cursor-pointer"
            >
              {pct}%
            </button>
          ))}
        </div>

        <!-- Tip On Bill + Tax Toggle -->
        <label class="flex items-center gap-2.5 pt-1 cursor-pointer select-none">
          <input
            type="checkbox"
            id="toggle-even-tip-on-tax"
            class="w-4 h-4 text-emerald-600 rounded-sm border-slate-300 dark:border-slate-600 focus:ring-emerald-500 cursor-pointer"
          />
          <span class="text-xs font-medium text-slate-600 dark:text-slate-300">
            Calculate tip on Bill + Tax
          </span>
        </label>
      </div>

      <!-- Results Block (Splitkaro style .calc-result) -->
      <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
        <!-- Per-Person Hero Banner -->
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/80 dark:border-emerald-800/80 text-center space-y-1">
          <div class="flex items-center justify-between text-xs font-semibold text-emerald-800 dark:text-emerald-300">
            <span class="uppercase tracking-wider font-bold">Each Person Pays</span>
            <span id="even-people-badge" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-200/60 dark:bg-emerald-900/60 font-mono">
              3 people
            </span>
          </div>
          <div id="even-per-person-display" class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-700 dark:text-emerald-300 tracking-tight">
            ₹0.00
          </div>
          <div id="even-remainder-notice" class="text-[11px] text-emerald-600 dark:text-emerald-400 font-mono"></div>
        </div>

        <!-- Breakdown Summary Rows -->
        <div class="space-y-2 text-xs sm:text-sm font-mono pt-1">
          <div class="flex justify-between text-slate-600 dark:text-slate-400">
            <span class="font-sans font-medium">Bill Subtotal:</span>
            <span id="even-subtotal-display" class="font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div class="flex justify-between text-slate-600 dark:text-slate-400">
            <span class="font-sans font-medium">Tax Amount:</span>
            <span id="even-tax-display" class="font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div class="flex justify-between text-slate-600 dark:text-slate-400">
            <span class="font-sans font-medium">Tip / Gratuity:</span>
            <span id="even-tip-display" class="font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div class="flex justify-between pt-2 border-t border-slate-200 dark:border-slate-700 font-bold text-sm sm:text-base text-slate-900 dark:text-slate-100">
            <span class="font-sans">Grand Total:</span>
            <span id="even-grand-total-display" class="text-emerald-600 dark:text-emerald-400">₹0.00</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-3 gap-2 pt-1">
        <button
          type="button"
          id="btn-even-copy"
          class="py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span>Copy</span>
        </button>
        <button
          type="button"
          id="btn-even-whatsapp"
          class="py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>💬</span>
          <span>WhatsApp</span>
        </button>
        <button
          type="button"
          id="btn-even-share"
          class="py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all border border-slate-200 dark:border-slate-700 flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span>Share</span>
        </button>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- MODE 2: ITEMIZED SPLIT -->
    <!-- ========================================================================= -->
    <section id="mode-panel-itemized" role="tabpanel" aria-labelledby="tab-btn-itemized" class="hidden space-y-5">
      <!-- Unassigned Items Warning Banner -->
      <div id="itemized-unassigned-alert" class="hidden p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800 text-amber-900 dark:text-amber-200 text-xs flex items-start gap-2.5">
        <span class="text-base shrink-0">⚠️</span>
        <div>
          <span class="font-bold">Unassigned Items:</span>
          <span id="itemized-unassigned-text">One or more items are not assigned to anyone.</span>
        </div>
      </div>

      <!-- Who's Splitting It (Participants Manager) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
            Who's splitting it?
          </span>
          <div class="flex items-center gap-1.5">
            <input
              type="text"
              id="input-itemized-add-person"
              placeholder="Name..."
              class="w-28 sm:w-36 px-2.5 py-1.5 text-xs bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"
            />
            <button
              type="button"
              id="btn-itemized-add-person"
              class="px-2.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors cursor-pointer"
            >
              + Add
            </button>
          </div>
        </div>

        <!-- Participants Badges Container -->
        <div id="itemized-participants-list" class="flex flex-wrap gap-1.5 pt-1">
          <!-- Dynamically rendered participant pills with remove option -->
        </div>
      </div>

      <!-- What Was Ordered (Items Manager) -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
            What was ordered?
          </span>
          <button
            type="button"
            id="btn-itemized-add-item"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors cursor-pointer"
          >
            <span>+ Add Item</span>
          </button>
        </div>

        <!-- Items List Container -->
        <div id="itemized-items-container" class="space-y-3">
          <!-- Dynamically rendered item rows (Splitkaro style) -->
        </div>
      </div>

      <!-- Bill-Level Adjustments: Tax & Tip -->
      <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <span class="block text-xs font-bold text-slate-600 dark:text-slate-300 uppercase tracking-wider">
          Tax & Tip Allocation (Proportional)
        </span>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Tax Input & Toggle -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Tax</label>
              <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-white dark:bg-slate-800 text-[10px] font-bold">
                <button
                  type="button"
                  id="btn-tax-mode-pct"
                  class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 cursor-pointer"
                >
                  %
                </button>
                <button
                  type="button"
                  id="btn-tax-mode-fixed"
                  class="px-2 py-0.5 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
                >
                  Fixed
                </button>
              </div>
            </div>
            <div class="relative">
              <span id="tax-symbol-indicator" class="hidden absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 font-mono text-xs">₹</span>
              <input
                type="text"
                inputmode="decimal"
                id="input-itemized-tax"
                placeholder="5"
                class="w-full px-3 py-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-slate-100 font-mono text-xs sm:text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"
              />
            </div>
          </div>

          <!-- Tip Input & Toggle -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Tip / Gratuity</label>
              <div class="inline-flex rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-white dark:bg-slate-800 text-[10px] font-bold">
                <button
                  type="button"
                  id="btn-tip-mode-pct"
                  class="px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 cursor-pointer"
                >
                  %
                </button>
                <button
                  type="button"
                  id="btn-tip-mode-fixed"
                  class="px-2 py-0.5 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
                >
                  Fixed
                </button>
              </div>
            </div>
            <div class="relative">
              <span id="tip-symbol-indicator" class="hidden absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 font-mono text-xs">₹</span>
              <input
                type="text"
                inputmode="decimal"
                id="input-itemized-tip"
                placeholder="10"
                class="w-full px-3 py-1.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-slate-100 font-mono text-xs sm:text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"
              />
            </div>
            <div class="flex flex-wrap gap-1 pt-0.5" id="itemized-tip-presets">
              {[0, 10, 15, 18, 20].map((pct) => (
                <button
                  type="button"
                  data-tip={pct}
                  class="btn-itemized-tip-preset px-1.5 py-0.5 rounded text-[10px] font-semibold bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-emerald-50 dark:hover:bg-emerald-950 transition-colors cursor-pointer"
                >
                  {pct}%
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Itemized Results & Summary -->
      <div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-200/90 dark:border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
        <!-- Summary Ribbon -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center font-mono p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800">
          <div>
            <span class="block text-[10px] text-slate-400 font-sans uppercase font-bold">Subtotal</span>
            <span id="itemized-summary-subtotal" class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 font-sans uppercase font-bold">Tax</span>
            <span id="itemized-summary-tax" class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 font-sans uppercase font-bold">Tip</span>
            <span id="itemized-summary-tip" class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">₹0.00</span>
          </div>
          <div>
