---
import { t, DEFAULT_LOCALE, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
---

<div class="flex flex-col justify-between gap-4 h-full">
  <!-- Income Entry & Frequency Bar -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-3">
      <div>
        <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] flex items-center gap-2">
          <span>💵</span> {locale === 'en' ? 'Take-Home Income' : t('dashboard.incomeSetupTitle', locale)}
        </h2>
        <p class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          {locale === 'en' ? 'Calculate your monthly equivalent.' : t('dashboard.incomeSetupSubtitle', locale)}
        </p>
      </div>

      <!-- Frequency Segmented Buttons -->
      <div class="inline-flex p-1 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 w-full sm:w-auto">
        <button
          type="button"
          data-freq="monthly"
          class="btn-freq active flex-1 sm:flex-initial text-center px-2.5 sm:px-3 py-1.5 min-h-[36px] flex items-center justify-center rounded-lg text-xs font-semibold transition-all bg-white dark:bg-slate-700 text-emerald-800 dark:text-emerald-300 shadow-2xs cursor-pointer"
        >
          {t('dashboard.monthly', locale)}
        </button>
        <button
          type="button"
          data-freq="bi-weekly"
          class="btn-freq flex-1 sm:flex-initial text-center px-2.5 sm:px-3 py-1.5 min-h-[36px] flex items-center justify-center rounded-lg text-xs font-semibold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
        >
          {t('dashboard.biWeekly', locale)}
        </button>
        <button
          type="button"
          data-freq="weekly"
          class="btn-freq flex-1 sm:flex-initial text-center px-2.5 sm:px-3 py-1.5 min-h-[36px] flex items-center justify-center rounded-lg text-xs font-semibold transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 cursor-pointer"
        >
          {t('dashboard.weekly', locale)}
        </button>
      </div>
    </div>

    <!-- Income Input & Interactive Slider -->
    <div class="space-y-3 pt-1">
      <div>
        <label for="input-income-amount" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
          {t('dashboard.paycheckAmount', locale)} (<span class="currency-label font-mono">$</span>)
        </label>
        <div class="relative rounded-xl shadow-2xs">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <span class="currency-label text-slate-500 font-semibold text-sm">$</span>
          </div>
          <input
            type="number"
            id="input-income-amount"
            min="0"
            step="50"
            value="4200"
            class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 pl-8 pr-4 py-2 text-slate-900 dark:text-slate-100 font-bold text-base focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all placeholder:text-slate-400"
            placeholder="e.g. 4200"
          />
        </div>
      </div>

      <div class="space-y-1.5 pt-1">
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            {t('dashboard.interactiveSimulation', locale)}
          </span>
          <span class="text-slate-500 dark:text-slate-400 text-[11px]">
            {t('dashboard.monthlyEquivalent', locale)} <strong id="income-normalized-amount" class="text-slate-900 dark:text-slate-100 font-mono font-bold">$4,200</strong>
          </span>
        </div>
        <div class="relative flex items-center">
          <input
            type="range"
            id="income-range-slider"
            min="0"
            max="500000"
            step="500"
            value="4200"
            class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-600"
          />
        </div>
        <div class="flex justify-between text-[10px] text-slate-500 dark:text-slate-400 font-mono">
          <span>$0/mo</span>
          <span>$250,000/mo</span>
          <span>$500,000/mo</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 KPI Summary Cards (2x2 Grid) -->
  <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
    <!-- Card 1: Monthly Income -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-3.5 shadow-xs space-y-1 overflow-hidden">
      <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-[10px] sm:text-[11px]">
        <span class="font-medium truncate">{t('dashboard.totalIncome', locale)}</span>
        <span class="text-xs sm:text-sm">💼</span>
      </div>
      <div id="stat-total-income" class="text-base sm:text-xl font-bold font-mono text-slate-900 dark:text-slate-100 tracking-tight truncate">
        $4,200
      </div>
      <div class="text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate">
        {t('dashboard.totalIncomeSub', locale)}
      </div>
    </div>

    <!-- Card 2: Total Expenses -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-3.5 shadow-xs space-y-1 overflow-hidden">
      <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-[10px] sm:text-[11px]">
        <span class="font-medium truncate">{t('dashboard.totalExpenses', locale)}</span>
        <span class="text-xs sm:text-sm">💳</span>
      </div>
      <div id="stat-total-expenses" class="text-base sm:text-xl font-bold font-mono text-slate-900 dark:text-slate-100 tracking-tight truncate">
        $2,605
      </div>
      <div class="text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 flex items-center gap-1 font-medium truncate">
        <span id="stat-expenses-pct" class="font-semibold text-slate-800 dark:text-slate-200">62%</span> {t('dashboard.ofIncome', locale)}
      </div>
    </div>

    <!-- Card 3: Remaining Balance -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-3.5 shadow-xs space-y-1 overflow-hidden">
      <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-[10px] sm:text-[11px]">
        <span class="font-medium truncate">{t('dashboard.netCashflow', locale)}</span>
        <span class="text-xs sm:text-sm">⚖️</span>
      </div>
      <div id="stat-remaining-balance" class="text-base sm:text-xl font-bold font-mono text-emerald-700 dark:text-emerald-400 tracking-tight truncate">
        +$1,595
      </div>
      <div id="stat-cashflow-label" class="text-[9px] sm:text-[10px] text-emerald-800 dark:text-emerald-300 font-semibold truncate">
        {t('dashboard.positiveSurplus', locale)}
      </div>
    </div>

    <!-- Card 4: Savings Rate -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 sm:p-3.5 shadow-xs space-y-1 overflow-hidden">
      <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 text-[10px] sm:text-[11px]">
        <span class="font-medium truncate">{t('dashboard.savingsRate', locale)}</span>
        <span class="text-xs sm:text-sm">🌱</span>
      </div>
      <div id="stat-savings-rate" class="text-base sm:text-xl font-bold font-mono text-emerald-700 dark:text-emerald-400 tracking-tight truncate">
        38%
      </div>
      <div class="text-[9px] sm:text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate">
        {t('dashboard.savingsRateSub', locale)}
      </div>
    </div>
  </div>
</div>
