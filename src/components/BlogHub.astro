---
import { t, type SupportedLocale } from '../locales';

interface Props {
  locale?: SupportedLocale;
}

const { locale = 'en' } = Astro.props;
---

<div class="space-y-6">
  <!-- Blog Hub Header -->
  <div class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif]">
            📰 {t('blogs.title', locale)}
          </h2>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 uppercase tracking-wider">
            {t('blogs.advisoryBadge', locale)}
          </span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
          {t('blogs.subtitle', locale)}
        </p>
      </div>

      <!-- Category Filter Pills Aligned with Four Pillars -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <button
          type="button"
          data-blog-filter="all"
          class="btn-blog-filter active px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-700 text-white shadow-2xs cursor-pointer whitespace-nowrap"
        >
          {t('blogs.allArticles', locale)}
        </button>
        <button
          type="button"
          data-blog-filter="pillar-1"
          class="btn-blog-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer whitespace-nowrap"
        >
          {t('knowledge.p1Title', locale)}
        </button>
        <button
          type="button"
          data-blog-filter="pillar-2"
          class="btn-blog-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer whitespace-nowrap"
        >
          {t('knowledge.p2Title', locale)}
        </button>
        <button
          type="button"
          data-blog-filter="pillar-3"
          class="btn-blog-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer whitespace-nowrap"
        >
          {t('knowledge.p3Title', locale)}
        </button>
        <button
          type="button"
          data-blog-filter="pillar-4"
          class="btn-blog-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors cursor-pointer whitespace-nowrap"
        >
          {t('knowledge.p4Title', locale)}
        </button>
      </div>
    </div>

    <!-- Featured Post Hero Card (Financial Automation Blueprint) -->
    <div class="p-5 rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-950/40 dark:to-teal-950/40 border border-emerald-200 dark:border-emerald-800/60 grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
      <div class="md:col-span-8 space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-700 text-white">
            {t('blogs.featuredBadge', locale)}
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t('blogs.featuredMeta', locale)}</span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] tracking-tight">
          {t('blogs.featuredTitle', locale)}
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.featuredDesc', locale)}
        </p>
      </div>
      <div class="md:col-span-4 flex justify-start md:justify-end">
        <button
          type="button"
          data-open-blog="blog-1"
          class="btn-read-article px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-750 transition-colors shadow-xs flex items-center gap-2 cursor-pointer"
        >
          <span>{t('blogs.btnReadArticle', locale)}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <!-- Article 1: Pillar 1 Cash Flow Leaks -->
    <div class="blog-card bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-all" data-category="pillar-1">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span class="px-2 py-0.5 rounded-md font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">{t('blogs.b1Tag', locale)}</span>
          <span>{t('blogs.readTime', locale, { mins: 5 })}</span>
        </div>
        <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-snug">
          {t('blogs.b1Title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.b1Desc', locale)}
        </p>
      </div>
      <button
        type="button"
        data-open-blog="blog-2"
        class="btn-read-article text-xs font-bold text-emerald-800 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1 cursor-pointer pt-2"
      >
        {t('blogs.readGuide', locale)} <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- Article 2: Pillar 2 Debt Avalanche vs Snowball -->
    <div class="blog-card bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-all" data-category="pillar-2">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span class="px-2 py-0.5 rounded-md font-semibold bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60">{t('blogs.b2Tag', locale)}</span>
          <span>{t('blogs.readTime', locale, { mins: 5 })}</span>
        </div>
        <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-snug">
          {t('blogs.b2Title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.b2Desc', locale)}
        </p>
      </div>
      <button
        type="button"
        data-open-blog="blog-3"
        class="btn-read-article text-xs font-bold text-emerald-800 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1 cursor-pointer pt-2"
      >
        {t('blogs.readGuide', locale)} <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- Article 3: Pillar 2 Emergency Shield -->
    <div class="blog-card bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-all" data-category="pillar-2">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span class="px-2 py-0.5 rounded-md font-semibold bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 border border-sky-200 dark:border-sky-800/60">{t('blogs.b3Tag', locale)}</span>
          <span>{t('blogs.readTime', locale, { mins: 4 })}</span>
        </div>
        <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-snug">
          {t('blogs.b3Title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.b3Desc', locale)}
        </p>
      </div>
      <button
        type="button"
        data-open-blog="blog-4"
        class="btn-read-article text-xs font-bold text-emerald-800 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1 cursor-pointer pt-2"
      >
        {t('blogs.readGuide', locale)} <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- Article 4: Pillar 3 Compounding & Systematic Investing -->
    <div class="blog-card bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-all" data-category="pillar-3">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span class="px-2 py-0.5 rounded-md font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-800 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/60">{t('blogs.b4Tag', locale)}</span>
          <span>{t('blogs.readTime', locale, { mins: 5 })}</span>
        </div>
        <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-snug">
          {t('blogs.b4Title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.b4Desc', locale)}
        </p>
      </div>
      <button
        type="button"
        data-open-blog="blog-5"
        class="btn-read-article text-xs font-bold text-emerald-800 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1 cursor-pointer pt-2"
      >
        {t('blogs.readGuide', locale)} <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- Article 5: Pillar 4 Preservation & Autonomy -->
    <div class="blog-card bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-xs flex flex-col justify-between space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-all" data-category="pillar-4">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span class="px-2 py-0.5 rounded-md font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/60">{t('blogs.b5Tag', locale)}</span>
          <span>{t('blogs.readTime', locale, { mins: 5 })}</span>
        </div>
        <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] leading-snug">
          {t('blogs.b5Title', locale)}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          {t('blogs.b5Desc', locale)}
        </p>
      </div>
      <button
        type="button"
        data-open-blog="blog-6"
        class="btn-read-article text-xs font-bold text-emerald-800 hover:text-emerald-900 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1 cursor-pointer pt-2"
      >
        {t('blogs.readGuide', locale)} <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </div>
</div>

<!-- Blog Reader Modal -->
<div
  id="modal-blog-reader"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reader-article-title"
>
  <div class="bg-white dark:bg-slate-850 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-2xl w-full p-6 shadow-2xl space-y-4 animate-in fade-in zoom-in-95 duration-150 max-h-[85vh] overflow-y-auto">
    <div class="flex items-start justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
      <div>
        <span id="reader-category-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
          Budgeting
        </span>
        <h3 id="reader-article-title" class="text-lg font-bold text-slate-900 dark:text-slate-100 font-['Outfit',sans-serif] mt-1.5">
          Article Title
        </h3>
        <p id="reader-meta-text" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">5 min read • Practical Educational Guide</p>
      </div>
      <button
        type="button"
        id="btn-close-blog-reader"
        class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1.5 rounded-lg transition-colors cursor-pointer"
        aria-label="Close article"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Full Article Body -->
    <div id="reader-article-content" class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed space-y-3">
      <!-- Populated via JS -->
    </div>

    <div class="border-t border-slate-100 dark:border-slate-800 pt-3 flex justify-end">
      <button
        type="button"
        id="btn-done-reading"
        class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors cursor-pointer"
      >
        {t('blogs.closeArticle', locale)}
      </button>
    </div>
  </div>
</div>
