---
import '../styles/global.css';
import {
  getLocale,
  getDir,
  getAllHreflangLinks,
  t,
  type SupportedLocale,
  DEFAULT_LOCALE,
  SUPPORTED_LOCALES
} from '../locales';
import { getCanonicalUrl, SITE_URL } from '../utils/canonical';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  currentLocale?: SupportedLocale;
  noindex?: boolean;
}

const {
  currentLocale = DEFAULT_LOCALE,
  title,
  description,
  keywords,
  canonicalUrl,
  noindex = false,
} = Astro.props;

const locale = getLocale(currentLocale);
const dir = getDir(locale);

const metaTitle = title || t('meta.title', locale);
const metaDescription = description || t('meta.description', locale);
const metaKeywords = keywords || t('meta.keywords', locale);

const siteUrl = SITE_URL;
const canonical = getCanonicalUrl(canonicalUrl || Astro.url.pathname, locale);
const ogImageUrl = `${siteUrl}/web-app-manifest-512x512.png`;

// Hreflang links for SEO (omitted for noindex pages)
const hreflangLinks = noindex ? [] : getAllHreflangLinks(Astro.url.pathname, siteUrl);

// Locale mappings for Open Graph
const ogLocaleMap: Record<SupportedLocale, string> = {
  en: 'en_US',
  hi: 'hi_IN',
  es: 'es_ES',
  de: 'de_DE',
  fr: 'fr_FR',
  pt: 'pt_PT',
  ja: 'ja_JP',
  ko: 'ko_KR'
};
const ogLocale = ogLocaleMap[locale] || 'en_US';

// JSON-LD Structured Data: WebApplication, WebSite, Organization, BreadcrumbList, and localized FAQPage
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": t('meta.siteName', locale),
    "url": canonical,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "All",
    "browserRequirements": "Requires JavaScript. Requires HTML5.",
    "description": metaDescription,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Live In-Browser Expense Tracking",
      "Multi-Format Receipt Photo OCR Scanner",
      "Free Expense Tracker Google Sheets Templates",
      "Free Expense Tracker Spreadsheet in Excel (.xlsx)",
      "Printable Monthly PDF Expense Booklets",
      "Debt Snowball & Avalanche Payoff Calculator",
      "50/30/20 Target Savings Goal Planner",
      "100% Client-Side Private Storage"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": t('meta.siteName', locale),
    "url": canonical,
    "description": metaDescription,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Free Expense Tracker",
    "url": `${siteUrl}/`,
    "logo": `${siteUrl}/web-app-manifest-512x512.png`,
    "description": "Free web-based personal expense tracking application and financial spreadsheet template library."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": t('meta.siteName', locale),
        "item": `${siteUrl}/`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [1, 2, 3, 4, 5, 6, 7, 8].map((num) => ({
      "@type": "Question",
      "name": t(`faq.q${num}`, locale),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t(`faq.a${num}`, locale)
      }
    }))
  }
];
---

<!doctype html>
<html lang={locale} dir={dir} data-locale={locale} class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="freexpensetracker.com" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XR6MG2FM4M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XR6MG2FM4M');
    </script>
    
    <!-- Primary SEO Meta Tags -->
    <title>{metaTitle}</title>
    <meta name="title" content={metaTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="author" content="Free Expense Tracker" />
    <meta name="theme-color" content="#0f766e" />

    <!-- Multilingual Alternate Hreflang Tags & x-default -->
    {!noindex && hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('meta.siteName', locale)} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@freexpensetrack" />
    <meta name="twitter:creator" content="@freexpensetrack" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={metaTitle} />

    <!-- Google Fonts: Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data Schema -->
    {!noindex && structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Instant Dark Mode Init to Prevent Flash of Unstyled Content -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- Language Persistence & First-Visit Browser Detection -->
    <script is:inline>
      (function() {
        try {
          const storedLang = localStorage.getItem('user_language');
          const pathname = window.location.pathname;
          const isRoot = pathname === '/' || pathname === '';

          if (isRoot) {
            if (storedLang && storedLang !== 'en') {
              const supported = ['hi', 'es', 'de', 'fr', 'pt', 'ja', 'ko'];
              if (supported.includes(storedLang)) {
                window.location.replace('/' + storedLang + '/');
                return;
              }
            } else if (!storedLang) {
              // First visit detection: check navigator.language
              const navLang = (navigator.language || navigator.userLanguage || '').toLowerCase().split('-')[0];
              const supported = ['hi', 'es', 'de', 'fr', 'pt', 'ja', 'ko'];
              if (supported.includes(navLang)) {
                window.location.replace('/' + navLang + '/');
                return;
              }
            }
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#F8FAFC] dark:bg-[#090D16] text-[#0F172A] dark:text-slate-100 selection:bg-emerald-100 dark:selection:bg-emerald-900 selection:text-emerald-900 dark:selection:text-emerald-100 overflow-x-hidden w-full transition-colors duration-200">
    <slot />

    <!-- Dark Mode Toggle Controller -->
    <script is:inline>
      function initThemeToggle() {
        const toggleBtn = document.getElementById('btn-theme-toggle');
        if (!toggleBtn || toggleBtn.dataset.themeBound) return;
        toggleBtn.dataset.themeBound = 'true';

        toggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          } catch (_) {}
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
    </script>

    <!-- Buy Me a Coffee Floating Widget -->
    <script
      is:inline
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="princeupads"
      data-description="Support me on Buy me a coffee!"
      data-message="Thanks for supporting independent projects! ❤️ Your contribution helps keep my tools useful, accessible, and improving."
      data-color="#FF813F"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"
    ></script>
  </body>
</html>
