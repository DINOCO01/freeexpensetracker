---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCanonicalUrl } from '../utils/canonical';
---

<Layout
  title="Contact Us - Free Expense Tracker | Feedback, Support & Template Requests"
  description="Get in touch with the Free Expense Tracker team. Send us feedback, suggest new spreadsheet templates, report bugs, or ask privacy questions."
  canonicalUrl={getCanonicalUrl('/contact-us/')}
>
  <Navbar />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-emerald-700 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Contact Us</span>
    </nav>

    <!-- Header -->
    <section class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
        <span>We'd Love to Hear From You</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight font-['Outfit',sans-serif]">
        Contact Our Team
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl">
        Have a feature suggestion, need a specific spreadsheet template, or spotted a bug? Send us a message and our team will get back to you promptly.
      </p>
    </section>

    <!-- 3 Direct Contact Cards -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs space-y-2">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-lg border border-emerald-200">
          💬
        </div>
        <h3 class="font-bold text-slate-900 text-sm font-['Outfit',sans-serif]">General Support</h3>
        <p class="text-xs text-slate-500">Assistance with tools, browser imports, or templates.</p>
        <a href="mailto:support@freexpensetracker.com" class="block text-xs font-bold text-emerald-700 hover:underline break-all">
          support@freexpensetracker.com
        </a>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs space-y-2">
        <div class="w-10 h-10 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-lg border border-teal-200">
          💡
        </div>
        <h3 class="font-bold text-slate-900 text-sm font-['Outfit',sans-serif]">Template Requests</h3>
        <p class="text-xs text-slate-500">Want a custom Google Sheets or Excel layout?</p>
        <a href="mailto:templates@freexpensetracker.com" class="block text-xs font-bold text-emerald-700 hover:underline break-all">
          templates@freexpensetracker.com
        </a>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs space-y-2">
        <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-700 flex items-center justify-center font-bold text-lg border border-sky-200">
          🔒
        </div>
        <h3 class="font-bold text-slate-900 text-sm font-['Outfit',sans-serif]">Privacy Inquiries</h3>
        <p class="text-xs text-slate-500">Questions about our client-side storage architecture.</p>
        <a href="mailto:privacy@freexpensetracker.com" class="block text-xs font-bold text-emerald-700 hover:underline break-all">
          privacy@freexpensetracker.com
        </a>
      </div>
    </section>

    <!-- Interactive Contact Form -->
    <section class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-xs space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Outfit',sans-serif]">
          Send Us a Direct Message
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Fill out the form below. Typical response time is within 24 to 48 hours.
        </p>
      </div>

      <!-- Success Notification Banner -->
      <div id="contact-success-banner" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-1">
        <div class="font-bold text-sm flex items-center gap-2">
          <span>✅</span> Message Received!
        </div>
        <p class="text-xs text-emerald-700">
          Thank you for reaching out. We have received your submission and will get back to you shortly.
        </p>
      </div>

      <form id="contact-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Name -->
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">
              Your Name
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="e.g. Alex Morgan"
              class="w-full text-xs rounded-xl border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-500 shadow-2xs"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1">
              Email Address
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="alex@example.com"
              class="w-full text-xs rounded-xl border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-500 shadow-2xs"
            />
          </div>
        </div>

        <!-- Topic Selector -->
        <div>
          <label for="contact-topic" class="block text-xs font-semibold text-slate-700 mb-1">
            Subject / Topic
          </label>
          <select
            id="contact-topic"
            name="topic"
            class="w-full text-xs rounded-xl border border-slate-300 px-3.5 py-2.5 text-slate-900 bg-white focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-500 shadow-2xs cursor-pointer"
          >
            <option value="feedback">💡 General Feedback & Ideas</option>
            <option value="template">📊 Request a New Spreadsheet Template</option>
            <option value="bug">🐛 Report a Bug or Issue</option>
            <option value="privacy">🔒 Privacy & Architecture Question</option>
            <option value="partnership">🤝 Partnership or Media Inquiry</option>
          </select>
        </div>

        <!-- Message -->
        <div>
          <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            placeholder="Tell us what's on your mind, describe your template request, or share feedback..."
            class="w-full text-xs sm:text-sm rounded-xl border border-slate-300 p-3.5 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-500 shadow-2xs"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full sm:w-auto px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold text-xs sm:text-sm transition-all shadow-xs cursor-pointer flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          Send Message
        </button>
      </form>
    </section>

    <!-- FAQ Link Card -->
    <section class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="font-bold text-slate-900 text-sm font-['Outfit',sans-serif]">Looking for immediate answers?</h4>
        <p class="text-xs text-slate-500">Check out our comprehensive FAQ covering security, DIY trackers, and free templates.</p>
      </div>
      <a
        href="/#section-faq"
        class="shrink-0 px-4 py-2 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors shadow-2xs"
      >
        View FAQ Section
      </a>
    </section>
  </main>

  <Footer />

  <script>
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBanner = document.getElementById('contact-success-banner');
    const submitBtn = contactForm?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    let isSubmittingContact = false;

    function trackFormComplete(formId: string, extra: Record<string, any> = {}) {
      try {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'form_complete', {
            form_id: formId,
            ...extra
          });
        }
      } catch (_) {
        // never throws
      }
    }

    if (contactForm && successBanner) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isSubmittingContact) return;
        if (typeof contactForm.checkValidity === 'function' && !contactForm.checkValidity()) {
          if (typeof contactForm.reportValidity === 'function') contactForm.reportValidity();
          return;
        }

        isSubmittingContact = true;
        const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = `
            <svg class="animate-spin w-4 h-4 text-white inline-block" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Sending...
          `;
        }

        const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
        const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
        const topicInput = document.getElementById('contact-topic') as HTMLSelectElement | null;
        const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

        const name = nameInput?.value.trim() || '';
        const email = emailInput?.value.trim() || '';
        const topic = topicInput?.value || 'feedback';
        const message = messageInput?.value.trim() || '';

        if (!name || !email || !message) {
          isSubmittingContact = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
          }
          return;
        }

        const payload = {
          name,
          email,
          topic,
          message,
          _subject: `FreeExpenseTracker Contact: ${topic.toUpperCase()} from ${name || 'User'}`,
          _captcha: 'false',
          _template: 'table'
        };

        try {
          const resp = await fetch('https://formsubmit.co/ajax/livetoolworld@gmail.com', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
          });
          if (!resp.ok) {
            throw new Error(`HTTP ${resp.status}`);
          }
          trackFormComplete('contact_us', { form_type: 'contact', topic });
          successBanner.classList.remove('hidden');
          contactForm.reset();
          successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch (err) {
          console.error('Contact form submission error:', err);
        } finally {
          isSubmittingContact = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
          }
        }
      });
    }
  </script>
</Layout>
