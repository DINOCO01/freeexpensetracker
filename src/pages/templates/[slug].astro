  {template.slug === 'debt-snowball' && (
    <script is:inline>
      // Interactive Debt Snowball Calculator (only on debt-snowball)
      (function initSnowballCalculator() {
        try {
          var calcSection = document.getElementById('interactive-snowball-calculator');
          var tbody = document.getElementById('snowball-debts-body');
          var extraInput = document.getElementById('input-snowball-extra');
          if (!calcSection || !tbody || !extraInput) return;

          var btnAdd = document.getElementById('btn-add-snowball-debt');
          var resultMonths = document.getElementById('calc-result-months');
          var resultDate = document.getElementById('calc-result-date');
          var resultInterest = document.getElementById('calc-result-interest');
          var resultSaved = document.getElementById('calc-result-saved');
          var timelineList = document.getElementById('calc-timeline-list');

          function recalculateSnowball() {
            try {
              if (!tbody) return;
              var rows = tbody.querySelectorAll('.debt-row');
              var debts = [];
              if (rows) {
                rows.forEach(function(r) {
                  var nameEl = r.querySelector('.debt-name');
                  var balEl = r.querySelector('.debt-balance');
                  var rateEl = r.querySelector('.debt-rate');
                  var minEl = r.querySelector('.debt-min');

                  var name = (nameEl && nameEl.value) ? nameEl.value : 'Debt';
                  var balance = balEl ? (parseFloat(balEl.value) || 0) : 0;
                  var rate = rateEl ? (parseFloat(rateEl.value) || 0) : 0;
                  var minPay = minEl ? (parseFloat(minEl.value) || 0) : 0;
                  if (balance > 0 && minPay > 0) {
                    debts.push({ name: name, balance: balance, rate: rate, minPay: minPay });
                  }
                });
              }

              var extra = (extraInput && extraInput.value) ? (parseFloat(extraInput.value) || 0) : 0;
              if (debts.length === 0) {
                if (resultMonths) resultMonths.textContent = '0 Months';
                if (resultInterest) resultInterest.textContent = '$0';
                if (resultSaved) resultSaved.textContent = '$0';
                return;
              }

              // Snowball: Sort by balance ascending
              debts.sort(function(a, b) { return a.balance - b.balance; });

              // Simulate Snowball
              var simDebts = debts.map(function(d) {
                return { name: d.name, balance: d.balance, rate: d.rate, minPay: d.minPay, paidOffMonth: 0 };
              });

              var month = 0;
              var totalInterestPaid = 0;
              var maxMonths = 360;

              while (month < maxMonths) {
                var activeDebts = simDebts.filter(function(d) { return d.balance > 0; });
                if (activeDebts.length === 0) break;
                month++;

                var freedSnowball = extra;
                simDebts.forEach(function(d) {
                  if (d.balance <= 0) {
                    freedSnowball += d.minPay;
                  }
                });

                // Accrue interest on all active debts
                activeDebts.forEach(function(d) {
                  var monthlyInterest = d.balance * (d.rate / 100 / 12);
                  totalInterestPaid += monthlyInterest;
                  d.balance += monthlyInterest;
                });

                // Pay minimums first
                activeDebts.forEach(function(d) {
                  var payment = Math.min(d.balance, d.minPay);
                  d.balance -= payment;
                  if (d.balance <= 0.01 && d.paidOffMonth === 0) {
                    d.paidOffMonth = month;
                  }
                });

                // Apply all freed-up snowball cash to the smallest remaining balance
                var targetDebt = activeDebts.find(function(d) { return d.balance > 0.01; });
                if (targetDebt && freedSnowball > 0) {
                  var snowPayment = Math.min(targetDebt.balance, freedSnowball);
                  targetDebt.balance -= snowPayment;
                  if (targetDebt.balance <= 0.01 && targetDebt.paidOffMonth === 0) {
                    targetDebt.paidOffMonth = month;
                  }
                }
              }

              // Simulate minimums only for baseline comparison
              var minDebts = debts.map(function(d) {
                return { balance: d.balance, rate: d.rate, minPay: d.minPay };
              });
              var minMonth = 0;
              var minInterest = 0;
              while (minMonth < maxMonths) {
                var act = minDebts.filter(function(d) { return d.balance > 0; });
                if (act.length === 0) break;
                minMonth++;
                act.forEach(function(d) {
                  var intCost = d.balance * (d.rate / 100 / 12);
                  minInterest += intCost;
                  d.balance += intCost;
                  d.balance -= Math.min(d.balance, d.minPay);
                });
              }

              var saved = Math.max(0, minInterest - totalInterestPaid);

              if (resultMonths) resultMonths.textContent = month + ' Months';
              if (resultInterest) resultInterest.textContent = '$' + Math.round(totalInterestPaid).toLocaleString();
              if (resultSaved) resultSaved.textContent = '$' + Math.round(saved).toLocaleString();

              var estDate = new Date();
              estDate.setMonth(estDate.getMonth() + month);
              var dateStr = estDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
              if (resultDate) resultDate.textContent = 'Debt-Free by ' + dateStr;

              if (timelineList) {
                timelineList.innerHTML = simDebts.map(function(d, idx) {
                  var m = d.paidOffMonth || month;
                  return '<div class="flex items-center justify-between p-2 rounded-xl bg-white border border-slate-200/80">' +
                    '<span><strong>#' + (idx + 1) + ' ' + d.name + '</strong></span>' +
                    '<span class="font-mono text-emerald-800 font-bold">Paid off in Month ' + m + '</span>' +
                  '</div>';
                }).join('');
              }
            } catch (_) {}
          }

          tbody.addEventListener('input', recalculateSnowball);
          extraInput.addEventListener('input', recalculateSnowball);

          tbody.addEventListener('click', function(e) {
            try {
              if (e && e.target && e.target.classList && e.target.classList.contains('btn-remove-row')) {
                var row = e.target.closest('.debt-row');
                if (row && tbody.querySelectorAll('.debt-row').length > 1) {
                  row.remove();
                  recalculateSnowball();
                }
              }
            } catch (_) {}
          });

          if (btnAdd) {
            btnAdd.addEventListener('click', function() {
              try {
                var tr = document.createElement('tr');
                tr.className = 'debt-row';
                tr.innerHTML = '<td class="py-2 px-2"><input type="text" class="debt-name w-full p-2 rounded-lg border border-slate-200 font-medium" value="Personal Loan" /></td>' +
                  '<td class="py-2 px-2"><input type="number" class="debt-balance w-28 p-2 rounded-lg border border-slate-200 font-mono font-bold" value="1500" min="0" step="any" /></td>' +
                  '<td class="py-2 px-2"><input type="number" class="debt-rate w-24 p-2 rounded-lg border border-slate-200 font-mono" value="10" min="0" max="100" step="any" /></td>' +
                  '<td class="py-2 px-2"><input type="number" class="debt-min w-24 p-2 rounded-lg border border-slate-200 font-mono" value="60" min="1" step="any" /></td>' +
                  '<td class="py-2 px-2 text-center"><button type="button" class="btn-remove-row text-slate-400 hover:text-rose-600 px-2 py-1 font-bold">✕</button></td>';
                tbody.appendChild(tr);
                recalculateSnowball();
              } catch (_) {}
            });
          }

          recalculateSnowball();
        } catch (_) {}
      })();
    </script>
  )}

  {template.slug === '52-week-savings-challenge' && (
    <script is:inline>
      // Interactive 52-Week Savings Calculator (only on 52-week-savings-challenge)
      (function initSavingsChallengeCalculator() {
        try {
          var calcSection = document.getElementById('interactive-challenge-calculator');
          var inputStart = document.getElementById('input-challenge-start');
          var inputStep = document.getElementById('input-challenge-step');
          var btnStandard = document.getElementById('btn-mode-standard');
          var btnReverse = document.getElementById('btn-mode-reverse');
          var totalDisplay = document.getElementById('calc-challenge-total');
          var avgDisplay = document.getElementById('calc-challenge-avg');
          var peakDisplay = document.getElementById('calc-challenge-peak');
          var peakLabel = document.getElementById('calc-challenge-peak-label');
          var tbody = document.getElementById('challenge-schedule-body');

          if (!calcSection || !inputStart || !inputStep || !tbody) return;

          var isReverse = false;

          function formatMoney(num) {
            return '$' + (Number(num) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          }

          function renderChallenge() {
            try {
              var start = parseFloat(inputStart.value);
              if (isNaN(start) || start <= 0) start = 1;
              var step = parseFloat(inputStep.value);
              if (isNaN(step) || step < 0) step = 1;

              var total = 0;
              var rowsHtml = '';
              var weeklyAmounts = [];

              if (!isReverse) {
                // Standard: Week 1 is start, each subsequent week adds step
                for (var w = 1; w <= 52; w++) {
                  var amount = start + (w - 1) * step;
                  weeklyAmounts.push(amount);
                  total += amount;
                }
              } else {
                // Reverse: Week 1 is largest deposit, descending by step
                var maxDeposit = start + 51 * step;
                for (var w = 1; w <= 52; w++) {
                  var amount = maxDeposit - (w - 1) * step;
                  weeklyAmounts.push(amount);
                  total += amount;
                }
              }

              var cumulative = 0;
              for (var i = 0; i < 52; i++) {
                var wk = i + 1;
                var dep = weeklyAmounts[i];
                cumulative += dep;
                var quarter = wk <= 13 ? 'Q1' : wk <= 26 ? 'Q2' : wk <= 39 ? 'Q3' : 'Q4';
                var qClass = wk <= 13 ? 'bg-sky-50 text-sky-700' : wk <= 26 ? 'bg-teal-50 text-teal-700' : wk <= 39 ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700';

                rowsHtml += '<tr class="hover:bg-slate-50 transition-colors">' +
                  '<td class="py-2 px-3 font-bold text-slate-800">Week ' + wk + '</td>' +
                  '<td class="py-2 px-3 text-right font-medium text-slate-900">' + formatMoney(dep) + '</td>' +
                  '<td class="py-2 px-3 text-right font-bold text-emerald-800">' + formatMoney(cumulative) + '</td>' +
                  '<td class="py-2 px-3 text-center"><span class="px-2 py-0.5 rounded text-[10px] font-bold ' + qClass + '">' + quarter + '</span></td>' +
                  '</tr>';
              }

              tbody.innerHTML = rowsHtml;
              if (totalDisplay) totalDisplay.textContent = formatMoney(total);
              if (avgDisplay) avgDisplay.textContent = formatMoney(total / 52);
              if (peakDisplay) peakDisplay.textContent = formatMoney(weeklyAmounts[51]);
              if (peakLabel) peakLabel.textContent = isReverse ? 'Week 52 final deposit (easiest week!)' : 'Week 52 final deposit (peak week)';
            } catch (_) {}
          }

          if (btnStandard && btnReverse) {
            btnStandard.addEventListener('click', function() {
              isReverse = false;
              btnStandard.className = 'py-1.5 px-2 rounded-lg text-xs font-bold transition-all bg-white text-emerald-800 shadow-2xs cursor-pointer';
              btnReverse.className = 'py-1.5 px-2 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 cursor-pointer';
              renderChallenge();
            });

            btnReverse.addEventListener('click', function() {
              isReverse = true;
              btnReverse.className = 'py-1.5 px-2 rounded-lg text-xs font-bold transition-all bg-white text-emerald-800 shadow-2xs cursor-pointer';
              btnStandard.className = 'py-1.5 px-2 rounded-lg text-xs font-bold transition-all text-slate-600 hover:text-slate-900 cursor-pointer';
              renderChallenge();
            });
          }

          inputStart.addEventListener('input', renderChallenge);
          inputStep.addEventListener('input', renderChallenge);

          renderChallenge();
        } catch (_) {}
      })();
    </script>
  )}

