---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCanonicalUrl } from '../../utils/canonical';
import { TEMPLATES_DATA, type TemplateData } from '../../data/templatesData';

export function getStaticPaths() {
  return TEMPLATES_DATA.map((template) => ({
    params: { slug: template.slug },
    props: { template }
  }));
}

interface Props {
  template: TemplateData;
}

const { template } = Astro.props;
const downloadUrl = `/templates/${template.fileName}`;
const canonicalUrl = getCanonicalUrl(`/templates/${template.slug}/`);

const TEMPLATE_APP_TARGETS: Record<string, string> = {
  'paycheck-budget': '/?tab=budget&preset=paycheck',
  'debt-snowball': '/?tab=debt&preset=snowball',
  'debt-avalanche': '/?tab=debt&preset=avalanche',
  'debt-to-income-calculator': '/?tab=debt&preset=dti',
  'student-loan-planner': '/?tab=debt&preset=student-loan',
  'auto-loan-calculator': '/?tab=debt&preset=auto-loan',
  'mortgage-planner': '/?tab=debt&preset=mortgage',
  '401k-retirement-planner': '/?tab=goals&preset=retirement',
  'roth-ira-planner': '/?tab=goals&preset=roth-ira',
  'emergency-fund-planner': '/?tab=goals&preset=emergency-fund',
  'subscription-audit': '/?tab=tracker&preset=subscriptions',
  'sinking-fund-planner': '/?tab=goals&preset=sinking-fund',
  'net-worth-tracker': '/?tab=goals&preset=net-worth',
  'financial-dashboard': '/?tab=tracker&preset=dashboard',
  'monthly-spending-analyzer': '/?tab=tracker&preset=spending-analyzer',
  'monthly-bill-tracker': '/?tab=tracker&preset=bill-tracker',
  '52-week-savings-challenge': '/?tab=goals&preset=savings-challenge'
};

const appTargetUrl = TEMPLATE_APP_TARGETS[template.slug] || '/?tab=tracker';

// Related templates mapping for internal link architecture
const RELATED_TEMPLATES_MAP: Record<string, { slug: string; title: string; desc: string }[]> = {
  '52-week-savings-challenge': [
    { slug: 'emergency-fund-planner', title: 'Emergency Fund Planner', desc: 'Build a durable 3 to 6-month cash reserve for unexpected life events.' },
    { slug: 'sinking-fund-planner', title: 'Sinking Fund Planner', desc: 'Organize targeted savings buckets for irregular and seasonal expenses.' },
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Allocate funds from each paycheck directly into your savings goals.' }
  ],
  'sinking-fund-planner': [
    { slug: '52-week-savings-challenge', title: '52-Week Savings Challenge', desc: 'Build an extra $1,378 cash cushion with progressive weekly deposits.' },
    { slug: 'emergency-fund-planner', title: 'Emergency Fund Planner', desc: 'Protect your sinking funds with a baseline 3 to 6-month safety net.' },
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Sync sinking fund contributions with your regular paycheck cycle.' }
  ],
  'debt-snowball': [
    { slug: 'debt-avalanche', title: 'Debt Avalanche Spreadsheet', desc: 'Prioritize highest-interest APR debts first to save maximum total interest.' },
    { slug: 'debt-to-income-calculator', title: 'Debt-to-Income Calculator', desc: 'Assess your borrowing health and calculate front-end and back-end DTI.' },
    { slug: 'student-loan-planner', title: 'Student Loan Planner', desc: 'Model extra monthly payments and accelerated payoff schedules.' }
  ],
  'student-loan-planner': [
    { slug: 'debt-snowball', title: 'Debt Snowball Spreadsheet', desc: 'Knock out smallest balances first to build lasting financial momentum.' },
    { slug: 'debt-to-income-calculator', title: 'Debt-to-Income Calculator', desc: 'Track your total debt obligations against gross monthly earnings.' },
    { slug: 'debt-avalanche', title: 'Debt Avalanche Spreadsheet', desc: 'Attack highest-APR loans first for maximum lifetime interest savings.' }
  ],
  'monthly-bill-tracker': [
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Allocate net income per paycheck deposit before spending occurs.' },
    { slug: 'subscription-audit', title: 'Subscription Audit Worksheet', desc: 'Audit recurring digital subscriptions, streaming services, and bills.' },
    { slug: 'monthly-spending-analyzer', title: 'Monthly Spending Analyzer', desc: 'Categorize spending by merchant and detect budget leaks.' }
  ],
  'paycheck-budget': [
    { slug: '52-week-savings-challenge', title: '52-Week Savings Challenge', desc: 'Automate a $1,378 annual savings goal using weekly progressive deposits.' },
    { slug: 'emergency-fund-planner', title: 'Emergency Fund Planner', desc: 'Build a 3 to 6-month living expense cash safety net.' },
    { slug: 'monthly-bill-tracker', title: 'Monthly Bill Tracker', desc: 'Track recurring monthly bills, calendar due dates, and autopay status.' }
  ],
  'subscription-audit': [
    { slug: 'monthly-bill-tracker', title: 'Monthly Bill Tracker', desc: 'Centralize recurring bills, payment deadlines, and auto-debit amounts.' },
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Plan every dollar per pay cycle with take-home pay and fixed bills.' },
    { slug: 'monthly-spending-analyzer', title: 'Monthly Spending Analyzer', desc: 'Review historical spending categories and identify cost leaks.' }
  ],
  'emergency-fund-planner': [
    { slug: '52-week-savings-challenge', title: '52-Week Savings Challenge', desc: 'Jumpstart your starter emergency fund by saving $1,378 in one year.' },
    { slug: 'sinking-fund-planner', title: 'Sinking Fund Planner', desc: 'Organize targeted reserves for predictable future expenses.' },
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Allocate funds per paycheck directly into your emergency savings.' }
  ],
  'financial-dashboard': [
    { slug: 'monthly-spending-analyzer', title: 'Monthly Spending Analyzer', desc: 'Break down categorized spending trends feeding your financial dashboard.' },
    { slug: '52-week-savings-challenge', title: '52-Week Savings Challenge', desc: 'Channel positive monthly cash flow into a structured $1,378 savings ladder.' },
    { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Assign every dollar from net take-home pay to expenses and savings goals.' }
  ],
  'monthly-spending-analyzer': [
    { slug: 'financial-dashboard', title: 'Financial Dashboard', desc: 'Consolidate monthly cash flow, savings rate, and net worth in one workbook.' },
    { slug: '52-week-savings-challenge', title: '52-Week Savings Challenge', desc: 'Redirect trimmed discretionary spending into weekly automated deposits.' },
    { slug: 'sinking-fund-planner', title: 'Sinking Fund Planner', desc: 'Plan ahead for annual bills, car maintenance, and seasonal travel costs.' }
  ]
};

const relatedTemplates = RELATED_TEMPLATES_MAP[template.slug] || [
  { slug: 'paycheck-budget', title: 'Paycheck Budget Spreadsheet', desc: 'Plan every dollar per pay cycle with take-home pay and fixed bills.' },
  { slug: 'monthly-bill-tracker', title: 'Monthly Bill Tracker', desc: 'Centralize recurring bills, due dates, and autopay tracking.' },
  { slug: 'debt-snowball', title: 'Debt Snowball Spreadsheet', desc: 'Eliminate consumer debt with behavioral momentum.' }
];
---

<Layout
  title={template.title}
  description={template.metaDescription}
  canonicalUrl={canonicalUrl}
  faqSchema={template.faq}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Templates', url: '/templates/' },
    { name: template.slug === '52-week-savings-challenge' ? '52-Week Savings Challenge' : template.h1, url: `/templates/${template.slug}/` }
  ]}
>
  <Navbar />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-700 transition-colors">Home</a>
      <span>/</span>
      <a href="/templates/" class="hover:text-emerald-700 transition-colors">Templates</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold" aria-current="page">{template.h1}</span>
    </nav>

    <!-- Hero Header -->
    <header class="space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
          <span>{template.categoryIcon}</span>
          <span>{template.category}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-slate-100 text-slate-700 border border-slate-200">
          <span>📊</span>
          <span>Excel .xlsx</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono text-slate-500 bg-slate-50 border border-slate-200">
          <span>💾</span>
          <span>{template.fileSize}</span>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight font-['Outfit',sans-serif]">
        {template.h1}
      </h1>

      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl">
        {template.overview}
      </p>

      <!-- TOP CTA BLOCK: Prefer not to use a spreadsheet? -->
      <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border border-emerald-200/90 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 text-base shadow-xs">
            ⚡
          </div>
          <div>
            <p class="text-xs sm:text-sm font-bold text-slate-900 font-['Outfit',sans-serif]">
              Prefer not to use a spreadsheet?
            </p>
            <p class="text-xs text-slate-600">
              Track this free in your browser with zero setup or sign-up.
            </p>
          </div>
        </div>
        <a
          href={appTargetUrl}
          data-template-id={template.slug}
          class="template-to-app-btn shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] transition-all shadow-xs cursor-pointer"
        >
          <span>Track Free in Browser &rarr;</span>
        </a>
      </div>

      <!-- Primary Action: Direct Download & Hub Back-link -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
        <a
          href={downloadUrl}
          download={template.fileName}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold text-white bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] transition-all shadow-md shadow-emerald-700/15 cursor-pointer"
          aria-label={`Download ${template.fileName}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>{template.slug === '52-week-savings-challenge' ? 'Download the 52-Week Savings Challenge (Excel)' : 'Download Free Template (.xlsx)'}</span>
        </a>
        <a
          href="/templates/"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3 rounded-xl text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
        >
          <span>&larr;</span>
          <span>All Templates</span>
        </a>
      </div>
    </header>

    {/* SPECIALIZED DEEP-DIVE & INTERACTIVE CALCULATOR: Debt Snowball */}
    {template.slug === 'debt-snowball' && (
      <>
        <!-- Interactive Debt Snowball Calculator Section -->
        <section id="interactive-snowball-calculator" class="bg-white border-2 border-emerald-500/80 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
            <div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                <span>🧮</span>
                <span>Interactive Tool</span>
              </span>
              <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-['Outfit',sans-serif] mt-1">
                Live Debt Snowball Calculator
              </h2>
              <p class="text-xs sm:text-sm text-slate-600">
                Input your balances and see your customized payoff order, debt-free date, and total interest saved in real time.
              </p>
            </div>
            <div class="text-right">
              <span class="text-xs font-mono text-emerald-700 font-semibold bg-emerald-50 px-3 py-1 rounded-lg border border-emerald-200">
                100% Client-Side Math
              </span>
            </div>
          </div>

          <!-- Debt Input Rows Form -->
          <div class="space-y-4">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="border-b border-slate-200 text-slate-500 uppercase font-mono text-[10px]">
                    <th class="py-2 px-2">Debt Name</th>
                    <th class="py-2 px-2">Balance ($)</th>
                    <th class="py-2 px-2">Interest Rate (APR %)</th>
                    <th class="py-2 px-2">Min Payment ($)</th>
                    <th class="py-2 px-2 text-center">Action</th>
                  </tr>
                </thead>
                <tbody id="snowball-debts-body" class="divide-y divide-slate-100">
                  <tr class="debt-row">
                    <td class="py-2 px-2"><input type="text" class="debt-name w-full p-2 rounded-lg border border-slate-200 font-medium" value="Medical Bill" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-balance w-28 p-2 rounded-lg border border-slate-200 font-mono font-bold" value="600" min="0" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-rate w-24 p-2 rounded-lg border border-slate-200 font-mono" value="0" min="0" max="100" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-min w-24 p-2 rounded-lg border border-slate-200 font-mono" value="50" min="1" step="any" /></td>
                    <td class="py-2 px-2 text-center"><button type="button" class="btn-remove-row text-slate-400 hover:text-rose-600 px-2 py-1 font-bold">✕</button></td>
                  </tr>
                  <tr class="debt-row">
                    <td class="py-2 px-2"><input type="text" class="debt-name w-full p-2 rounded-lg border border-slate-200 font-medium" value="Credit Card" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-balance w-28 p-2 rounded-lg border border-slate-200 font-mono font-bold" value="2400" min="0" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-rate w-24 p-2 rounded-lg border border-slate-200 font-mono" value="19.9" min="0" max="100" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-min w-24 p-2 rounded-lg border border-slate-200 font-mono" value="85" min="1" step="any" /></td>
                    <td class="py-2 px-2 text-center"><button type="button" class="btn-remove-row text-slate-400 hover:text-rose-600 px-2 py-1 font-bold">✕</button></td>
                  </tr>
                  <tr class="debt-row">
                    <td class="py-2 px-2"><input type="text" class="debt-name w-full p-2 rounded-lg border border-slate-200 font-medium" value="Auto Loan" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-balance w-28 p-2 rounded-lg border border-slate-200 font-mono font-bold" value="7000" min="0" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-rate w-24 p-2 rounded-lg border border-slate-200 font-mono" value="6.5" min="0" max="100" step="any" /></td>
                    <td class="py-2 px-2"><input type="number" class="debt-min w-24 p-2 rounded-lg border border-slate-200 font-mono" value="210" min="1" step="any" /></td>
                    <td class="py-2 px-2 text-center"><button type="button" class="btn-remove-row text-slate-400 hover:text-rose-600 px-2 py-1 font-bold">✕</button></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <button
                type="button"
                id="btn-add-snowball-debt"
                class="px-3.5 py-1.5 rounded-xl border border-dashed border-emerald-600 text-emerald-800 text-xs font-semibold hover:bg-emerald-50 transition-colors"
              >
                + Add Another Debt
              </button>
              <div class="flex items-center gap-2">
                <label for="input-snowball-extra" class="text-xs font-bold text-slate-700 whitespace-nowrap">
                  Extra Monthly Snowball:
                </label>
                <div class="relative">
                  <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs">$</span>
                  <input
                    type="number"
                    id="input-snowball-extra"
                    class="pl-6 pr-3 py-1.5 rounded-xl border border-slate-300 w-28 text-xs font-mono font-bold text-slate-900"
                    value="155"
                    min="0"
                    step="10"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Dynamic Output KPI Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-1">
              <div class="text-[10px] font-mono uppercase tracking-wider text-emerald-800 font-bold">Debt-Free In</div>
              <div id="calc-result-months" class="text-2xl font-extrabold text-emerald-900 font-mono">22 Months</div>
              <div id="calc-result-date" class="text-xs text-emerald-700 font-medium">Estimated Date</div>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-center space-y-1">
              <div class="text-[10px] font-mono uppercase tracking-wider text-slate-600 font-bold">Total Interest Paid</div>
              <div id="calc-result-interest" class="text-2xl font-extrabold text-slate-900 font-mono">$842</div>
              <div class="text-xs text-slate-500">With snowball acceleration</div>
            </div>
            <div class="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-center space-y-1">
              <div class="text-[10px] font-mono uppercase tracking-wider text-teal-800 font-bold">Interest Saved</div>
              <div id="calc-result-saved" class="text-2xl font-extrabold text-teal-900 font-mono">$1,480</div>
              <div class="text-xs text-teal-700 font-medium">Vs. minimum payments only</div>
            </div>
          </div>

          <!-- Payoff Sequence Timeline -->
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <h3 class="text-xs font-bold text-slate-900 font-mono uppercase">
              Snowball Payoff Sequence (Smallest Balance First):
            </h3>
            <div id="calc-timeline-list" class="space-y-1.5 text-xs text-slate-700">
              <!-- Dynamically populated -->
            </div>
          </div>
        </section>

        <!-- 350-500 Word Content Guide: Debt Snowball Method -->
        <article class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs space-y-6 text-slate-700 leading-relaxed">
          <div class="space-y-2 border-b border-slate-100 pb-4">
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-['Outfit',sans-serif]">
              Understanding the Debt Snowball Method
            </h2>
            <p class="text-xs sm:text-sm text-slate-500">
              Why behavioral momentum knocks out debt faster than pure mathematical interest formulas.
            </p>
          </div>

          <div class="space-y-4 text-xs sm:text-sm">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif]">
              What the Debt Snowball Method Is
            </h3>
            <p>
              The debt snowball is an accelerated debt-elimination strategy that organizes your debts from the smallest balance to the largest balance, regardless of interest rates. You commit to paying the minimum payment on every account except the smallest one. With the smallest debt, you throw every available extra dollar from your monthly budget at it until the balance is completely wiped out.
            </p>
            <p>
              While mathematical models suggest attacking high-interest rates first, the debt snowball works because human behavior drives personal finance. Eliminating a small debt in just two or three months delivers an immediate psychological boost. That early sense of victory creates momentum, proving that your debt-free goal is attainable and keeping you committed over the long haul.
            </p>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif] pt-2">
              Worked Example: Three Debts in Action
            </h3>
            <p>
              To see the snowball effect in practice, consider someone with three consumer debts and a total debt payoff budget of $500 per month:
            </p>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-1 font-mono text-xs text-slate-800">
              <div>1. <strong>Medical Bill</strong>: $600 balance ($50 monthly minimum)</div>
              <div>2. <strong>Credit Card</strong>: $2,400 balance ($85 monthly minimum at 19.9% APR)</div>
              <div>3. <strong>Auto Loan</strong>: $7,000 balance ($210 monthly minimum at 6.5% APR)</div>
            </div>
            <p>
              Their contractual minimum payments total $345 ($50 + $85 + $210), leaving $155 in extra monthly cash.
            </p>
            <ul class="space-y-2 list-disc list-inside">
              <li><strong>Months 1 to 3</strong>: The borrower pays $205 per month ($50 minimum + $155 extra) toward the $600 medical bill while maintaining minimums on the credit card and car. In under three months, Debt #1 is completely eliminated.</li>
              <li><strong>Months 4 to 11</strong>: The full $205 is rolled directly into the credit card. The monthly credit card payment jumps to $290 ($85 minimum + $205 snowball). That $2,400 balance is paid off in roughly 8 months.</li>
              <li><strong>Months 12 and Beyond</strong>: The entire $500 monthly budget rolls into the $7,000 auto loan. With $500 hitting the principal every month, the vehicle is paid off years ahead of schedule.</li>
            </ul>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif] pt-2">
              Snowball vs. Avalanche: Which Should You Choose?
            </h3>
            <p>
              The debt snowball prioritizes psychological momentum by paying off your smallest account balances first, while the debt avalanche attacks your highest-interest debts first to save the maximum amount on interest charges. If your primary goal is minimizing lifetime interest rather than quick motivational wins, check out our <a href="/templates/debt-avalanche/" class="text-emerald-700 hover:text-emerald-800 font-semibold underline">free debt avalanche spreadsheet</a>.
            </p>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif] pt-2">
              How to Use This Spreadsheet in 4 Steps
            </h3>
            <ol class="space-y-2 list-decimal list-inside">
              <li><strong>List Your Debts Smallest to Largest</strong>: Input all non-mortgage loans and credit cards into the sheet, sorted strictly in ascending order by current balance.</li>
              <li><strong>Record Balances, Rates, and Minimums</strong>: Fill in each account's current payoff amount, interest rate (APR), and monthly minimum obligation.</li>
              <li><strong>Set Your Extra Monthly Snowball</strong>: Enter the extra cash you can comfortably direct toward debt repayment each month into the acceleration box.</li>
              <li><strong>Follow the Roll-Forward Plan</strong>: Pay the calculated snowball payment on Debt #1, make minimum payments on the rest, and update the sheet as each account hits zero.</li>
            </ol>
          </div>
        </article>
      </>
    )}

    {/* SPECIALIZED DEEP-DIVE: Student Loan Planner */}
    {template.slug === 'student-loan-planner' && (
      <article class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xs space-y-6 text-slate-700 leading-relaxed">
        <div class="space-y-2 border-b border-slate-100 pb-4">
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-['Outfit',sans-serif]">
            Student Loan Payoff Timelines, Prepayment &amp; Refinancing Guide
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            A comprehensive overview of how amortization timelines work, how extra payments crush interest, and when refinancing makes sense.
          </p>
        </div>

        <div class="space-y-4 text-xs sm:text-sm">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif]">
            Understanding Student Loan Payoff Timelines
          </h3>
          <p>
            Understanding how student loan interest accumulates and how payoff timelines are calculated is the essential foundation for becoming debt-free. The vast majority of federal and private student loans default to a standard 10-year (120-month) repayment timeline. While extended repayment options or income-driven repayment plans lower your mandatory monthly payment by stretching your schedule across 20 to 25 years, they dramatically increase the total interest paid over the life of your debt. For example, a $35,000 student loan at a 6.8% interest rate costs approximately $13,200 in total interest under a standard 10-year term, but surges to more than $31,000 in interest if extended across 20 years.
          </p>

          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif] pt-2">
            The Power of Extra Principal Payments
          </h3>
          <p>
            The most potent lever borrowers control is making targeted extra principal payments. Student loans accrue interest daily based on the simple interest formula: current principal multiplied by the annual interest rate divided by 365. Whenever you make a payment beyond your mandatory monthly minimum, that extra cash reduces the outstanding principal balance immediately (always verify with your loan servicer that extra funds are applied to principal rather than advancing your next due date). Because subsequent daily interest charges are calculated on this reduced principal, extra payments trigger a powerful compounding savings effect. Contributing just $75 to $150 extra each month toward a $35,000 balance eliminates almost three full years of payments and saves over $4,000 in direct out-of-pocket interest.
          </p>

          <h3 class="text-base sm:text-lg font-bold text-slate-900 font-['Outfit',sans-serif] pt-2">
            Student Loan Refinancing Basics: Private vs. Federal Debt
          </h3>
          <p>
            When structuring a comprehensive payoff strategy, many borrowers also evaluate student loan refinancing. Refinancing replaces one or more existing student loans with a brand-new loan from a private lender at a lower interest rate or different repayment term. If you carry private student loans with double-digit interest rates (often 8% to 14% APR) and have built a strong credit score and steady income, refinancing can instantly lower your monthly payment or overall borrowing costs.
          </p>
          <p>
            However, refinancing federal student loans into private debt requires extreme caution. Private refinancing permanently strips away federal borrower protections, including income-driven repayment plans (such as SAVE and PAYE), Public Service Loan Forgiveness (PSLF), and access to federal administrative deferment or forbearance during unexpected hardship. As a general rule, maintain federal protections for federal balances and focus refinancing and accelerated payoffs aggressively on private student debt.
          </p>
          <p class="pt-2 text-xs text-slate-500">
            Compare payoff approaches with our <a href="/templates/debt-snowball/" class="text-emerald-700 hover:text-emerald-800 font-semibold underline">free debt snowball spreadsheet</a> or evaluate your overall debt load with the <a href="/templates/debt-to-income-calculator/" class="text-emerald-700 hover:text-emerald-800 font-semibold underline">debt-to-income calculator</a>.
          </p>
        </div>
