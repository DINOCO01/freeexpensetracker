  const btnStratAvalanche = document.getElementById('btn-strat-avalanche');
  const btnStratSnowball = document.getElementById('btn-strat-snowball');
  const activeStrategyPill = document.getElementById('active-strategy-pill');
  const debtsTbody = document.getElementById('debts-tbody');
  const formAddDebt = document.getElementById('form-add-debt') as HTMLFormElement;
  const inputDebtName = document.getElementById('input-debt-name') as HTMLInputElement;
  const inputDebtBalance = document.getElementById('input-debt-balance') as HTMLInputElement;
  const inputDebtRate = document.getElementById('input-debt-rate') as HTMLInputElement;
  const inputDebtMinimum = document.getElementById('input-debt-minimum') as HTMLInputElement;

