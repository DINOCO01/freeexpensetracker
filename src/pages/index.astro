  // Logger Form
  const formExpenseLogger = document.getElementById('form-expense-logger') as HTMLFormElement;
  const inputItemName = document.getElementById('input-item-name') as HTMLInputElement;
  const inputItemAmount = document.getElementById('input-item-amount') as HTMLInputElement;
  const selectItemCategory = document.getElementById('select-item-category') as HTMLSelectElement;
  const presetChips = document.querySelectorAll('.btn-preset-chip');
  const btnScanReceiptLogger = document.getElementById('btn-scan-receipt-logger');
  const inputReceiptPhoto = document.getElementById('input-receipt-photo') as HTMLInputElement;
  const receiptScanningIndicator = document.getElementById('receipt-scanning-indicator');
