  // --- 2. Blog Articles Database: Educational Guides ---
  const BLOG_ARTICLES: Record<string, { title: string; category: string; readTime: string; contentHtml: string }> = {
    'blog-1': {
      title: 'Automating Your Financial Life: How to Build a Frictionless Payday Routine',
      category: 'Financial Systems & Habits',
      readTime: '6 min read',
      contentHtml: `
        <p>Relying on manual discipline and daily willpower to manage personal finances is exhausting and error-prone. The most reliable way to achieve consistent financial success is to <strong>automate your money flow</strong> on the day you get paid.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">1. The Three-Account Triage System</h4>
        <p>A simple, powerful architecture to eliminate cognitive stress involves segregating cash across three distinct accounts:</p>
        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 mt-1">
          <li><strong>Salary & Fixed Bills Account:</strong> Where your paycheck lands and from where mandatory obligations (rent/mortgage, utilities, EMIs, insurance) are auto-debited.</li>
          <li><strong>Wealth & Emergency Bucket:</strong> High-yield savings or mutual fund SIPs that debit automatically 24–48 hours after salary day.</li>
          <li><strong>Discretionary Living Account:</strong> A separate checking account or UPI-linked card loaded with your budgeted "guilt-free spending" for food, dining, and leisure.</li>
        </ul>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">2. Synchronizing Debit Dates 24 Hours Post-Payday</h4>
        <p>Schedule your systematic investment transfers (SIPs, PPF, index funds) and major loan EMIs to process 1 to 2 business days after your usual salary credit date. This ensures your savings and debt pre-payments are captured before discretionary month-end spending begins.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">3. The Psychological Advantage: Guilt-Free Spending</h4>
        <p>When bills and long-term investments are funded automatically on day one, whatever remains in your discretionary account can be spent without guilt, hesitation, or complex spreadsheet calculations.</p>

        <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 my-3">
          <strong>Advisory Note:</strong> Review your automated transfers twice a year or whenever your income changes. A system that runs smoothly on autopilot protects your financial future even during your busiest work weeks.
        </div>
      `
    },
    'blog-2': {
      title: 'Plugging Silent Cash Flow Leaks: Auditing Subscriptions & Lifestyle Creep',
      category: 'Pillar 1: Cash Flow',
      readTime: '5 min read',
      contentHtml: `
        <p>Even households with comfortable incomes can find themselves living paycheck to paycheck if their cash flow is allowed to drift without intentional boundaries.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">1. Identifying Frictionless Spending Leaks</h4>
        <p>Modern digital convenience makes spending almost imperceptible. Recurring app memberships, streaming bundles, delivery convenience fees, and quick-commerce orders slip past unnoticed because individual charges seem modest.</p>
        <p><strong>Practical Action:</strong> Conduct a quarterly statement audit. Highlight every recurring auto-debit and cancel any service not actively utilized within the preceding 30 days.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">2. Defeating Lifestyle Inflation</h4>
        <p>As career earnings grow, living expenses naturally tend to expand to consume the new ceiling through upgraded housing, frequent dining out, or vehicle upgrades.</p>
        <p><strong>The 50% Rule for Increments:</strong> Whenever you receive a raise, bonus, or new income stream, commit at least 50% of the net increase directly into automated investments before adjusting your discretionary lifestyle upward.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">3. The 72-Hour Impulse Delay</h4>
        <p>For any non-essential purchase exceeding ₹1,000, institute an intentional 72-hour cooling-off delay. In a significant number of instances, the initial emotional urge dissipates, leaving your cash flow intact for true priorities.</p>
      `
    },
    'blog-3': {
      title: 'Strategic Debt Payoff: Mathematical Avalanche vs. Behavioral Snowball',
      category: 'Pillar 2: Debt & Protection',
      readTime: '5 min read',
      contentHtml: `
        <p>Carrying high-interest debt is like running a marathon with a weighted vest. Selecting a clear, systematic repayment strategy transforms chaotic stress into steady, measurable progress.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Mathematical Champion: Debt Avalanche</h4>
        <p>Under the Avalanche method, debts are ordered strictly by interest rate from highest to lowest. You pay mandatory minimums on all obligations while directing every surplus rupee toward the account charging the highest APR (typically credit card revolving dues at 36%–44% p.a., followed by personal loans at 12%–16%).</p>
        <p><strong>Advantage:</strong> Minimizes the total cumulative interest paid over the life of your loans and achieves debt freedom in the shortest possible calendar time.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Psychological Motivator: Debt Snowball</h4>
        <p>The Snowball method orders debts from smallest principal balance to largest, ignoring interest rates entirely. Extra funds go toward wiping out the smallest balance completely.</p>
        <p><strong>Advantage:</strong> Eliminating an entire account early generates an immediate psychological boost and eliminates one monthly payment deadline, building behavioral stamina.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Advisory Perspective</h4>
        <p>Choose the model that aligns with your personality: choose Avalanche if you are motivated by numbers and cost minimization; choose Snowball if you benefit from quick, tangible milestone wins to stay the course.</p>
      `
    },
    'blog-4': {
      title: 'Building Your Emergency Shield: Sizing and Parking 3–6 Months of Living Costs',
      category: 'Pillar 2: Debt & Protection',
      readTime: '4 min read',
      contentHtml: `
        <p>An emergency reserve is not an investment meant to produce high returns; it is an insurance policy that preserves your sanity and protects your wealth accumulation engine.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Calculating Your True Emergency Number</h4>
        <p>Calculate your bare-bones survival budget rather than your total current spending. Include essential housing rent/EMI, groceries, utilities, mandatory loan minimums, and basic medical needs. Multiply this baseline by 3 to 6 months depending on income stability (freelancers and single-income families should target 6 to 9 months).</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Optimal Parking Instruments</h4>
        <p>Emergency capital must meet two strict criteria: <em>capital safety</em> and <em>instant liquidity</em>.</p>
        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 mt-1">
          <li><strong>Auto-Sweep Fixed Deposits:</strong> Provides term-deposit yields with instantaneous liquidity linked to your checking account.</li>
          <li><strong>Liquid Mutual Funds:</strong> Invest in high-credit short-term money market instruments with minimal exit charges after 7 days.</li>
        </ul>
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 text-xs font-mono text-slate-700 my-2">
          Rule: Never invest emergency funds in volatile equities or locked illiquid schemes. Accessibility is paramount.
        </div>
      `
    },
    'blog-5': {
      title: 'The Mechanics of Compounding: Harnessing the Rule of 72 & Systematic Investing',
      category: 'Pillar 3: Wealth Building',
      readTime: '5 min read',
      contentHtml: `
        <p>Compounding is the mathematical engine of personal wealth. When the returns generated by your investments begin generating their own returns, growth shifts from linear addition to exponential multiplication.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Rule of 72 Simplified</h4>
        <p>To estimate how long it takes for invested capital to double at a given annual return rate, divide 72 by that rate:</p>
        <div class="p-2.5 rounded-lg bg-indigo-50/50 border border-indigo-200 font-mono text-xs my-2 text-indigo-950">
          • At 6% annual return: 72 / 6 = 12 years to double <br />
          • At 12% annual return: 72 / 12 = 6 years to double
        </div>
        <p>Over a 30-year working career, an investment doubling every 6 years undergoes 5 doubling cycles (a 32x multiplier on initial principal).</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Disciplined Power of SIPs</h4>
        <p>Systematic Investment Plans (SIPs) remove the emotional pitfalls of market timing. By purchasing consistently through market highs and lows, you naturally acquire more units when valuations are discounted (rupee-cost averaging), allowing compounding to work uninterrupted.</p>
      `
    },
    'blog-6': {
      title: 'Defending Purchasing Power: Outpacing Inflation & Achieving Time Autonomy',
      category: 'Pillar 4: Preservation & Autonomy',
      readTime: '5 min read',
      contentHtml: `
        <p>Earning money is only half the battle; preserving its purchasing power against the relentless erosion of inflation is what ultimately secures lasting freedom.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">Nominal Yield vs. Real Purchasing Power</h4>
        <p>If a fixed-income instrument yields 6.5% annually while headline inflation is 5.5%, your real post-tax yield may actually be negative. Over 15 to 20 years, low-yielding cash balances lose a substantial portion of their real buying power.</p>
        <p><strong>Advisory Approach:</strong> Balance short-term stability with productive growth assets (broad equities, real estate, or inflation-indexed instruments) capable of generating positive real returns over multi-year horizons.</p>

        <h4 class="font-bold text-slate-900 mt-3 text-sm">The True Meaning of Financial Independence</h4>
        <p>True wealth is measured not in luxury possessions, but in <em>time autonomy</em>—the freedom to wake up each morning and decide how to spend your hours, whom to collaborate with, and which meaningful pursuits to undertake without financial duress.</p>
        <p>By mastering the Four Pillars, you build an enduring foundation that turns financial security into a sustainable, lifelong reality.</p>
      `
    }
  };

  // --- 3. DOM Elements ---
