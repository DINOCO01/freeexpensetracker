  const transactionsTbody = document.getElementById('transactions-tbody');
  const emptyLedgerState = document.getElementById('empty-ledger-state');
  const txCountDisplay = document.getElementById('tx-count-display');
  const searchTransactionsInput = document.getElementById('search-transactions') as HTMLInputElement;
  const btnExportCsv = document.getElementById('btn-export-csv');

  // Debt Management Elements
  const statTotalDebt = document.getElementById('stat-total-debt');
  const debtItemCount = document.getElementById('debt-item-count');
  const statDtiRatio = document.getElementById('stat-dti-ratio');
  const statDtiTier = document.getElementById('stat-dti-tier');
  const statDebtFreeDate = document.getElementById('stat-debt-free-date');
  const statDebtMonthsLeft = document.getElementById('stat-debt-months-left');
  const statInterestSaved = document.getElementById('stat-interest-saved');
