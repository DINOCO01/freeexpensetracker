  const efundMonthlyOutflow = document.getElementById('efund-monthly-outflow');
  const targetEfund3mo = document.getElementById('target-efund-3mo');
  const targetEfund6mo = document.getElementById('target-efund-6mo');
  const goalsContainer = document.getElementById('goals-container');
  const formAddGoal = document.getElementById('form-add-goal') as HTMLFormElement;
