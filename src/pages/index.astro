  // --- 4. Helper Functions ---
  function getCurrencySymbol(): string {
    const curr = SUPPORTED_CURRENCIES[state.currency] || SUPPORTED_CURRENCIES.INR;
    return curr.symbol;
  }

  function formatMoney(amount: number): string {
    return formatCurrency(amount, state.currency);
  }

  function getMonthlyIncome(): number {
    return normalizeToMonthly(state.income, state.frequency);
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // --- 5. Render All Modules ---
  function renderAll() {
    const monthlyIncome = getMonthlyIncome();
    const currSymbol = getCurrencySymbol();

    // Sync currency labels
    document.querySelectorAll('.currency-label').forEach((el) => {
      el.textContent = currSymbol;
    });

    if (currencySelector && currencySelector.value !== state.currency) {
      currencySelector.value = state.currency;
    }

    if (inputIncome && document.activeElement !== inputIncome) {
      inputIncome.value = state.income ? state.income.toString() : '';
    }

    if (incomeSlider) {
      incomeSlider.value = Math.min(500000, Math.max(0, monthlyIncome)).toString();
    }

    if (incomeNormalizedAmount) {
      incomeNormalizedAmount.textContent = formatMoney(monthlyIncome);
    }

    btnFreqs.forEach((btn) => {
      const freq = btn.getAttribute('data-freq');
      if (freq === state.frequency) {
        btn.className = 'btn-freq active px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-white text-emerald-800 shadow-2xs cursor-pointer';
      } else {
        btn.className = 'btn-freq px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 cursor-pointer';
      }
    });

    // Compute category, total outflows, and total income from transactions
    let totalSpent = 0;
    let totalIncomeFromTx = 0;
    let totalNeeds = 0;
    let totalWants = 0;
    let totalSavings = 0;
    const catTotals: Record<ExpenseCategory, number> = {
      Housing: 0,
      Food: 0,
      Transport: 0,
      Utilities: 0,
      Entertainment: 0,
      Savings: 0,
      Miscellany: 0
    };

    state.transactions.forEach((t) => {
      if (t.type === 'income') {
        totalIncomeFromTx += t.amount;
      } else {
        totalSpent += t.amount;
        catTotals[t.category] = (catTotals[t.category] || 0) + t.amount;
        const type = CATEGORY_TYPES[t.category] || 'want';
        if (type === 'need') totalNeeds += t.amount;
        else if (type === 'want') totalWants += t.amount;
        else if (type === 'savings') totalSavings += t.amount;
      }
    });

    const effectiveTotalIncome = monthlyIncome + totalIncomeFromTx;
    const netCashflow = effectiveTotalIncome - totalSpent;
    const expensesPct = effectiveTotalIncome > 0 ? Math.round((totalSpent / effectiveTotalIncome) * 100) : 0;
    const totalSavingsEffective = totalSavings + Math.max(0, netCashflow);
    const savingsRatePct = effectiveTotalIncome > 0 ? Math.round((totalSavingsEffective / effectiveTotalIncome) * 100) : 0;

    // Render KPI Cards
    if (statTotalIncome) statTotalIncome.textContent = formatMoney(effectiveTotalIncome);
    if (statTotalExpenses) statTotalExpenses.textContent = formatMoney(totalSpent);
    if (statExpensesPct) statExpensesPct.textContent = `${expensesPct}%`;
    if (statRemainingBalance) {
      statRemainingBalance.textContent = (netCashflow >= 0 ? '+' : '-') + formatMoney(Math.abs(netCashflow));
      if (netCashflow < 0) {
        statRemainingBalance.className = 'text-xl sm:text-2xl font-bold font-mono text-rose-600 tracking-tight';
        if (statCashflowLabel) {
          statCashflowLabel.textContent = 'Deficit / Shortfall';
          statCashflowLabel.className = 'text-[11px] text-rose-600 font-semibold';
        }
      } else {
        statRemainingBalance.className = 'text-xl sm:text-2xl font-bold font-mono text-emerald-700 tracking-tight';
        if (statCashflowLabel) {
          statCashflowLabel.textContent = 'Positive surplus';
          statCashflowLabel.className = 'text-[11px] text-emerald-800 font-semibold';
        }
      }
    }
    if (statSavingsRate) {
      statSavingsRate.textContent = `${savingsRatePct}%`;
    }

    // Financial Health Indicator
    const health = calculateFinancialHealthScore(effectiveTotalIncome, state.transactions);
    if (healthScoreNumber) healthScoreNumber.textContent = health.score.toString();
    if (healthTierText) healthTierText.textContent = health.tier;
    if (healthTierBadge) {
      healthTierBadge.style.backgroundColor = health.tierBg;
      healthTierBadge.style.color = health.tierColor;
      healthTierBadge.style.borderColor = health.tierBorder;
    }
    if (scoreCircleStroke) {
      const circumference = 264;
      const offset = circumference - (health.score / 100) * circumference;
      scoreCircleStroke.style.strokeDashoffset = offset.toString();
      scoreCircleStroke.style.stroke = health.tierColor;
    }
    if (scoreSavingsRateLabel) scoreSavingsRateLabel.textContent = `${health.savingsRateScore} / 40 pts (${health.savingsRatePct}%)`;
    if (barSavingsScore) barSavingsScore.style.width = `${(health.savingsRateScore / 40) * 100}%`;
    if (scoreFixedCostLabel) scoreFixedCostLabel.textContent = `${health.fixedCostScore} / 40 pts (${health.fixedCostPct}%)`;
    if (barFixedScore) barFixedScore.style.width = `${(health.fixedCostScore / 40) * 100}%`;
    if (scoreBufferLabel) scoreBufferLabel.textContent = `${health.bufferScore} / 20 pts (${health.bufferPct}%)`;
    if (barBufferScore) barBufferScore.style.width = `${(health.bufferScore / 20) * 100}%`;

    if (healthRecommendationsList) {
      healthRecommendationsList.innerHTML = health.recommendations
        .map((rec) => `<div class="flex items-start gap-2"><span class="text-emerald-700 font-bold">•</span><span>${rec}</span></div>`)
        .join('');
    }

    // Dynamic Smart Suggestions & Alternatives
    renderSmartSuggestions(catTotals, effectiveTotalIncome, netCashflow);

    // Ledger
    renderLedger();

    // Debt Management
    renderDebtManagement(effectiveTotalIncome);

    // Target Planning
    renderBudgetPlanning(totalSpent);
  }

  // --- 6. Smart Suggestions & Alternatives Engine ---
  function renderSmartSuggestions(
    catTotals: Record<ExpenseCategory, number>,
    monthlyIncome: number,
    netCashflow: number
  ) {
    if (!smartSuggestionsContainer) return;

    interface SuggestionItem {
      category: string;
      title: string;
      currentProblem: string;
      alternativeSolution: string;
      estimatedSavings: number;
      tag: string;
    }

    const suggestions: SuggestionItem[] = [];
    const totalExpenses = Object.values(catTotals).reduce((sum, val) => sum + val, 0);

    // If tracker has no recorded expenses
    if (state.transactions.length === 0 || totalExpenses === 0) {
      if (potentialSavingsTotal) {
        potentialSavingsTotal.textContent = `+${formatMoney(0)}/mo`;
      }
      smartSuggestionsContainer.innerHTML = `
        <div class="col-span-1 md:col-span-2 p-8 text-center text-xs text-slate-500 dark:text-slate-400 bg-slate-50/80 dark:bg-slate-800/60 rounded-2xl border border-dashed border-slate-200 dark:border-slate-700 space-y-2">
          <div class="text-2xl">📊</div>
          <div class="font-bold text-slate-800 dark:text-slate-100 text-sm">No Recorded Expenses in Tracker</div>
          <p class="max-w-md mx-auto text-slate-500 dark:text-slate-400 text-[11px] leading-relaxed">
            Live AI Advisor generates personalized spending optimizations and cost-cutting switches exclusively based on your logged expenses. Add your daily spending or import a statement above to see tailored recommendations.
          </p>
        </div>
      `;
      return;
    }

    // Food & Dining Alternative (Only if Food expenses are recorded in tracker)
    if (catTotals.Food > 0) {
      const foodSavings = Math.round(catTotals.Food * 0.20);
      const foodPct = totalExpenses > 0 ? Math.round((catTotals.Food / totalExpenses) * 100) : 0;
      suggestions.push({
        category: 'Food & Groceries',
        title: 'Batch Cooking & Grocery Brand Swapping',
        currentProblem: `You have logged ${formatMoney(catTotals.Food)} on food and dining (${foodPct}% of your tracked expenses).`,
        alternativeSolution: `Substituting 2 restaurant deliveries per week with home-cooked batch meals and opting for quality private-label pantry staples can lower food costs by ~${formatMoney(foodSavings)} monthly.`,
        estimatedSavings: foodSavings,
        tag: 'High Impact'
      });
    }

    // Entertainment & Discretionary (Only if Entertainment or Miscellany are recorded in tracker)
    const discretionarySpend = (catTotals.Entertainment || 0) + (catTotals.Miscellany || 0);
    if (discretionarySpend > 0) {
      const discSavings = Math.round(discretionarySpend * 0.30);
      suggestions.push({
        category: 'Entertainment & Discretionary',
        title: 'Streaming & Discretionary Rotation',
        currentProblem: `Discretionary leisure and entertainment spending is currently ${formatMoney(discretionarySpend)} across your recorded transactions.`,
        alternativeSolution: `Rotating streaming subscriptions to maintain only 1 active service per month and applying a 72-hour delay to impulse purchases can save ~${formatMoney(discSavings)} monthly.`,
        estimatedSavings: discSavings,
        tag: 'Quick Win'
      });
    }

    // Utilities & Connectivity (Only if Utilities are recorded in tracker)
    if (catTotals.Utilities > 0) {
      const utilitySavings = Math.round(catTotals.Utilities * 0.12);
      suggestions.push({
        category: 'Utilities & Bills',
        title: 'Broadband Retention & Energy Conservation',
        currentProblem: `Recorded utilities and recurring connectivity bills account for ${formatMoney(catTotals.Utilities)}.`,
        alternativeSolution: `Contacting your internet/telecom service provider for retention loyalty plans and eliminating phantom appliance power drain can save ~${formatMoney(utilitySavings)} each month.`,
        estimatedSavings: utilitySavings,
        tag: 'Recurring'
      });
    }

    // Transport & Commute (Only if Transport is recorded in tracker)
    if (catTotals.Transport > 0) {
      const transportSavings = Math.round(catTotals.Transport * 0.18);
      suggestions.push({
        category: 'Transport & Mobility',
        title: 'Route Consolidation & Transit Optimization',
        currentProblem: `Transportation and mobility expenses are currently ${formatMoney(catTotals.Transport)} based on your tracker.`,
        alternativeSolution: `Combining weekly travel errands, comparing monthly public transit passes, or carpooling for regular commutes can reduce monthly transport spend by ~${formatMoney(transportSavings)}.`,
        estimatedSavings: transportSavings,
        tag: 'Easy Switch'
      });
    }

    // Housing High Ratio (Only if Housing is recorded and is high relative to income)
    if (catTotals.Housing > 0 && monthlyIncome > 0 && (catTotals.Housing / monthlyIncome > 0.35)) {
      const housingSavings = Math.round(catTotals.Housing * 0.05);
      const housingPct = Math.round((catTotals.Housing / monthlyIncome) * 100);
      suggestions.push({
        category: 'Housing & Fixed Obligations',
        title: 'Housing Ratio Rebalancing',
        currentProblem: `Housing commitments of ${formatMoney(catTotals.Housing)} consume ${housingPct}% of your monthly take-home income (ideal benchmark is under 30%–35%).`,
        alternativeSolution: `Consider auditing ancillary tenant charges, utility efficiency, or applying upcoming income raises specifically to rebalance your fixed cost ratio.`,
        estimatedSavings: housingSavings,
        tag: 'Structural'
      });
    }

    // Deficit Alert: Spending exceeds income (from tracker results)
    if (monthlyIncome > 0 && netCashflow < 0) {
      const deficitAmount = Math.abs(netCashflow);
      suggestions.push({
        category: 'Cash Flow Protection',
        title: 'Immediate Deficit Mitigation',
        currentProblem: `Tracked expenses (${formatMoney(totalExpenses)}) exceed your monthly income (${formatMoney(monthlyIncome)}) by ${formatMoney(deficitAmount)}.`,
        alternativeSolution: `Pausing non-essential discretionary orders and delaying new commitments is advised to immediately eliminate this ${formatMoney(deficitAmount)} monthly cash outflow deficit.`,
        estimatedSavings: deficitAmount,
        tag: 'Critical Priority'
      });
    } else if (monthlyIncome > 0 && netCashflow > 0) {
      // Surplus allocation based on tracker net cashflow
      const monthlyYield = Math.max(1, Math.round((netCashflow * 0.065) / 12));
      suggestions.push({
        category: 'Surplus Cash Growth',
        title: 'Surplus Liquidity Yield Optimization',
        currentProblem: `Your tracker shows an unassigned net surplus of +${formatMoney(netCashflow)} remaining after recorded expenses.`,
        alternativeSolution: `Instead of letting surplus cash sit idle in low-yield checking accounts, parking it in an auto-sweep term deposit or liquid mutual fund yielding ~6.5% p.a. generates ~${formatMoney(monthlyYield)} in passive monthly earnings.`,
        estimatedSavings: monthlyYield,
        tag: 'Passive Wealth'
      });
    }

    // Sort suggestions by estimated savings descending
    suggestions.sort((a, b) => b.estimatedSavings - a.estimatedSavings);

    // Calculate total potential monthly savings
    const totalPotential = suggestions.reduce((sum, s) => sum + s.estimatedSavings, 0);
    if (potentialSavingsTotal) {
      potentialSavingsTotal.textContent = `+${formatMoney(totalPotential)}/mo`;
    }

    if (suggestions.length === 0) {
      smartSuggestionsContainer.innerHTML = `
        <div class="col-span-1 md:col-span-2 p-6 text-center text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/60 rounded-xl border border-slate-200 dark:border-slate-700">
          🎉 Great budget discipline! No immediate spending anomalies detected from your recorded transactions. Log additional expenses to receive customized cost-saving alternatives.
        </div>
      `;
      return;
    }

    smartSuggestionsContainer.innerHTML = suggestions
      .map(
        (s) => `
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/90 dark:border-slate-700/80 space-y-2 hover:border-slate-300 dark:hover:border-slate-600 transition-colors">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 bg-emerald-100/70 dark:bg-emerald-950/60 px-2 py-0.5 rounded">
            ${s.tag}
          </span>
          <span class="text-xs font-bold font-mono text-emerald-700 dark:text-emerald-400">
            Save ~${formatMoney(s.estimatedSavings)}/mo
          </span>
        </div>
        <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">${s.title}</h4>
        <p class="text-[11px] text-slate-600 dark:text-slate-300">${s.currentProblem}</p>
        <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-700/80 text-[11px] text-slate-700 dark:text-slate-200 leading-relaxed font-medium">
          <strong class="text-emerald-800 dark:text-emerald-400">Actionable Switch:</strong> ${s.alternativeSolution}
        </div>
      </div>
    `
      )
      .join('');
  }

  // --- 7. Debt Management Engine (Indian Financial Models) ---
  function renderDebtManagement(monthlyIncome: number) {
    if (!debtsTbody) return;

    // Sort debts based on active debt payoff model
    const sortedDebts = [...debts].sort((a, b) => {
      if (debtStrategy === 'avalanche') {
        return b.rate - a.rate; // highest interest rate p.a. first
      } else if (debtStrategy === 'snowball') {
        return a.balance - b.balance; // lowest principal balance first
      } else {
        return b.minimum - a.minimum; // highest monthly EMI first (FOIR cash-flow relief)
      }
    });

    const totalDebtAmount = debts.reduce((sum, d) => sum + d.balance, 0);
    const totalMinimums = debts.reduce((sum, d) => sum + d.minimum, 0);

    if (statTotalDebt) statTotalDebt.textContent = formatMoney(totalDebtAmount);
    if (debtItemCount) debtItemCount.textContent = debts.length.toString();

    // FOIR / Debt-to-Income
    const dtiRatio = monthlyIncome > 0 ? Math.round((totalMinimums / monthlyIncome) * 100) : 0;
    if (statDtiRatio) statDtiRatio.textContent = `${dtiRatio}%`;
    if (statDtiTier) {
      if (debts.length === 0) {
        statDtiTier.textContent = 'No active debt';
        statDtiTier.className = 'text-[11px] text-slate-500 font-semibold';
      } else if (dtiRatio <= 40) {
        statDtiTier.textContent = 'Comfortable Range (<40%)';
        statDtiTier.className = 'text-[11px] text-emerald-700 font-semibold';
      } else if (dtiRatio <= 50) {
        statDtiTier.textContent = 'Moderate FOIR (40–50%)';
        statDtiTier.className = 'text-[11px] text-amber-600 font-semibold';
      } else {
        statDtiTier.textContent = 'High Debt Burden (>50%)';
        statDtiTier.className = 'text-[11px] text-rose-600 font-semibold';
      }
    }

    // Payoff Timeline & Interest Saved Simulation
    const totalMonthlyDebtBudget = totalMinimums + extraMonthlyDebtPayment;
    let monthsToPayoff = 0;
    let totalInterestBase = 0;
    let totalInterestAccelerated = 0;

    if (totalMonthlyDebtBudget > 0 && totalDebtAmount > 0) {
      const avgRate = debts.reduce((acc, d) => acc + (d.rate * d.balance), 0) / (totalDebtAmount || 1) / 100 / 12;
      monthsToPayoff = Math.max(1, Math.ceil(totalDebtAmount / totalMonthlyDebtBudget));
      totalInterestAccelerated = totalDebtAmount * avgRate * (monthsToPayoff / 2);
      const minDivisor = totalMinimums > 0 ? totalMinimums : totalMonthlyDebtBudget;
      const monthsWithoutExtra = Math.max(1, Math.ceil(totalDebtAmount / minDivisor));
      totalInterestBase = totalDebtAmount * avgRate * (monthsWithoutExtra / 2);
    }

    const interestSaved = Math.max(0, Math.round(totalInterestBase - totalInterestAccelerated));

    const futureDate = new Date();
    futureDate.setMonth(futureDate.getMonth() + monthsToPayoff);
    const dateFormatted = futureDate.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' });

    if (statDebtFreeDate) statDebtFreeDate.textContent = totalDebtAmount > 0 ? dateFormatted : '—';
    if (statDebtMonthsLeft) statDebtMonthsLeft.textContent = totalDebtAmount > 0 ? `${monthsToPayoff} months remaining` : '0 months';
    if (statInterestSaved) statInterestSaved.textContent = formatMoney(interestSaved);

    if (extraPaymentLabel) extraPaymentLabel.textContent = formatMoney(extraMonthlyDebtPayment);
    if (inputDebtExtraNumber && document.activeElement !== inputDebtExtraNumber) {
      inputDebtExtraNumber.value = extraMonthlyDebtPayment.toString();
    }
    if (debtExtraSlider) {
      debtExtraSlider.value = Math.min(500000, extraMonthlyDebtPayment).toString();
    }

    // Active strategy pill
    if (activeStrategyPill) {
      if (debtStrategy === 'avalanche') {
        activeStrategyPill.textContent = 'Avalanche (Highest Interest First)';
      } else if (debtStrategy === 'snowball') {
        activeStrategyPill.textContent = 'Snowball (Smallest Balance First)';
      } else {
        activeStrategyPill.textContent = 'Cash Flow Relief (Highest Monthly EMI First)';
      }
    }

    // Dynamic Model Recommendation Banner
    if (debtStrategyRecommendation) {
      if (debtStrategy === 'avalanche') {
        debtStrategyRecommendation.innerHTML = `
          <div class="space-y-3">
            <div class="flex items-start gap-2.5">
              <span class="text-xl shrink-0">⚡</span>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 block">Cost Optimization Model</span>
                <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-0.5">Model Recommendation: Avalanche (Interest Saver)</h4>
                <p class="text-slate-600 dark:text-slate-300 mt-1 leading-relaxed text-xs">
                  Prioritizes allocating all extra prepayment capacity toward the debt carrying the highest annual interest rate first (such as revolving credit cards and high-rate unsecured personal loans), while maintaining mandatory minimums on all other accounts.
                </p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1">
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Core Advantage</strong>
                <span class="text-slate-600 dark:text-slate-400">Mathematically minimizes cumulative interest outflow, reducing total repayment expense.</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Strategic Advisory</strong>
                <span class="text-slate-600 dark:text-slate-400">Most effective for borrowers looking to preserve cash and eliminate high borrowing charges.</span>
              </div>
            </div>
          </div>
        `;
      } else if (debtStrategy === 'snowball') {
        debtStrategyRecommendation.innerHTML = `
          <div class="space-y-3">
            <div class="flex items-start gap-2.5">
              <span class="text-xl shrink-0">❄️</span>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 block">Behavioral Momentum Model</span>
                <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-0.5">Model Recommendation: Snowball (Quick Closure)</h4>
                <p class="text-slate-600 dark:text-slate-300 mt-1 leading-relaxed text-xs">
                  Prioritizes extinguishing the smallest principal balances first, regardless of the interest rates. Once an account is fully paid off, its entire payment budget rolls directly into the next smallest balance.
                </p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1">
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Core Advantage</strong>
                <span class="text-slate-600 dark:text-slate-400">Delivers rapid psychological wins and reduces the total count of monthly open accounts.</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Strategic Advisory</strong>
                <span class="text-slate-600 dark:text-slate-400">Ideal for anyone who benefits from visible early milestones to maintain long-term payoff consistency.</span>
              </div>
            </div>
          </div>
        `;
      } else {
        debtStrategyRecommendation.innerHTML = `
          <div class="space-y-3">
            <div class="flex items-start gap-2.5">
              <span class="text-xl shrink-0">🚀</span>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 block">Cash Flow & Liquidity Model</span>
                <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mt-0.5">Model Recommendation: Cash Flow & EMI Relief</h4>
                <p class="text-slate-600 dark:text-slate-300 mt-1 leading-relaxed text-xs">
                  Prioritizes extinguishing the loan account with the highest mandatory monthly installment first. Clearing major monthly obligations lowers the fixed debt-to-income burden and immediately frees up take-home cash.
                </p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] pt-1">
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Core Advantage</strong>
                <span class="text-slate-600 dark:text-slate-400">Rapidly unburdens monthly cash flow, providing immediate breathing space in the household budget.</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900/90 border border-emerald-200/80 dark:border-emerald-800/60 space-y-0.5">
                <strong class="text-slate-800 dark:text-slate-200 block font-semibold">Strategic Advisory</strong>
                <span class="text-slate-600 dark:text-slate-400">Best for individuals feeling constrained by heavy monthly outflows and seeking liquidity.</span>
              </div>
            </div>
          </div>
        `;
      }
    }

    // Empty state without demo loans
    if (sortedDebts.length === 0) {
      debtsTbody.innerHTML = `
        <tr>
          <td colspan="6" class="py-10 text-center text-xs text-slate-500 dark:text-slate-400">
            <div class="space-y-1.5 max-w-sm mx-auto">
              <div class="text-2xl">📋</div>
              <div class="font-bold text-slate-800 dark:text-slate-100 text-sm">No Active Loans or Debts Recorded</div>
              <p class="text-slate-500 dark:text-slate-400 text-[11px]">
                Add your credit card dues, personal loans, car/two-wheeler EMIs, or home loans using the form on the left to view your prioritized payoff order.
              </p>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    debtsTbody.innerHTML = sortedDebts
      .map(
        (d, index) => {
          let reasonTag = '';
          if (index === 0) {
            if (debtStrategy === 'avalanche') reasonTag = '<span class="text-[9px] font-bold text-rose-700 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 px-1.5 py-0.5 rounded ml-1.5">Top Rate</span>';
            else if (debtStrategy === 'snowball') reasonTag = '<span class="text-[9px] font-bold text-sky-700 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 px-1.5 py-0.5 rounded ml-1.5">Lowest Balance</span>';
            else reasonTag = '<span class="text-[9px] font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 px-1.5 py-0.5 rounded ml-1.5">Highest EMI</span>';
          }

          return `
      <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
