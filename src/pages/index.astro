  // Blog Elements
  const modalBlogReader = document.getElementById('modal-blog-reader');
  const readerCategoryBadge = document.getElementById('reader-category-badge');
  const readerArticleTitle = document.getElementById('reader-article-title');
  const readerMetaText = document.getElementById('reader-meta-text');
  const readerArticleContent = document.getElementById('reader-article-content');
  const btnCloseBlogReader = document.getElementById('btn-close-blog-reader');
  const btnDoneReading = document.getElementById('btn-done-reading');
  const blogCards = document.querySelectorAll('.blog-card');
  const blogFilterBtns = document.querySelectorAll('.btn-blog-filter');

  // File Importer Modal Elements
  const fileImportModal = document.getElementById('file-import-modal');
  const btnCloseImportModal = document.getElementById('btn-close-import-modal');
  const btnOpenImporterNav = document.getElementById('btn-open-file-importer-nav');
  const btnHeroLaunchImport = document.getElementById('btn-hero-launch-import');
  const btnOpenImporterLogger = document.getElementById('btn-open-importer-logger');
  const importDropzone = document.getElementById('import-dropzone');
  const importFileInput = document.getElementById('import-file-input') as HTMLInputElement;
  const importPreviewBox = document.getElementById('import-preview-box');
  const previewFileName = document.getElementById('preview-file-name');
  const previewCount = document.getElementById('preview-count');
  const previewTotal = document.getElementById('preview-total');
  const previewTopCat = document.getElementById('preview-top-cat');
  const previewInsightsList = document.getElementById('preview-insights-list');
  const previewTableTbody = document.getElementById('preview-table-tbody');
  const btnApplyReplace = document.getElementById('btn-apply-replace');
  const btnApplyAppend = document.getElementById('btn-apply-append');
  const importErrorMsg = document.getElementById('import-error-msg');

  // Tab Importer Elements
  const tabImporterDropzone = document.getElementById('tab-importer-dropzone');
  const tabImporterFileInput = document.getElementById('tab-importer-file-input') as HTMLInputElement;
  const tabImporterProgress = document.getElementById('tab-importer-progress');
  const tabImporterProgressText = document.getElementById('tab-importer-progress-text');
  const tabImporterProgressPct = document.getElementById('tab-importer-progress-pct');
  const tabImporterProgressBar = document.getElementById('tab-importer-progress-bar');
  const tabImporterError = document.getElementById('tab-importer-error');
  const tabImporterResults = document.getElementById('tab-importer-results');
  const tabImporterFilesChips = document.getElementById('tab-importer-files-chips');
  const tabImporterFileCountBadge = document.getElementById('tab-importer-file-count-badge');
  const tabResultRecordCount = document.getElementById('tab-result-record-count');
  const tabResultTotalAmount = document.getElementById('tab-result-total-amount');
  const tabResultTopCategory = document.getElementById('tab-result-top-category');
  const tabResultTopCatSub = document.getElementById('tab-result-top-cat-sub');
  const tabResultInsightsList = document.getElementById('tab-result-insights-list');
