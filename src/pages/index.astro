  const DEBT_STORAGE_KEY = 'fet_debts_v4';
  let debts: DebtItem[] = [];
  try {
    const rawDebts = localStorage.getItem(DEBT_STORAGE_KEY);
    debts = rawDebts
      ? JSON.parse(rawDebts)
      : [
          { id: 'debt-1', name: 'Chase Sapphire Credit Card', balance: 3800, rate: 22.9, minimum: 110 },
          { id: 'debt-2', name: 'Auto Loan (Honda Civic)', balance: 11500, rate: 6.5, minimum: 290 },
          { id: 'debt-3', name: 'Federal Student Loan', balance: 14200, rate: 4.8, minimum: 165 }
        ];
  } catch (e) {
    debts = [];
  }
  let debtStrategy: 'avalanche' | 'snowball' = 'avalanche';
  let extraMonthlyDebtPayment = 200;

  // Goals State
  const GOAL_STORAGE_KEY = 'fet_goals_v4';
