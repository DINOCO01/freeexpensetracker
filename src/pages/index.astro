          { id: 'goal-1', name: '3-Month Emergency Cushion', target: 8000, current: 3200, monthly: 400 },
          { id: 'goal-2', name: 'Home Down Payment Fund', target: 25000, current: 8500, monthly: 500 },
          { id: 'goal-3', name: 'Summer Travel & Flight', target: 1800, current: 950, monthly: 200 }
        ];
  } catch (e) {
    goals = [];
  }

  // --- 2. Blog Articles Full Text Database ---
  const BLOG_ARTICLES: Record<string, { title: string; category: string; readTime: string; contentHtml: string }> = {
    'blog-1': {
      title: 'The 7 Money Habits That Keep People Broke (And How to Break Them Today)',
      category: 'Budgeting & Mindset',
      readTime: '6 min read',
      contentHtml: `
        <p>Most individuals who struggle with monthly finances do not have an income deficit—they suffer from behavioral leaks that silently siphon hundreds of dollars each month before wealth can compound.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">1. Lifestyle Inflation (The Golden Handcuffs)</h4>
        <p>When salary increases from $50,000 to $70,000, human psychology immediately upgrades apartments, leases newer vehicles, and frequent costlier restaurants. Within three months, the extra $20,000 vanishes completely.</p>
        <p><strong>The Fix:</strong> The 50% Rule for Raises. Whenever you receive a salary bump, bonus, or raise, immediately divert exactly 50% into automated investments before the new paycheck enters your checking account.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">2. Paying Yourself Last</h4>
        <p>If you wait to save whatever is left over at the end of the month, the answer will always be zero. Human spending expands to fill the container of available liquidity (Parkinson's Law of Money).</p>
        <p><strong>The Fix:</strong> Reverse budgeting. Automate your 20% savings transfer to execute on the exact day your paycheck clears.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">3. Subscription Amnesia</h4>
        <p>The average American underestimates their monthly recurring subscriptions by over $130/month. Streaming apps, premium software, and trial memberships accumulate quietly.</p>
        <p><strong>The Fix:</strong> Conduct a quarterly 15-minute credit card audit. Cancel every recurring subscription you have not used in the past 14 days.</p>
      `
    },
    'blog-2': {
      title: 'Debt Snowball vs. Avalanche: Which Strategy Actually Works?',
      category: 'Debt Payoff',
      readTime: '5 min read',
      contentHtml: `
        <p>When you are serious about becoming debt-free, choosing between the <strong>Debt Avalanche</strong> and <strong>Debt Snowball</strong> method is the most important strategic decision you will make.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Mathematical Champion: Debt Avalanche</h4>
        <p>In the Avalanche method, you order all debts strictly by Annual Percentage Rate (APR), highest to lowest. You pay minimums on everything, throwing every single extra dollar at the debt with the highest interest.</p>
        <p><strong>Pros:</strong> Minimizes lifetime interest payments and achieves total freedom in the shortest calendar days.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Psychological Champion: Debt Snowball</h4>
        <p>Popularized by Dave Ramsey, the Snowball method orders debts from smallest remaining balance to largest balance, completely ignoring interest rates.</p>
        <p><strong>Pros:</strong> When you wipe out a $500 balance in three weeks, your brain receives a surge of dopamine. You feel immediate victory and momentum, which prevents burnout during multi-year payoff plans.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">Verdict: Which Should You Use?</h4>
        <p>If you are highly analytical and disciplined, choose <strong>Avalanche</strong>. If you feel overwhelmed, anxious, or unmotivated by your debts, choose <strong>Snowball</strong> for the fast psychological wins.</p>
      `
    },
    'blog-3': {
      title: 'How to Build a $1,000 Emergency Fund in 30 Days Without A Second Job',
      category: 'Saving Hacks',
      readTime: '4 min read',
      contentHtml: `
        <p>Over 56% of adults cannot cover an unexpected $1,000 expense from cash reserves. Without this basic barrier, a blown tire, plumbing leak, or emergency vet visit immediately lands on a 24% APR credit card, restarting the debt cycle.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">The 4-Week Rapid Capital Blueprint</h4>
        <ul class="list-disc list-inside space-y-1.5 text-xs text-slate-600 mt-1">
          <li><strong>Week 1 ($250): Sell Unused Electronics & Wardrobe.</strong> Search closets for unused smartphones, tablets, video games, or designer jackets. List them on Facebook Marketplace or eBay for quick local cash.</li>
          <li><strong>Week 2 ($250): The Pantry & Freezer Challenge.</strong> Plan all meals for 7 days exclusively around food already in your freezer, canned goods, and pantry. Skip supermarket trips to save $150–$250 in a single week.</li>
          <li><strong>Week 3 ($250): Auto Insurance & Internet Renegotiation.</strong> Call your car insurance provider and request a quote comparison or raise deductibles from $250 to $1,000. Call your ISP and ask for retention discounts.</li>
          <li><strong>Week 4 ($250): Pause Discretionary Dining & Rideshares.</strong> Commit to zero Uber Eats, DoorDash, and restaurant dining for 7 days. Brew coffee at home.</li>
        </ul>
        <p class="mt-2">Store this $1,000 in a separate high-yield savings account and label it strictly "DO NOT TOUCH UNLESS EMERGENCY".</p>
      `
    },
    'blog-4': {
      title: 'The 72-Hour Rule: The Brain Hack That Stops Impulse Buying',
      category: 'Budgeting & Habits',
      readTime: '4 min read',
      contentHtml: `
        <p>Modern e-commerce apps are engineered by behavioral psychologists to trigger impulsive dopamine rushes. 1-Click checkout, countdown timers, and "Only 2 left in stock" notices bypass the prefrontal cortex.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">How the 72-Hour Rule Works</h4>
        <p>Whenever you see a non-essential item you want to purchase (clothing, tech gadgets, home decor, games) that costs over $30, apply a strict <strong>72-hour cooling-off window</strong>:</p>
        <ol class="list-decimal list-inside space-y-1 text-xs text-slate-600 mt-1">
          <li>Do not click "Buy Now". Add it to your cart or a private wishlist.</li>
          <li>Close the browser tab or app completely.</li>
          <li>Set a reminder 72 hours (3 days) into the future.</li>
        </ol>
        <p class="mt-2">In 80% of instances, when the notification triggers 3 days later, the emotional dopamine spike has dissipated, and you will willingly delete the item, saving hundreds of dollars effortlessly.</p>
      `
    },
    'blog-5': {
      title: 'Zero-Based Budgeting: Why Six-Figure Earners Still Feel Broke',
      category: 'Budgeting',
      readTime: '5 min read',
      contentHtml: `
        <p>A staggering 36% of individuals earning over $100,000 per year report living paycheck to paycheck. High income without deliberate architecture simply creates expensive habits.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">The Philosophy of Zero-Based Budgeting</h4>
        <p>Zero-based budgeting does not mean you have zero dollars in your checking account. It means <strong>Income minus Allocation equals Zero</strong>:</p>
        <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200 font-mono text-xs my-2">
          Monthly Net Income: $5,000 <br />
          Needs & Bills: -$2,500 <br />
          Wants & Fun: -$1,200 <br />
          Investments: -$1,000 <br />
          Sinking Fund: -$300 <br />
          Remaining Unassigned: <strong>$0</strong>
        </div>
        <p>When every dollar has an assigned duty before the month begins, money stops vanishing on accidental frivolous spending.</p>
      `
    },
    'blog-6': {
      title: 'High-Yield Savings Accounts: Stop Leaving Free Money in Checking',
      category: 'Saving Hacks',
      readTime: '4 min read',
      contentHtml: `
        <p>Traditional brick-and-mortar commercial banks frequently pay an annualized return of 0.01% on checking and savings accounts. On a $10,000 emergency balance, you earn exactly $1.00 after 12 months.</p>
        <h4 class="font-bold text-slate-900 mt-3 text-sm">The High-Yield Savings Account (HYSA) Advantage</h4>
        <p>Modern online institutions (Ally, Marcus, Capital One 360, SoFi) pay between <strong>4.0% and 5.0% APY</strong> on consumer savings balances.</p>
        <p>They are 100% FDIC-insured up to $250,000 per depositor, have zero monthly maintenance fees, and allow instant electronic transfers back to your checking account within 1–2 business days.</p>
        <div class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-mono text-emerald-900 my-2">
          $10,000 in traditional bank = $1/year <br />
          $10,000 in a 4.5% HYSA = <strong>$450/year in passive compounding cash</strong>
        </div>
        <p>Opening an account takes less than 7 minutes online and puts risk-free cash directly into your wallet.</p>
      `
    }
  };

  // --- 3. DOM Elements ---
  const currencySelector = document.getElementById('currency-selector') as HTMLSelectElement;
