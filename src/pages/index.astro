    e.preventDefault();
    importDropzone.classList.remove('border-emerald-600', 'bg-emerald-50/50');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleSelectedFile(e.dataTransfer.files);
    }
  });

  importFileInput?.addEventListener('change', () => {
    if (importFileInput.files && importFileInput.files.length > 0) {
      handleSelectedFile(importFileInput.files);
    }
  });

  async function handleSelectedFile(files: FileList | File[]) {
    const fileList = Array.from(files);
    if (fileList.length === 0) return;
    if (importErrorMsg) importErrorMsg.classList.add('hidden');
    try {
      const result = await parseAndInterpretMultipleFiles(fileList);
      pendingImportResult = result;

      if (previewFileName) previewFileName.textContent = fileList.length === 1 ? fileList[0].name : `${fileList.length} files`;
      if (previewCount) previewCount.textContent = result.recordCount.toString();
      if (previewTotal) previewTotal.textContent = formatMoney(result.totalAmount);
      if (previewTopCat) {
        previewTopCat.textContent = result.topCategory
          ? `${result.topCategory.category} (${result.topCategory.percentage}%)`
          : 'N/A';
      }

      if (previewInsightsList) {
        previewInsightsList.innerHTML = result.insights
          .map((item) => `<div class="flex items-start gap-1.5"><span class="text-emerald-700 font-bold">•</span><span>${item}</span></div>`)
          .join('');
      }

      if (previewTableTbody) {
        previewTableTbody.innerHTML = result.transactions
          .slice(0, 5)
          .map(
            (t) => `
          <tr class="hover:bg-slate-50">
            <td class="py-1.5 px-3 font-mono text-[10px] text-slate-500">${t.date}</td>
            <td class="py-1.5 px-3 font-medium text-slate-900 truncate max-w-[140px]">${escapeHtml(t.name)}</td>
            <td class="py-1.5 px-3">
              ${t.type === 'income'
                ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300">💵 Income</span>`
                : `<span class="px-1.5 py-0.5 rounded text-[9px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">${t.category}</span>`
              }
            </td>
            <td class="py-1.5 px-3 font-mono font-bold text-right ${t.type === 'income' ? 'text-emerald-700' : 'text-rose-600'}">
              ${t.type === 'income' ? '+' : ''}${formatMoney(t.amount)}
            </td>
          </tr>
        `
          )
          .join('');
      }

      if (importPreviewBox) importPreviewBox.classList.remove('hidden');
    } catch (err: any) {
      if (importErrorMsg) {
        importErrorMsg.textContent = err.message || 'Failed to read file. Please ensure it has column headers and valid amounts.';
        importErrorMsg.classList.remove('hidden');
      }
    }
  }

  btnApplyReplace?.addEventListener('click', () => {
    if (!pendingImportResult) return;
    state.transactions = [...pendingImportResult.transactions];
    saveStoredState({ transactions: state.transactions });
    closeImportModal();
    renderAll();
    switchTab('tracker');
    const anchor = document.getElementById('live-tool-anchor');
    anchor?.scrollIntoView({ behavior: 'smooth' });
  });

  btnApplyAppend?.addEventListener('click', () => {
    if (!pendingImportResult) return;
    state.transactions = [...pendingImportResult.transactions, ...state.transactions];
    saveStoredState({ transactions: state.transactions });
    closeImportModal();
    renderAll();
    switchTab('tracker');
    const anchor = document.getElementById('live-tool-anchor');
    anchor?.scrollIntoView({ behavior: 'smooth' });
  });

  // Tab Universal Statement & Receipt Importer Logic
  tabImporterDropzone?.addEventListener('click', () => {
    tabImporterFileInput?.click();
  });

  tabImporterDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    tabImporterDropzone.classList.add('border-emerald-600', 'bg-emerald-50/40');
  });

  tabImporterDropzone?.addEventListener('dragleave', () => {
    tabImporterDropzone.classList.remove('border-emerald-600', 'bg-emerald-50/40');
  });

  tabImporterDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    tabImporterDropzone.classList.remove('border-emerald-600', 'bg-emerald-50/40');
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      handleTabSelectedFiles(e.dataTransfer.files);
    }
  });

  tabImporterFileInput?.addEventListener('change', () => {
    if (tabImporterFileInput.files && tabImporterFileInput.files.length > 0) {
      handleTabSelectedFiles(tabImporterFileInput.files);
    }
  });

  async function handleTabSelectedFiles(files: FileList | File[]) {
    const fileArray = Array.from(files);
    if (fileArray.length === 0) return;

    if (tabImporterError) tabImporterError.classList.add('hidden');
    if (tabImporterProgress) tabImporterProgress.classList.remove('hidden');
    if (tabImporterResults) tabImporterResults.classList.add('hidden');

    try {
      const result = await parseAndInterpretMultipleFiles(fileArray, (current, total, name) => {
        const pct = Math.round((current / total) * 100);
        if (tabImporterProgressText) tabImporterProgressText.textContent = `Analyzing ${name} (${current} of ${total})...`;
        if (tabImporterProgressPct) tabImporterProgressPct.textContent = `${pct}%`;
        if (tabImporterProgressBar) (tabImporterProgressBar as HTMLElement).style.width = `${pct}%`;
      });

      pendingTabImportResult = result;

      // Populate file chips
      if (tabImporterFileCountBadge) tabImporterFileCountBadge.textContent = `${result.successfulFiles}/${result.fileCount} files parsed`;
      if (tabImporterFilesChips) {
        tabImporterFilesChips.innerHTML = result.fileSummaries.map((f) => {
          if (f.status === 'success') {
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
              <span class="text-xs">✅</span>
              <strong class="font-mono text-slate-800">${escapeHtml(f.name)}</strong>
              <span class="text-[10px] text-emerald-700">(${f.recordCount} items • ${formatMoney(f.amount)})</span>
            </span>`;
          } else {
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200" title="${escapeHtml(f.error || '')}">
              <span class="text-xs">⚠️</span>
              <strong class="font-mono text-slate-800">${escapeHtml(f.name)}</strong>
              <span class="text-[10px] text-rose-600">(${escapeHtml(f.error || 'Failed')})</span>
            </span>`;
          }
        }).join('');
      }

      // Populate metrics
      if (tabResultRecordCount) tabResultRecordCount.textContent = result.recordCount.toString();
      if (tabResultTotalAmount) tabResultTotalAmount.textContent = formatMoney(result.totalAmount);
      if (tabResultTopCategory) {
        tabResultTopCategory.textContent = result.topCategory ? result.topCategory.category : 'N/A';
      }
      if (tabResultTopCatSub) {
        tabResultTopCatSub.textContent = result.topCategory
          ? `${result.topCategory.percentage}% of total spend (${formatMoney(result.topCategory.amount)})`
          : '0% of total spend';
      }

      // Populate insights
      if (tabResultInsightsList) {
        tabResultInsightsList.innerHTML = result.insights.map((item) => `
          <div class="flex items-start gap-2">
            <span class="text-emerald-700 font-bold shrink-0">•</span>
            <span>${item}</span>
          </div>
        `).join('');
      }

      // Populate preview table
      if (tabResultTableCount) tabResultTableCount.textContent = result.transactions.length.toString();
      if (tabResultTableTbody) {
        tabResultTableTbody.innerHTML = result.transactions.map((t) => `
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="py-2 px-3 text-slate-500 font-mono text-[11px]">${t.date}</td>
            <td class="py-2 px-3 font-medium text-slate-900 font-sans">${escapeHtml(t.name)}</td>
            <td class="py-2 px-3">
              ${t.type === 'income'
                ? `<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-100 text-emerald-900 border border-emerald-300">
                    💵 Income
                  </span>`
                : `<span class="px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-50 text-emerald-800 border border-emerald-200">
                    ${t.category}
                  </span>`
              }
            </td>
            <td class="py-2 px-3 text-right font-mono font-bold ${t.type === 'income' ? 'text-emerald-700' : 'text-rose-600'}">
              ${t.type === 'income' ? '+' : ''}${formatMoney(t.amount)}
            </td>
          </tr>
        `).join('');
      }

      if (tabImporterProgress) tabImporterProgress.classList.add('hidden');
      if (tabImporterResults) tabImporterResults.classList.remove('hidden');
    } catch (err: any) {
      if (tabImporterProgress) tabImporterProgress.classList.add('hidden');
      if (tabImporterError) {
        tabImporterError.textContent = err?.message || 'Error processing uploaded files. Please check file format.';
        tabImporterError.classList.remove('hidden');
      }
    }
  }

  btnTabApplyReplace?.addEventListener('click', () => {
    if (!pendingTabImportResult) return;
    state.transactions = [...pendingTabImportResult.transactions];
    saveStoredState({ transactions: state.transactions });
    renderAll();
    switchTab('tracker');
    const anchor = document.getElementById('live-tool-anchor');
    anchor?.scrollIntoView({ behavior: 'smooth' });
  });

  btnTabApplyAppend?.addEventListener('click', () => {
    if (!pendingTabImportResult) return;
    state.transactions = [...pendingTabImportResult.transactions, ...state.transactions];
    saveStoredState({ transactions: state.transactions });
    renderAll();
    switchTab('tracker');
    const anchor = document.getElementById('live-tool-anchor');
    anchor?.scrollIntoView({ behavior: 'smooth' });
  });

  btnTabResetImport?.addEventListener('click', () => {
    pendingTabImportResult = null;
    if (tabImporterResults) tabImporterResults.classList.add('hidden');
    if (tabImporterFileInput) tabImporterFileInput.value = '';
    if (tabImporterError) tabImporterError.classList.add('hidden');
  });

  // Tab Navigation
  function switchTab(tabId: string) {
    tabButtons.forEach((btn) => {
      const target = btn.getAttribute('data-tab');
      const isCapsule = btn.classList.contains('capsule-tab-btn');

      if (target === tabId) {
        if (isCapsule) {
          btn.className = 'tab-btn active capsule-tab-btn w-full px-3 sm:px-3.5 py-2 sm:py-2.5 rounded-xl text-xs font-bold flex items-center justify-between gap-1.5 sm:gap-2 transition-all bg-emerald-700 text-white border border-emerald-800 shadow-xs cursor-pointer text-left';
        } else {
          btn.className = 'tab-btn active w-full px-3 sm:px-3.5 py-2 sm:py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between gap-1.5 sm:gap-2 transition-all bg-white dark:bg-slate-800 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-600 shadow-2xs cursor-pointer text-left';
        }
      } else {
        if (isCapsule) {
          btn.className = 'tab-btn capsule-tab-btn w-full px-3 sm:px-3.5 py-2 sm:py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between gap-1.5 sm:gap-2 transition-all bg-emerald-50/80 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 text-emerald-900 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 shadow-2xs cursor-pointer text-left';
        } else {
          btn.className = 'tab-btn w-full px-3 sm:px-3.5 py-2 sm:py-2.5 rounded-xl text-xs font-semibold flex items-center justify-between gap-1.5 sm:gap-2 transition-all bg-white/70 dark:bg-slate-800/60 hover:bg-white dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200/80 dark:border-slate-700/80 hover:border-slate-300 dark:hover:border-slate-600 shadow-2xs cursor-pointer text-left';
        }
      }
    });

    if (btnOpenImporterNav) {
      if (tabId === 'import') {
        btnOpenImporterNav.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-700 text-white border border-emerald-800 transition-all shadow-xs cursor-pointer';
      } else {
        btnOpenImporterNav.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition-all shadow-2xs cursor-pointer';
      }
    }

    tabViews.forEach((view) => {
      if (view.id === `tab-view-${tabId}`) {
        view.classList.remove('hidden');
      } else {
        view.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  // Universal handler: Scroll to Live Tracker from ANY tab or link
  const scrollToLiveTrackerElements = document.querySelectorAll('a[href="#live-tool-anchor"], #btn-scroll-to-live-tracker');
  scrollToLiveTrackerElements.forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab('tracker');
      setTimeout(() => {
        const anchor = document.getElementById('live-tool-anchor');
        if (anchor) {
          anchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          document.getElementById('tab-view-tracker')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 50);
    });
  });

  // --- Templates Hub Handlers ---
  const tmplFilterBtns = document.querySelectorAll('.btn-tmpl-filter');
  const templateCards = document.querySelectorAll('.template-card');
  const inputSearchTemplates = document.getElementById('input-search-templates') as HTMLInputElement;
  const templatesEmptyState = document.getElementById('templates-empty-state');
  const btnTriggerTemplates = document.querySelectorAll('.btn-trigger-template');
  const btnSwitchToImporterFromTemplates = document.getElementById('btn-switch-to-importer-from-templates');

  let currentTmplFilter = 'all';

  function filterTemplates() {
    const query = (inputSearchTemplates?.value || '').trim().toLowerCase();
    let visibleCount = 0;

    templateCards.forEach((card) => {
      const cat = card.getAttribute('data-category') || '';
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-desc') || '';

      const matchesCat = currentTmplFilter === 'all' || cat === currentTmplFilter;
      const matchesQuery = !query || title.includes(query) || desc.includes(query) || cat.includes(query);

      if (matchesCat && matchesQuery) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (templatesEmptyState) {
      if (visibleCount === 0) {
        templatesEmptyState.classList.remove('hidden');
      } else {
        templatesEmptyState.classList.add('hidden');
      }
    }
  }

  tmplFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentTmplFilter = btn.getAttribute('data-template-filter') || 'all';
      tmplFilterBtns.forEach((b) => {
        b.className = 'btn-tmpl-filter px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer whitespace-nowrap flex items-center gap-1.5';
      });
      btn.className = 'btn-tmpl-filter active px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-700 text-white shadow-2xs cursor-pointer whitespace-nowrap flex items-center gap-1.5';
      filterTemplates();
    });
  });

  inputSearchTemplates?.addEventListener('input', () => {
    filterTemplates();
  });

  btnTriggerTemplates.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tmplId = btn.getAttribute('data-id') || '';
      const tmplType = btn.getAttribute('data-type');
      const tmplUrl = btn.getAttribute('data-url');

      if (tmplType === 'google-sheet' && tmplUrl) {
        window.open(tmplUrl, '_blank', 'noopener,noreferrer');
      } else if (tmplType === 'excel-download') {
        generateExcelTemplate(tmplId);
      } else if (tmplType === 'printable') {
        openPrintableDocument(tmplId);
      }
    });
  });

  btnSwitchToImporterFromTemplates?.addEventListener('click', () => {
    switchTab('import');
    const tabImportEl = document.getElementById('tab-view-import');
    tabImportEl?.scrollIntoView({ behavior: 'smooth' });
  });

  // Initial Render
  renderAll();
</script>
