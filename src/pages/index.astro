  try {
    const rawDebts = localStorage.getItem(DEBT_STORAGE_KEY);
    if (rawDebts) {
      const parsed = JSON.parse(rawDebts);
      debts = Array.isArray(parsed)
        ? parsed.filter((d: DebtItem) => !['debt-1', 'debt-2', 'debt-3'].includes(d.id))
        : [];
    } else {
      debts = [];
    }
  } catch (e) {
    debts = [];
  }
