  // File Importer Modal Elements
  const fileImportModal = document.getElementById('file-import-modal');
  const btnCloseImportModal = document.getElementById('btn-close-import-modal');
  const btnOpenImporterNav = document.getElementById('btn-open-file-importer-nav');
